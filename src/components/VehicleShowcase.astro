---
const cards = [
    {
        id: "lkw",
        num: "01",
        img: "/images/lkw2.png",
        alt: "LKW und Sattelzugmaschine",
        title: "LKW & Sattelzugmaschinen",
        text: "Ankauf von gebrauchten LKW, Zugmaschinen und schweren Nutzfahrzeugen verschiedener Marken und Zustände.",
        dark: true,
        large: true,
    },
    {
        id: "auflieger",
        num: "02",
        img: "/images/auflieger.png",
        alt: "Sattelauflieger",
        title: "Auflieger",
        text: "Planenauflieger, Kühlauflieger, Kipper und Spezialauflieger.",
    },
    {
        id: "anhaenger",
        num: "03",
        img: "/images/anhaenger.png",
        alt: "Anhänger",
        title: "Anhänger",
        text: "Sattelzugmaschinen und gewerblich genutzte Zugfahrzeuge.",
    },
    {
        id: "baumaschinen",
        num: "04",
        img: "/images/betonmischer2.png",
        alt: "Baumaschinen und Betonmischer",
        title: "Baumaschinen",
        text: "Bagger, Radlader, Betonmischer und weitere Maschinen aus Bau und Gewerbe.",
        dark: true,
    },
    {
        id: "transporter",
        num: "05",
        img: "/images/transporter.png",
        alt: "Transporter",
        title: "Transporter",
        text: "Leichte Nutzfahrzeuge und gewerblich genutzte Transporter.",
    },
    {
        id: "sattelzug",
        num: "06",
        img: "/images/sattelzug.png",
        alt: "Sattelzugmaschine",
        title: "Sattelzugmaschinen",
        text: "Sattelzugmaschinen aller Marken – von älteren bis zu neueren Baujahren.",
    },
    {
        id: "fuhrpark",
        num: "07",
        img: "/images/fuhrpark.png",
        alt: "Fuhrpark und Fahrzeugpaket",
        title: "Fuhrparks & Fahrzeugpakete",
        text: "Auch mehrere Fahrzeuge oder komplette Fuhrparks können als Paket angeboten und gemeinsam abgewickelt werden.",
        wide: true,
    },
];
---

<section class="vehicle-showcase section" id="fahrzeuge">
    <div class="container">
        <div class="showcase-head" data-animate>
            <span class="badge">Fahrzeugankauf</span>
            <h2>Welche Fahrzeuge kaufen wir?</h2>
            <p>
                Von einzelnen LKW bis zu kompletten Fuhrparks: Wir kaufen
                gewerbliche Fahrzeuge schnell, fair und professionell.
            </p>
        </div>

        <div class="showcase-grid">
            {cards.map((card) => (
                <article
                    class={[
                        "showcase-card glass-reflect",
                        card.large ? "large" : "",
                        card.dark  ? "dark"  : "",
                        card.wide  ? "wide"  : "",
                    ].filter(Boolean).join(" ")}
                    data-animate
                >
                    <div class="vehicle-img-wrap">
                        <img
                            src={card.img}
                            alt={card.alt}
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                    <span>{card.num}</span>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
    .showcase-head {
        max-width: 820px;
        margin-bottom: 30px;
    }

    .showcase-head h2 {
        margin: 18px 0 0;
        font-size: clamp(38px, 5vw, 72px);
        line-height: 0.96;
        letter-spacing: -0.07em;
    }

    .showcase-head p {
        margin-top: 18px;
        color: var(--muted);
        font-size: 19px;
        line-height: 1.7;
    }

    .showcase-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .showcase-card {
        position: relative;
        min-height: 260px;
        padding: 26px;
        border-radius: 32px;
        background: rgba(255,255,255,0.78);
        border: 1px solid var(--card-border);
        box-shadow: var(--shadow);
        overflow: hidden;
        transition:
                transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
                background 280ms ease,
                border-color 280ms ease,
                box-shadow 280ms ease;
    }

    .showcase-card::before {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        right: -70px;
        top: -70px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(15,23,42,0.08), transparent 68%);
        opacity: 0;
        transition: 280ms ease;
        pointer-events: none;
    }

    .showcase-card:hover {
        transform: translateY(-8px);
        background: #ffffff;
        border-color: rgba(15,23,42,0.14);
    }

    .showcase-card:hover::before { opacity: 1; }

    .showcase-card.large {
        grid-column: span 2;
        min-height: 320px;
        background: linear-gradient(135deg, #f26100, #b83c00);
        color: white;
    }

    .showcase-card.wide  { grid-column: span 2; }

    .showcase-card.dark {
        background: var(--orange);
        color: white;
    }

    /* Image wrapper */
    .vehicle-img-wrap {
        width: 100%;
        height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 22px;
        border-radius: 20px;
        background: rgba(15,23,42,0.04);
        border: 1px solid rgba(15,23,42,0.07);
        overflow: hidden;
        transition:
            transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
            background 280ms ease;
    }

    .showcase-card.large .vehicle-img-wrap,
    .showcase-card.dark  .vehicle-img-wrap {
        background: rgba(255,255,255,0.10);
        border-color: rgba(255,255,255,0.14);
    }

    .showcase-card:hover .vehicle-img-wrap {
        transform: translateY(-4px) scale(1.02);
        background: rgba(15,23,42,0.07);
    }

    .showcase-card.large:hover .vehicle-img-wrap,
    .showcase-card.dark:hover  .vehicle-img-wrap {
        background: rgba(255,255,255,0.15);
    }

    .vehicle-img-wrap img {
        max-width: 100%;
        max-height: 88px;
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
        transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .showcase-card:hover .vehicle-img-wrap img {
        transform: scale(1.05);
    }

    /* Card text */
    .showcase-card span {
        display: inline-flex;
        margin-bottom: 14px;
        color: var(--silver);
        font-weight: 900;
        font-size: 14px;
    }

    .showcase-card.large span,
    .showcase-card.dark  span { color: rgba(255,255,255,0.62); }

    .showcase-card h3 {
        margin: 0 0 10px;
        font-size: 24px;
        line-height: 1.08;
        letter-spacing: -0.05em;
    }

    .showcase-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.65;
        font-size: 15px;
    }

    .showcase-card.large p,
    .showcase-card.dark  p { color: rgba(255,255,255,0.68); }

    @media (max-width: 980px) {
        .showcase-grid { grid-template-columns: 1fr 1fr; }
        .showcase-card.large,
        .showcase-card.wide  { grid-column: span 2; }
    }

    @media (max-width: 640px) {
        .showcase-grid { grid-template-columns: 1fr; }
        .showcase-card.large,
        .showcase-card.wide  { grid-column: span 1; }
    }
</style>
