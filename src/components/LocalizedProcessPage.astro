---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingContact from "./FloatingContact.astro";
import ScrollAnimations from "./ScrollAnimations.astro";
import AblaufHero from "./AblaufHero.astro";
import AblaufSteps from "./AblaufSteps.astro";
import AblaufBenefits from "./AblaufBenefits.astro";
import AblaufInfo from "./AblaufInfo.astro";
import AblaufFAQ from "./AblaufFAQ.astro";
import AblaufCTA from "./AblaufCTA.astro";
import { localizePath, type Locale } from "../data/i18n";
import { absoluteUrl, createBreadcrumbSchema, createFaqSchema } from "../utils/seo";

const { lang } = Astro.props as { lang: Locale };

const content = {
  en: {
    title: "Process | Sell trucks and commercial vehicles | WAW Commercial Vehicles",
    description:
      "How to sell your truck or commercial vehicle to WAW: send the vehicle details, receive a prompt response, discuss the offer and arrange payment, handover or pickup.",
    breadcrumbHome: "Home",
    breadcrumbCurrent: "Process",
    hero: {
      kicker: "SELL YOUR TRUCK",
      title: "Sell your truck or commercial vehicle - quickly, safely and without detours.",
      text:
        "Send us the key vehicle details. We get back to you promptly and coordinate the offer, payment, handover and possible pickup directly with you.",
      primaryHref: "#inquiry",
      primaryLabel: "Sell your vehicle now",
      secondaryHref: localizePath("services", "en"),
      secondaryLabel: "View services",
      trustline: ["Direct contact", "Fair valuation", "Across Germany and Europe"],
    },
    stepsKicker: "HOW IT WORKS",
    stepsTitle: "Sell your vehicle in 5 clear steps",
    steps: [
      { number: "01", title: "Send vehicle details", text: "Tell us the vehicle type, make, year, mileage, location and, if possible, share photos.", iconKey: "file" },
      { number: "02", title: "Get a response", text: "We reply promptly and clarify any open points directly with you.", iconKey: "message" },
      { number: "03", title: "Discuss the offer", text: "Based on your details, photos and documents, we discuss a fair market offer.", iconKey: "euro" },
      { number: "04", title: "Agree payment", text: "We agree the payment method and timing clearly before handover.", iconKey: "payment" },
      { number: "05", title: "Plan handover or pickup", text: "Once agreed, we coordinate the handover or possible pickup at a suitable time.", iconKey: "truck" },
    ],
    benefitsKicker: "YOUR ADVANTAGES",
    benefitsTitle: "Why companies and fleets sell to WAW",
    benefits: [
      { title: "Clear coordination", text: "From first contact to handover, you always know the next step.", iconKey: "shield" },
      { title: "Prompt response", text: "We review your details quickly and discuss the next steps directly.", iconKey: "clock" },
      { title: "Fair valuation", text: "Our offer is based on the vehicle data, condition and location.", iconKey: "euro" },
      { title: "Across Germany and Europe", text: "You can offer single vehicles or complete fleets directly to us.", iconKey: "map" },
    ],
    info: {
      kicker: "DIRECT & RELIABLE",
      title: "Your sale in good hands",
      text:
        "We buy trucks, semi-trailers, trailers, vans, construction machinery and complete fleets. From the first message to handover, the process stays clear, direct and personal.",
      points: [
        "Commercial vehicle trade experience since 1995",
        "Direct contact with real decision-makers",
        "Damaged vehicles or high mileage are also possible",
        "All brands and models",
      ],
      imageAlt: "WAW Commercial Vehicles contact for vehicle purchase",
      callLabel: "Call now",
    },
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "How quickly will I hear from you?", answer: "As soon as we receive your vehicle details, we get back to you promptly. The more complete your details and photos are, the more specific our feedback can be." },
      { question: "Are there any costs for me?", answer: "No. Your inquiry and the first coordination are non-binding. If anything needs to be clarified later, we discuss it transparently with you in advance." },
      { question: "Do you also buy damaged vehicles?", answer: "Yes. You can also offer trucks, trailers, vans, construction machinery and fleets with damage, high mileage or older model years." },
      { question: "How is payment handled?", answer: "Payment is made quickly and securely after agreement and handover. We clarify all details with you beforehand." },
      { question: "Which documents do I need?", answer: "Registration documents, maintenance records, inspection reports and clear photos are helpful. For the first contact, vehicle type, location and your contact details are enough." },
      { question: "Do I have to deliver the vehicle myself?", answer: "Not necessarily. Once we reach an agreement, we coordinate the handover or possible pickup at a suitable date across Germany and Europe." },
    ],
    cta: {
      kicker: "SELL YOUR VEHICLE",
      title: "Send your vehicle details and get a prompt response",
      text: "Send us the key vehicle details. If documents are still missing, your contact details and a short description are enough to get started.",
      callLabel: "Call now",
      whatsappLabel: "WhatsApp",
      whatsappText: "Message now",
      source: "Process page EN",
      submitLabel: "Sell your vehicle now",
      sendingLabel: "Sending...",
      privacyText: "We treat your data confidentially and do not pass it on to third parties.",
      defaultError: "Your inquiry could not be sent. Please try again or call us directly.",
      placeholders: {
        name: "Name",
        phone: "Phone",
        email: "Email",
        vehicle: "Vehicle, e.g. MAN TGX",
        year: "Year",
        mileage: "Mileage (approx.)",
        message: "Additional vehicle information",
      },
    },
  },
  fr: {
    title: "Processus | Vendre camions et véhicules utilitaires | WAW Véhicules Utilitaires",
    description:
      "Voici comment vendre votre camion ou véhicule utilitaire à WAW : envoyez les informations du véhicule, recevez un retour rapide, discutez l'offre et organisez le paiement, la remise ou l'enlèvement.",
    breadcrumbHome: "Accueil",
    breadcrumbCurrent: "Processus",
    hero: {
      kicker: "VENDRE VOTRE CAMION",
      title: "Vendre votre camion ou utilitaire, simplement et en toute sécurité.",
      text:
        "Envoyez-nous les informations essentielles du véhicule. Nous vous recontactons rapidement et convenons avec vous de l'offre, du paiement, de la remise et, si besoin, de l'enlèvement.",
      primaryHref: "#demande",
      primaryLabel: "Vendre votre véhicule",
      secondaryHref: localizePath("services", "fr"),
      secondaryLabel: "Voir les services",
      trustline: ["Interlocuteur direct", "Estimation équitable", "En Allemagne et en Europe"],
    },
    stepsKicker: "COMMENT ÇA SE PASSE",
    stepsTitle: "Vendre votre véhicule en 5 étapes claires",
    steps: [
      { number: "01", title: "Envoyer les informations", text: "Indiquez le type de véhicule, la marque, l'année, le kilométrage, le lieu et, si possible, ajoutez des photos.", iconKey: "file" },
      { number: "02", title: "Recevoir un retour", text: "Nous revenons vers vous rapidement et clarifions les points à préciser avec vous.", iconKey: "message" },
      { number: "03", title: "Discuter l'offre", text: "À partir de vos informations, photos et documents, nous échangeons sur une offre cohérente avec le marché.", iconKey: "euro" },
      { number: "04", title: "Définir le paiement", text: "Le mode de paiement et le délai sont convenus clairement avant la remise.", iconKey: "payment" },
      { number: "05", title: "Prévoir la remise ou l'enlèvement", text: "Une fois l'accord trouvé, nous organisons la remise ou un enlèvement éventuel à la bonne date.", iconKey: "truck" },
    ],
    benefitsKicker: "VOS AVANTAGES",
    benefitsTitle: "Pourquoi les entreprises et les flottes vendent à WAW",
    benefits: [
      { title: "Coordination claire", text: "Du premier échange à la remise, vous savez toujours quelle est la prochaine étape.", iconKey: "shield" },
      { title: "Réponse rapide", text: "Nous examinons vos informations rapidement et parlons directement de la suite.", iconKey: "clock" },
      { title: "Estimation équitable", text: "Notre offre tient compte des données du véhicule, de son état et de son lieu.", iconKey: "euro" },
      { title: "En Allemagne et en Europe", text: "Vous pouvez nous proposer un véhicule seul ou une flotte complète.", iconKey: "map" },
    ],
    info: {
      kicker: "DIRECT & FIABLE",
      title: "Votre vente entre de bonnes mains",
      text:
        "Nous achetons des camions, semi-remorques, remorques, fourgons, machines de chantier et flottes complètes. Du premier message à la remise, le processus reste clair, direct et personnel.",
      points: [
        "Expérience dans le négoce de véhicules utilitaires depuis 1995",
        "Échange direct avec de vrais interlocuteurs",
        "Véhicules endommagés ou fort kilométrage possibles",
        "Toutes marques et tous modèles",
      ],
      imageAlt: "WAW Véhicules Utilitaires interlocuteur pour le rachat",
      callLabel: "Appeler maintenant",
    },
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Quand vais-je recevoir un retour ?", answer: "Dès que nous recevons les informations du véhicule, nous revenons vers vous rapidement. Plus vos informations et vos photos sont complètes, plus notre retour peut être précis." },
      { question: "Y a-t-il des frais pour moi ?", answer: "Non. Votre demande et le premier échange sont sans engagement. S'il y a quelque chose à préciser ensuite, nous en parlons avec vous de façon transparente à l'avance." },
      { question: "Achetez-vous aussi des véhicules endommagés ?", answer: "Oui. Vous pouvez également nous proposer des camions, remorques, fourgons, machines de chantier et flottes avec dommages, kilométrage élevé ou années plus anciennes." },
      { question: "Comment le paiement se déroule-t-il ?", answer: "Le paiement est effectué rapidement et en toute sécurité après accord et remise du véhicule. Nous clarifions tous les détails avec vous en amont." },
      { question: "Quels documents dois-je prévoir ?", answer: "Les documents du véhicule, justificatifs d'entretien, rapports de contrôle et photos claires sont utiles. Pour le premier contact, le type de véhicule, le lieu et vos coordonnées suffisent." },
      { question: "Dois-je livrer le véhicule moi-même ?", answer: "Pas forcément. Une fois l'accord trouvé, nous organisons la remise ou un enlèvement éventuel à une date adaptée, en Allemagne comme en Europe." },
    ],
    cta: {
      kicker: "VENDRE VOTRE VÉHICULE",
      title: "Envoyez les informations du véhicule et recevez un retour rapide",
      text: "Envoyez-nous les informations essentielles du véhicule. S'il manque encore des documents, vos coordonnées et une courte description suffisent pour démarrer.",
      callLabel: "Appeler maintenant",
      whatsappLabel: "WhatsApp",
      whatsappText: "Écrire maintenant",
      source: "Processus FR",
      submitLabel: "Vendre votre véhicule",
      sendingLabel: "Envoi...",
      privacyText: "Nous traitons vos données de manière confidentielle et ne les transmettons pas à des tiers.",
      defaultError: "Votre demande n'a pas pu être envoyée. Veuillez réessayer ou nous appeler directement.",
      placeholders: {
        name: "Nom",
        phone: "Téléphone",
        email: "E-mail",
        vehicle: "Véhicule, par ex. MAN TGX",
        year: "Année",
        mileage: "Kilométrage (env.)",
        message: "Informations complémentaires sur le véhicule",
      },
    },
  },
} as const;

const copy = content[lang];
const canonical = absoluteUrl(localizePath("process", lang));
const schema = [
  createBreadcrumbSchema([
    { name: copy.breadcrumbHome, url: absoluteUrl(localizePath("home", lang)) },
    { name: copy.breadcrumbCurrent, url: canonical },
  ]),
  createFaqSchema(copy.faqs),
];
---

<BaseLayout title={copy.title} description={copy.description} canonical={canonical} schema={schema}>
  <Header transparent />

  <main>
    <AblaufHero {...copy.hero} />
    <AblaufSteps kicker={copy.stepsKicker} title={copy.stepsTitle} steps={copy.steps} />
    <AblaufBenefits kicker={copy.benefitsKicker} title={copy.benefitsTitle} benefits={copy.benefits} />
    <AblaufInfo {...copy.info} />
    <AblaufFAQ faqs={copy.faqs} title={copy.faqTitle} />
    <AblaufCTA {...copy.cta} />
  </main>

  <Footer />
  <FloatingContact />
  <ScrollAnimations />
</BaseLayout>
