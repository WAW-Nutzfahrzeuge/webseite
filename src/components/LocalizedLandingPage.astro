const description = typeof page.description === "function" ? page.description(city as City) : page.description;
const kicker = typeof page.kicker === "function" ? page.kicker(city as City) : page.kicker;
const h1 = typeof page.h1 === "function" ? page.h1(city as City) : page.h1;
const heroText = typeof page.text === "function" ? page.text(city as City) : page.text;
const canonicalPath = pageKey === "city" && city ? localizeCityPath(city.slug, lang) : localizePath(pageKey as RouteKey, lang);
const canonical = new URL(canonicalPath, site.url).toString();
const faqSchemaItems = c.faqs.map(([question, answer]) => ({ question, answer }));
const schema = [
  createFaqSchema(faqSchemaItems),
  createBreadcrumbSchema([
    { name: "WAW", url: new URL(localizePath("home", lang), site.url).toString() },
    { name: h1.replace(/\.$/, ""), url: canonical },
  ]),
];

const detailText =
  pageKey === "city" && city
    ? `${city.name} is relevant for commercial vehicle sales because of regional businesses, transport companies, construction, trade and fleet operations. WAW is reachable for sellers in ${city.name}, ${city.state} and nearby areas.`
    : lang === "en"
