          title: "Rachat de flottes",
          text: "Proposez plusieurs camions, lots mixtes de véhicules ou flottes complètes en une seule demande.",
          image: "/images/fahrzeug_fuhrpark.webp",
          iconSrc: "/icons/fuhrpark.png",
          href: `${localizePath("services", lang)}#fuhrpark`,
        },
      ],
      benefits: [
        { label: "Nombreux états possibles", iconSrc: "/icons/lkw.png" },
        { label: "Décision rapide", iconSrc: "/icons/sattelzugmaschine.png" },
        { label: "Enlèvement sur accord", iconSrc: "/icons/transporter.png" },
        { label: "Paiement direct", iconSrc: "/icons/auflieger.png" },
        { label: "Traitement discret", iconSrc: "/icons/fuhrpark.png" },
      ],
    },
    benefits: {
      kicker: "POURQUOI WAW ?",
      title: "Vendre camions et utilitaires directement à WAW",
      items: [
        { title: "Sûr & fiable", text: "Coordination claire du premier contact à la remise du véhicule.", iconKey: "shield" },
        { title: "Traitement rapide", text: "Nous répondons rapidement et discutons directement des prochaines étapes.", iconKey: "clock" },
        { title: "Prix équitables", text: "Offres conformes au marché selon les données, l'état et l'emplacement du véhicule.", iconKey: "euro" },
        { title: "Allemagne et Europe", text: "Les véhicules situés en Allemagne et en Europe peuvent nous être proposés directement.", iconKey: "map" },
      ],
    },
    damage: {
      kicker: "AUSSI AVEC DÉFAUTS",
      title: "Les véhicules avec défauts ou dommages nous intéressent aussi",
      text: "Tous les utilitaires ne sont pas en parfait état. Nous achetons aussi des véhicules avec dommages, kilométrage élevé, années anciennes ou sans contrôle technique.",
      points: ["Moteur endommagé", "Boîte de vitesses endommagée", "Dommage accidentel", "Sans contrôle technique", "Kilométrage élevé", "Années anciennes"],
    },
    cta: {
      kicker: "VENDRE UN VÉHICULE ?",
      title: "Sélectionner le type de véhicule et envoyer la demande",
      text: "Envoyez-nous le type de véhicule, l'année, le kilométrage, l'état, l'emplacement et les photos disponibles. S'il manque des données, nous les clarifions ensemble.",
      callLabel: "Appeler",
      whatsappLabel: "WhatsApp",
      whatsappText: "Écrire maintenant",
      placeholders: {
        name: "Nom",
        phone: "Téléphone",
        email: "E-mail",
        vehicle: "Type de véhicule (camion, remorque, etc.)",
        year: "Année",
        mileage: "Kilométrage approx.",
        message: "Informations supplémentaires sur le véhicule",
      },
      submitLabel: "Envoyer la demande",
      sendingLabel: "Envoi...",
      source: "Page véhicules FR",
      privacyText: "Vos données sont traitées de manière confidentielle et ne sont pas transmises à des tiers.",
      fallbackError: "La demande n'a pas pu être envoyée. Veuillez réessayer ou appeler directement.",
    },
  },
}[lang];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} lang={lang}>
  <Header transparent lang={lang} />

  <main>
    {pageKey === "vehicles" ? (
      <>
        <FahrzeugeHero {...localizedVehiclePage.hero} />
        <FahrzeugCards
          introKicker={localizedVehiclePage.cards.introKicker}
          introTitle={localizedVehiclePage.cards.introTitle}
          introText={localizedVehiclePage.cards.introText}
          vehicleItems={localizedVehiclePage.cards.items}
          benefitItems={localizedVehiclePage.cards.benefits}
          linkLabel={localizedVehiclePage.cards.linkLabel}
        />
        <FahrzeugeBenefits
          kicker={localizedVehiclePage.benefits.kicker}
          title={localizedVehiclePage.benefits.title}
          items={localizedVehiclePage.benefits.items}
        />
        <FahrzeugeDamageSection {...localizedVehiclePage.damage} />
        <FahrzeugeCTA {...localizedVehiclePage.cta} />
      </>
    ) : (
      <>
    <section class="localized-hero" style={`--localized-hero-image: url("${localizedHeroImage}")`}>
      <div class="localized-hero-overlay"></div>
      <div class="container localized-hero-grid">
        <div class="localized-hero-copy" data-animate>
          <p class="localized-kicker">{kicker}</p>
          <h1>{h1}</h1>
          <p>{heroText}</p>
          <div class="localized-actions">
            <a href={localizePath("contact", lang)} class="btn btn-primary">{lang === "en" ? "Start inquiry" : "Démarrer une demande"}</a>
            <a href={`tel:${site.phoneHref}`} class="btn localized-outline">{lang === "en" ? "Call directly" : "Appeler directement"}</a>
          </div>
          <div class="localized-trust">
            {c.trust.map((item) => <span>{item}</span>)}
          </div>
        </div>

        <aside class="localized-hero-card" data-animate>
          <strong>{pageKey === "city" && city ? city.name : "WAW"}</strong>
          <span>{lang === "en" ? "Commercial vehicle purchase" : "Rachat de véhicules utilitaires"}</span>
          <p>{lang === "en" ? "Trucks, trailers, vans, construction machinery and fleets." : "Camions, remorques, fourgons, machines de chantier et flottes."}</p>
        </aside>
      </div>
    </section>

    <section class="localized-section localized-light">
      <div class="container localized-section-head" data-animate>
        <span>{pageKey === "locations" ? c.sections.locations : c.sections.vehicleTypes}</span>
        <h2>{pageKey === "locations" ? c.sections.locations : c.sections.vehicleTypes}</h2>
        <p>{detailText}</p>
      </div>

      {pageKey === "locations" ? (
        <div class="container localized-city-grid">
          {navigationCities.map((entry) => (
            <a href={localizeCityPath(entry.slug, lang)} class="localized-city-card" data-animate>
              <span>{entry.state}</span>
              <strong>{entry.name}</strong>
              <p>{entry.cardText}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="container localized-card-grid">
          {c.vehicles.map((vehicle, index) => {
            const iconSrc = localizedVehicleIcons[index] || localizedVehicleIcons[0];
            return (
            <a href={localizePath("contact", lang)} class="localized-card" data-animate>
              <span class="localized-icon">
                <img src={iconSrc} alt="" loading="lazy" aria-hidden="true" />
              </span>
              <h3>{vehicle}</h3>
              <p>{lang === "en" ? "Offer this vehicle type directly to WAW." : "Proposez ce type de véhicule directement à WAW."}</p>
            </a>
            );
          })}
        </div>
      )}
    </section>

    <section class="localized-section localized-dark">
      <div class="container">
        <div class="localized-section-head localized-section-head--dark" data-animate>
          <span>{c.sections.benefits}</span>
          <h2>{c.sections.benefits}</h2>
        </div>
        <div class="localized-card-grid localized-card-grid--dark">
          {c.benefits.map(([title, text]) => (
            <article class="localized-dark-card" data-animate>
              <span class="localized-icon">✓</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="localized-section localized-light">
      <div class="container localized-split">
        <div data-animate>
          <span class="localized-small-kicker">{c.sections.process}</span>
          <h2>{c.sections.process}</h2>
          <p>{lang === "en" ? "The sale is coordinated in a few clear steps, with direct contact and no unnecessary detours." : "La vente est coordonnée en quelques étapes claires, avec un contact direct et sans détour inutile."}</p>
          <a href={localizePath("process", lang)} class="btn btn-primary">{lang === "en" ? "View process" : "Voir le processus"}</a>
        </div>
        <div class="localized-steps">
          {c.steps.map((step, index) => (
            <div class="localized-step" data-animate>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{step}</strong>
            </div>
          ))}
        </div>
      </div>
    </section>

    {pageKey !== "contact" && (
      <section class="localized-section localized-light localized-locations-teaser">
        <div class="container localized-section-head" data-animate>
          <span>{c.sections.locations}</span>
          <h2>{c.sections.locations}</h2>
        </div>
        <div class="container localized-city-row">
          {navigationCities.slice(0, 8).map((entry) => (
            <a href={localizeCityPath(entry.slug, lang)}>{entry.name}</a>
          ))}
        </div>
      </section>
    )}

    <section class="localized-section localized-light">
      <div class="container localized-split localized-split--form">
        <div data-animate>
          <span class="localized-small-kicker">{c.sections.finalCta}</span>
          <h2>{c.sections.finalCta}</h2>
          <p>{c.sections.finalText}</p>
          <div class="localized-contact-links">
            <a href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp</a>
            <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
          </div>
        </div>
        <LeadForm compact={true} lang={lang} />
      </div>
    </section>

    <section class="localized-section localized-faq">
      <div class="container localized-section-head" data-animate>
        <span>FAQ</span>
        <h2>{c.sections.faq}</h2>
      </div>
      <div class="container localized-faq-grid">
        {c.faqs.map(([question, answer]) => (
          <details class="localized-faq-item" data-animate>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
      </>
    )}
  </main>

  <Footer lang={lang} />
  <FloatingContact lang={lang} />
  <ScrollAnimations />
</BaseLayout>

<style>
  .localized-hero {
    position: relative;
    min-height: 740px;
    padding: 166px 0 90px;
    color: #fff;
    overflow: hidden;
    background-image: var(--localized-hero-image);
    background-size: cover;
    background-position: center right;
  }

  .localized-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 22%, rgba(255,107,0,0.24), transparent 28rem),
      linear-gradient(90deg, rgba(3,10,20,0.88), rgba(3,10,20,0.54), rgba(3,10,20,0.2));
  }

  .localized-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 420px);
    gap: clamp(34px, 5vw, 70px);
    align-items: center;
  }

  .localized-hero-copy h1 {
    margin: 0;
    max-width: 860px;
    color: #fff;
    font-size: clamp(48px, 6.4vw, 92px);
    line-height: 0.94;
    letter-spacing: -0.065em;
  }

  .localized-hero-copy p {
    max-width: 720px;
    color: rgba(255,255,255,0.8);
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.65;
  }

  .localized-kicker,
  .localized-small-kicker {
    display: inline-flex;
    margin: 0 0 18px;
    color: var(--orange);
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .localized-actions,
  .localized-trust,
  .localized-contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .localized-outline {
    border: 1px solid rgba(255,255,255,0.36);
    background: rgba(255,255,255,0.08);
    color: #fff;
  }

  .localized-trust {
    gap: 24px;
    color: rgba(255,255,255,0.88);
    font-weight: 850;
  }

  .localized-trust span::before {
    content: "✓";
    margin-right: 8px;
    color: var(--orange);
  }

  .localized-hero-card {
    padding: 28px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 26px;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(18px);
    box-shadow: 0 26px 80px rgba(0,0,0,0.24);
  }

  .localized-hero-card strong,
  .localized-hero-card span {
    display: block;
  }

  .localized-hero-card strong {
    font-size: clamp(34px, 4vw, 54px);
    letter-spacing: -0.06em;
  }

  .localized-hero-card span {
    color: var(--orange);
    font-weight: 900;
    margin-top: 8px;
  }

  .localized-section {
    padding: 84px 0;
  }

  .localized-light {
    background: #fff;
  }

  .localized-dark {
    background:
      radial-gradient(circle at top right, rgba(255,107,0,0.22), transparent 24rem),
      linear-gradient(135deg, #031122, #071a33);
    color: #fff;
  }

  .localized-section-head {
    max-width: 860px;
    margin-bottom: 34px;
  }

  .localized-section-head span {
    color: var(--orange);
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .localized-section-head h2,
  .localized-split h2 {
    margin: 10px 0 12px;
    font-size: clamp(34px, 4.8vw, 62px);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .localized-section-head p,
  .localized-split p {
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
  }

  .localized-section-head--dark p,
  .localized-section-head--dark h2,
  .localized-dark-card p {
    color: rgba(255,255,255,0.72);
  }

  .localized-card-grid,
  .localized-city-grid,
  .localized-faq-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .localized-card,
  .localized-city-card,
  .localized-dark-card,
  .localized-faq-item {
    padding: 24px;
    border-radius: 22px;
    border: 1px solid rgba(15,23,42,0.08);
    background: #fff;
    box-shadow: 0 16px 42px rgba(15,23,42,0.08);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .localized-card:hover,
  .localized-city-card:hover,
  .localized-dark-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255,107,0,0.32);
    box-shadow: 0 26px 70px rgba(15,23,42,0.12);
  }

  .localized-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-bottom: 16px;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    font-weight: 950;
  }

  .localized-icon img {
    width: 22px;
    height: 22px;
    display: block;
    object-fit: contain;
  }

  .localized-card h3,
  .localized-dark-card h3 {
    margin: 0 0 8px;
    font-size: 21px;
    letter-spacing: -0.04em;
  }

  .localized-card p,
  .localized-city-card p {
    color: var(--muted);
    line-height: 1.6;
  }

  .localized-dark-card {
    background: rgba(255,255,255,0.075);
    border-color: rgba(255,255,255,0.14);
    box-shadow: none;
  }

  .localized-city-card span {
    color: var(--orange);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .localized-city-card strong {
    display: block;
    margin-top: 8px;
    font-size: 28px;
    letter-spacing: -0.05em;
  }

  .localized-split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1fr);
    gap: clamp(32px, 5vw, 70px);
    align-items: center;
  }

  .localized-steps {
    display: grid;
    gap: 12px;
  }

  .localized-step {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px;
    border-radius: 18px;
    background: #f7f8fa;
    border: 1px solid rgba(15,23,42,0.08);
  }

  .localized-step span {
    color: var(--orange);
    font-weight: 950;
  }

  .localized-city-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .localized-city-row a,
  .localized-contact-links a {
    padding: 12px 16px;
    border-radius: 999px;
    background: rgba(255,107,0,0.1);
    color: var(--text);
    font-weight: 850;
  }

  .localized-faq {
    background: #f6f7f9;
  }

  .localized-faq-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .localized-faq-item summary {
    cursor: pointer;
    font-weight: 900;
    color: var(--text);
  }

  .localized-faq-item p {
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 980px) {
    .localized-hero-grid,
    .localized-split {
      grid-template-columns: 1fr;
    }

    .localized-card-grid,
    .localized-city-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .localized-hero {
      min-height: auto;
      padding: 126px 0 64px;
      background-image: var(--localized-hero-image);
      background-position: center top;
    }

    .localized-hero-card {
      display: none;
    }

    .localized-actions {
      flex-direction: column;
    }

    .localized-card-grid,
    .localized-city-grid,
    .localized-faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
