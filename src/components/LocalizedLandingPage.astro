---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingContact from "./FloatingContact.astro";
import ContactLeadForm from "./ContactLeadForm.astro";
import { site } from "../data/site";
import { navigationCities, indexableCitySlugs, type City } from "../data/cities";
import { localizeCityPath, localizePath, type Locale, type RouteKey } from "../data/i18n";
import { absoluteUrl, createBreadcrumbSchema, createFaqSchema } from "../utils/seo";

const { lang, pageKey, city } = Astro.props as { lang: Locale; pageKey: RouteKey | "city"; city?: City };
const language = lang === "fr" ? "fr" : "en";
const c = {
  en: {
    home: ["Sell trucks and commercial vehicles", "We buy trucks, tractor units, semi-trailers, trailers, vans, construction machinery, special vehicles and fleets across Germany and Europe."],
    about: ["Direct commercial vehicle purchase from WAW", "Based in Talkau, Schleswig-Holstein, we buy individual commercial vehicles, vehicle packages and fleets from businesses, operators and dealers."],
    services: ["Commercial vehicle purchase: types and conditions", "Offer a single truck, construction machine or an entire fleet. Tell us the vehicle type, condition and location; we will assess whether a purchase is possible."],
    locations: ["Truck purchase across Germany and Europe", "Our business is based in Talkau. The cities below describe our purchase areas, not additional branches. You can also offer vehicles from other locations."],
    city: [`Sell trucks in ${city?.name || ""}`, `Offer trucks, trailers, vans, machinery or fleets located in ${city?.name || ""}. Our business is based in Talkau; this page does not represent a local branch.`],
    legalNotice: ["Legal notice", "The full provider information is available on our German legal notice page. This page is not a translated legal notice."],
    privacy: ["Privacy information", "We process the details you submit to handle your inquiry. Our forms use Resend for email delivery. Please consult the full German privacy policy for information about processing, service providers and your rights."],
    terms: ["Terms and conditions", "Our German terms page contains the available information. This page is not a translated set of terms."],
    vehicles: ["Vehicles we buy", "Commercial vehicles, machinery and fleets."],
    process: ["How the sale works", "Inquiry, assessment, offer and an individually agreed handover."],
    contact: ["Offer your vehicle", "Contact WAW directly."],
    conditions: "Engine, transmission or accident damage, high mileage, older model years, expired inspections and non-running vehicles can all be offered. This is not a guarantee to purchase every vehicle.",
    inquiry: "Offer your vehicle without obligation",
    types: "Vehicle types we buy",
    typeNames: ["Trucks", "Tractor units", "Semi-trailers", "Trailers", "Vans", "Construction machinery and special vehicles", "Fleets and vehicle packages"],
    typeText: ["Rigid trucks, tippers, box trucks, refrigerated and curtainside trucks.", "Tractor units from different manufacturers and model years.", "Curtainsiders, refrigerated semi-trailers, tippers and low loaders.", "Commercial drawbar, centre-axle and specialist trailers.", "Light commercial vehicles from businesses and fleets.", "Excavators, wheel loaders, concrete mixers, cranes and other commercial machinery.", "Individual vehicles, mixed packages and complete fleets, including multiple locations."],
    processTitle: "From inquiry to handover",
    steps: ["Send your name and phone number. Add vehicle details and location if available.", "We review your details, clarify questions and discuss an offer if a purchase is possible.", "Before the sale, we agree the price, payment method and timing, handover and any collection arrangements."],
    contactTitle: "One contact for your vehicle or fleet",
    contactText: "Tell us whether you are replacing vehicles, renewing a fleet, selling surplus vehicles or dealing with damage. Incomplete vehicle details do not prevent an initial inquiry.",
    legalLink: "Read the full German document",
    coverageTitle: "Purchase areas in Germany",
    faqTitle: "Questions before you offer a vehicle",
    faqs: [
      { question: "Can I offer a damaged or non-running vehicle?", answer: "Yes. Please describe known damage and whether the vehicle can move under its own power. We will assess whether a purchase is possible and discuss transport individually." },
      { question: "Do I need all vehicle details?", answer: "No. Your name and phone number are enough for the first contact. Send photos and vehicle lists by email; there is no file upload in this form." },
      { question: "Can I offer several vehicles at different locations?", answer: "Yes. Tell us the number and types of vehicles, their condition and locations. A complete vehicle list is not required for your first inquiry." },
    ],
  },
  fr: {
    home: ["Vendre camions et véhicules utilitaires", "Nous achetons camions, tracteurs routiers, semi-remorques, remorques, fourgons, machines de chantier, véhicules spéciaux et flottes en Allemagne et en Europe."],
    about: ["Le rachat direct de véhicules utilitaires par WAW", "Depuis Talkau, dans le Schleswig-Holstein, nous achetons des véhicules utilitaires, lots et flottes auprès d'entreprises, d'exploitants et de négociants."],
    services: ["Rachat de véhicules utilitaires : types et états", "Proposez un camion, une machine ou une flotte complète. Indiquez le type, l'état et le lieu des véhicules ; nous examinerons la possibilité d'un rachat."],
    locations: ["Rachat de camions en Allemagne et en Europe", "Notre entreprise est située à Talkau. Les villes ci-dessous sont des zones de rachat, pas des succursales. Vous pouvez aussi proposer des véhicules situés ailleurs."],
    city: [`Vendre un camion à ${city?.name || ""}`, `Proposez camions, remorques, fourgons, machines ou flottes situés à ${city?.name || ""}. Notre entreprise est située à Talkau ; cette page ne représente pas une succursale locale.`],
    legalNotice: ["Mentions légales", "Les informations complètes sur l'éditeur figurent sur notre page allemande. Cette page ne constitue pas une traduction des mentions légales."],
    privacy: ["Informations sur la confidentialité", "Nous traitons vos coordonnées pour répondre à votre demande. Les formulaires utilisent Resend pour l'envoi d'e-mails. Consultez notre politique allemande complète pour les traitements, prestataires et droits des personnes."],
    terms: ["Conditions générales", "Les informations disponibles figurent sur notre page allemande. Cette page ne constitue pas une traduction des conditions générales."],
    vehicles: ["Les véhicules que nous achetons", "Utilitaires, machines et flottes."],
    process: ["Comment se déroule la vente", "Demande, examen, offre et remise convenue individuellement."],
    contact: ["Proposer votre véhicule", "Contactez WAW directement."],
    conditions: "Panne moteur ou boîte de vitesses, accident, kilométrage élevé, véhicule ancien, sans contrôle technique ou non roulant : vous pouvez nous le proposer. Il ne s'agit pas d'une garantie de rachat de chaque véhicule.",
    inquiry: "Proposer votre véhicule sans engagement",
    types: "Les types de véhicules que nous achetons",
    typeNames: ["Camions", "Tracteurs routiers", "Semi-remorques", "Remorques", "Fourgons", "Machines de chantier et véhicules spéciaux", "Flottes et lots de véhicules"],
    typeText: ["Camions porteurs, bennes, fourgons, frigorifiques et bâchés.", "Tracteurs routiers de différentes marques et années.", "Semi-remorques bâchées, frigorifiques, bennes et porte-engins.", "Remorques commerciales à timon, à essieux centraux et spéciales.", "Utilitaires légers d'entreprises et de flottes.", "Pelles, chargeuses, bétonnières, grues et autres machines professionnelles.", "Véhicules individuels, lots mixtes et flottes complètes, même sur plusieurs sites."],
    processTitle: "De la demande à la remise",
    steps: ["Envoyez votre nom et votre téléphone. Ajoutez les données et le lieu du véhicule si disponibles.", "Nous examinons vos informations, clarifions les questions et discutons d'une offre si un rachat est possible.", "Avant la vente, nous convenons du prix, du mode et du moment du paiement, de la remise et d'un éventuel enlèvement."],
    contactTitle: "Un contact direct pour votre véhicule ou votre flotte",
    contactText: "Remplacement, renouvellement de flotte, véhicules en surplus ou dommages : décrivez votre situation. Des informations incomplètes n'empêchent pas une première demande.",
    legalLink: "Lire le document complet en allemand",
    coverageTitle: "Zones de rachat en Allemagne",
    faqTitle: "Questions avant de proposer un véhicule",
    faqs: [
      { question: "Puis-je proposer un véhicule endommagé ou non roulant ?", answer: "Oui. Décrivez les dommages connus et indiquez si le véhicule roule. Nous examinons la possibilité d'un rachat et convenons du transport individuellement." },
      { question: "Faut-il toutes les données du véhicule ?", answer: "Non. Votre nom et votre téléphone suffisent pour un premier contact. Envoyez photos et listes par e-mail ; ce formulaire ne permet pas de joindre des fichiers." },
      { question: "Puis-je proposer plusieurs véhicules sur différents sites ?", answer: "Oui. Indiquez le nombre, les types, les états et les lieux. Une liste complète n'est pas nécessaire pour votre première demande." },
    ],
  },
}[language];
const [heading, description] = c[pageKey];
const legalKey = pageKey === "legalNotice" || pageKey === "privacy" || pageKey === "terms" ? pageKey : null;
const canonical = absoluteUrl(pageKey === "city" && city ? localizeCityPath(city.slug, lang) : localizePath(pageKey === "city" ? "locations" : pageKey, lang));
const schema = [
  createBreadcrumbSchema([{ name: "WAW", url: absoluteUrl(localizePath("home", lang)) }, { name: heading, url: canonical }]),
  ...(!legalKey ? [createFaqSchema(c.faqs)] : []),
];
const serviceIds = ["lkw", "sattelzugmaschinen", "auflieger", "anhaenger", "transporter", "baumaschinen", "fuhrpark"];
---
<BaseLayout title={`${heading} | WAW`} description={description} canonical={canonical} schema={schema} lang={lang}>
  {pageKey === "city" && city && !indexableCitySlugs.has(city.slug) && <Fragment slot="head"><meta name="robots" content="noindex,follow" /></Fragment>}
  <Header />
  <main>
    <section class="localized-hero">
      <div class="container">
        <h1>{heading}</h1>
        <p>{description}</p>
        {!legalKey && <>
          <p>{c.conditions}</p>
          <a class="btn btn-primary" href="#kontaktformular">{c.inquiry}</a>
        </>}
        {legalKey && <a class="btn btn-primary" href={localizePath(legalKey, "de")} hreflang="de">{c.legalLink}</a>}
      </div>
    </section>
    {!legalKey && <>
      {(pageKey === "home" || pageKey === "services") && <section class="section">
        <div class="container">
          <h2>{c.types}</h2>
          <div class="vehicle-grid">
            {c.typeNames.map((name, index) => <article id={serviceIds[index]}>
              <h3>{name}</h3><p>{c.typeText[index]}</p><a href="#kontaktformular">{c.inquiry}</a>
            </article>)}
          </div>
          {pageKey === "services" && <div id="nutzfahrzeuge"><h3>{language === "en" ? "Other commercial vehicles" : "Autres véhicules utilitaires"}</h3><p>{c.conditions}</p></div>}
        </div>
      </section>}
      {(pageKey === "locations" || pageKey === "city") && <section class="section coverage-section">
        <div class="container">
          <h2>{c.coverageTitle}</h2>
          <p>{c.locations[1]}</p>
          {city && <p>{city.name}, {city.state}</p>}
          <nav class="city-links" aria-label={c.coverageTitle}>
            {navigationCities.map((entry) => <a href={localizeCityPath(entry.slug, lang)}>{entry.name}</a>)}
          </nav>
        </div>
      </section>}
      <section class="section">
        <div class="container">
          <h2>{pageKey === "about" ? c.contactTitle : c.processTitle}</h2>
          {pageKey === "about" && <p>{c.contactText}</p>}
          <ol>{c.steps.map((step) => <li>{step}</li>)}</ol>
          <a href={localizePath("process", lang)}>{c.processTitle}</a>
        </div>
      </section>
      <section class="section inquiry-section">
        <div class="container inquiry-grid">
          <div><h2>{c.contactTitle}</h2><p>{c.contactText}</p><p><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></p><p><a href={`mailto:${site.email}`}>{site.email}</a></p>{site.whatsappHref && <a href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp</a>}</div>
          <ContactLeadForm />
        </div>
      </section>
      <section class="section">
        <div class="container"><h2>{c.faqTitle}</h2>{c.faqs.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
      </section>
    </>}
  </main>
  <Footer /><FloatingContact />
</BaseLayout>
<style>
  .localized-hero { padding: 140px 0 64px; color: #fff; background: var(--navy); }
  h1 { font-size: clamp(36px, 4.5vw, 68px); line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 24px; max-width: 24ch; }
  h2 { font-size: clamp(28px, 3vw, 42px); line-height: 1.2; margin: 0 0 24px; max-width: 30ch; }
  h3 { font-size: 24px; line-height: 1.25; }
  p, li { max-width: 75ch; line-height: 1.75; }
  li { margin-bottom: 16px; }
  .vehicle-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  article { padding-block: 16px; border-bottom: 1px solid #bdc9d8; scroll-margin-top: 110px; }
  .section a { text-decoration: underline; text-underline-offset: 3px; }
  .coverage-section, .inquiry-section { background: #fff; }
  .city-links { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 24px; }
  .inquiry-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 48px; align-items: start; }
  details { max-width: 900px; border-bottom: 1px solid #bdc9d8; padding: 20px 0; }
  summary { cursor: pointer; font-weight: 700; }
  @media (max-width: 850px) { .vehicle-grid, .inquiry-grid { grid-template-columns: 1fr; } }
</style>
