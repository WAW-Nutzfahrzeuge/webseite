---
import { ArrowRight, CircleCheck } from "@lucide/astro";

interface Props {
  services: any[];
}

const { services } = Astro.props;
---

<section class="services-overview-modern" aria-labelledby="services-overview-title">
  <div class="container">
    <div class="services-section-head" data-animate>
      <span>UNSERE ANKAUFBEREICHE</span>
      <h2 id="services-overview-title">Welche Fahrzeuge kaufen wir an?</h2>
      <p>
        Vom einzelnen LKW bis zum kompletten Fuhrpark: Senden Sie uns die
        Fahrzeugdaten, wir stimmen den weiteren Ablauf direkt mit Ihnen ab.
      </p>
    </div>

    <div class="services-overview-grid">
      {services.map((service) => (
        <article class={`services-overview-card ${service.featured ? "is-featured" : ""}`} data-animate>
          <a href={`#${service.id}`} aria-label={`${service.title} ansehen`}>
            <div class="services-card-top">
              <div class="services-card-icon">
                <img src={service.iconSrc} alt="" loading="lazy" aria-hidden="true" />
              </div>
              <ArrowRight class="services-card-arrow" aria-hidden="true" />
            </div>
            <h3>{service.title}</h3>
            <p>{service.short}</p>
            <ul>
              {service.cardBullets.map((bullet) => (
                <li>
                  <CircleCheck size={16} stroke-width={2.4} aria-hidden="true" />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            <em>Details ansehen</em>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-overview-modern {
    padding: clamp(72px, 8vw, 116px) 0;
    background: #fff;
  }

  .services-section-head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 0.72fr);
    gap: 34px;
    align-items: end;
    margin-bottom: 36px;
  }

  .services-section-head span {
    grid-column: 1 / -1;
    color: var(--orange);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.11em;
  }

  .services-section-head h2 {
    margin: 0;
    color: #111827;
    font-size: clamp(38px, 5vw, 68px);
    line-height: 0.98;
    letter-spacing: -0.07em;
  }

  .services-section-head p {
    margin: 0;
    color: #5b6675;
    font-size: 17px;
    line-height: 1.75;
  }

  .services-overview-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .services-overview-card {
    min-height: 342px;
  }

  .services-overview-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px;
    border: 1px solid rgba(17,24,39,0.08);
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 16px 46px rgba(15,23,42,0.065);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .services-overview-card.is-featured a {
    border-color: rgba(255,107,0,0.25);
    background:
      radial-gradient(circle at top right, rgba(255,107,0,0.12), transparent 16rem),
      #fff;
  }

  .services-overview-card a:hover {
    transform: translateY(-6px);
    border-color: rgba(255,107,0,0.38);
    box-shadow: 0 28px 76px rgba(15,23,42,0.12);
  }

  .services-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    margin-bottom: 28px;
  }

  .services-card-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid rgba(255,107,0,0.18);
    border-radius: 18px;
    background: rgba(255,107,0,0.1);
    color: var(--orange);
    transition: transform 220ms ease;
  }

  .services-card-icon img {
    width: 31px;
    height: 31px;
    display: block;
    object-fit: contain;
  }

  .services-card-arrow {
    width: 19px;
    height: 19px;
    color: var(--orange);
    transition: transform 220ms ease;
  }

  .services-overview-card a:hover .services-card-icon {
    transform: translateY(-3px);
  }

  .services-overview-card a:hover .services-card-arrow {
    transform: translateX(4px);
  }

  .services-overview-card h3 {
    margin: 0;
    color: #111827;
    font-size: 24px;
    line-height: 1.08;
    letter-spacing: -0.05em;
  }

  .services-overview-card p {
    margin: 13px 0 0;
    color: #5b6675;
    font-size: 15px;
    line-height: 1.6;
  }

  .services-overview-card ul {
    display: grid;
    gap: 9px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .services-overview-card li {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    color: #1f2937;
    font-size: 14px;
    font-weight: 760;
    line-height: 1.35;
  }

  .services-overview-card li svg {
    flex: 0 0 auto;
    margin-top: 1px;
    color: var(--orange);
  }

  .services-overview-card em {
    margin-top: auto;
    padding-top: 24px;
    color: var(--orange);
    font-size: 14px;
    font-style: normal;
    font-weight: 950;
  }

  @media (max-width: 1180px) {
    .services-overview-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .services-overview-modern {
      padding: 64px 0;
    }

    .services-section-head {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .services-section-head span {
      grid-column: auto;
    }

    .services-section-head h2 {
      font-size: clamp(34px, 11vw, 48px);
    }

    .services-overview-grid {
      grid-template-columns: 1fr;
    }

    .services-overview-card {
      min-height: 0;
    }
  }
</style>
