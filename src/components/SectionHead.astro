---
const {
    badge,
    title,
    text
} = Astro.props;
---

<div class="section-head">
    {
        badge && (
                    <span class="badge">
        {badge}
      </span>
        )
    }

    <h2>{title}</h2>

    {
        text && (
                    <p>{text}</p>
        )
    }
</div>

<style>
    .section-head {
        max-width: 760px;

        margin-bottom: 34px;
    }

    h2 {
        margin:
                18px 0
                0;

        font-size: clamp(36px, 5vw, 64px);

        line-height: 0.98;

        letter-spacing: -0.06em;

        color: var(--text);
    }

    p {
        margin-top: 18px;

        color: var(--muted);

        font-size: 19px;

        line-height: 1.7;
    }
</style>