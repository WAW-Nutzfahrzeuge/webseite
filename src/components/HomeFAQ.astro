---
import { Plus } from "@lucide/astro";
import { getLocaleFromPath, localizePath } from "../data/i18n";
import { homeCopy } from "../data/home";
const lang = getLocaleFromPath(Astro.url.pathname);
const c = homeCopy[lang];
---
<section class="home-faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq-wrap">
    <div class="faq-copy">
      <h2 id="faq-title">{c.faqTitle}</h2>
      <p>{c.faqText}</p>
      <a href={localizePath("contact", lang)}>{c.faqLink}</a>
    </div>
    <div class="faq-list">
      {c.faqs.map((item) => (
        <details class="faq-card">
          <summary>{item.question}<Plus size={20} aria-hidden="true" /></summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const faqCards = document.querySelectorAll<HTMLDetailsElement>(".faq-card");
  faqCards.forEach((card) => {
    card.addEventListener("toggle", () => {
      if (card.open) {
        faqCards.forEach((otherCard) => {
          if (otherCard !== card) otherCard.removeAttribute("open");
        });
      }
    });
  });
</script>

<style>
  .home-faq { padding: 80px 0 48px; background: #fff; }
  .container { max-width: 1320px; }
  .faq-wrap { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(36px, 6vw, 88px); align-items: start; }
  h2 { margin: 0; font-size: clamp(30px, 3vw, 42px); line-height: 1.15; }
  .faq-copy p { margin: 22px 0; color: #435063; font-size: 17px; line-height: 1.75; }
  .faq-copy a { display: inline-block; padding-block: 12px; font-weight: 750; text-decoration: underline; text-underline-offset: 5px; }
  .faq-copy a:hover { color: #a94300; }
  .faq-card { border-bottom: 1px solid #d2dae3; }
  .faq-card:hover { box-shadow: none; }
  .faq-card:first-child { border-top: 1px solid #d2dae3; }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 0; list-style: none; cursor: pointer; font-size: 17px; font-weight: 750; line-height: 1.5; }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { color: #b94d00; flex-shrink: 0; }
  details[open] summary :global(svg) { transform: rotate(45deg); }
  .faq-card p { margin: 0; padding: 0 36px 24px 0; color: #435063; font-size: 16px; line-height: 1.75; }
  @media (max-width: 760px) {
    .home-faq { padding: 48px 6px 24px; }
    .faq-wrap { grid-template-columns: 1fr; gap: 28px; }
    summary { font-size: 16px; padding-block: 20px; }
  }
</style>
