---
const { faqs, title = "Häufige Fragen zum Ablauf", kicker = "FAQ" } = Astro.props;
---

<section class="ablauf-faq">
  <div class="container">
    <div class="faq-head" data-animate>
      <span>{kicker}</span>
      <h2>{title}</h2>
    </div>

    <div class="faq-grid">
      {faqs.map((faq, index) => (
        <details class="faq-item" data-ablauf-faq data-animate open={index === 0}>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const faqItems = document.querySelectorAll("[data-ablauf-faq]");
  faqItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if ((item as HTMLDetailsElement).open) {
        faqItems.forEach((other) => {
          if (other !== item) (other as HTMLDetailsElement).removeAttribute("open");
        });
      }
    });
  });
</script>

<style>
  .ablauf-faq {
    padding: 82px 0;
    background:
      radial-gradient(circle at 50% 0%, rgba(255,107,0,0.06), transparent 20rem),
      #fff;
  }

  .faq-head {
    text-align: center;
    margin-bottom: 34px;
  }

  .faq-head span {
    color: var(--orange);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .faq-head h2 {
    margin: 12px 0 0;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1;
    letter-spacing: -0.068em;
  }

  .faq-grid {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 12px 18px;
  }

  .faq-item {
    height: fit-content;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    border: 1px solid rgba(17,24,39,0.1);
    box-shadow: 0 10px 34px rgba(15,23,42,0.05);
  }

  .faq-item summary {
    position: relative;
    list-style: none;
    cursor: pointer;
    padding: 19px 58px 19px 20px;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -0.035em;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "+";
    position: absolute;
    right: 18px;
    top: 50%;
    width: 28px;
    height: 28px;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    color: #111827;
    font-size: 20px;
    transition: 220ms ease;
  }

  .faq-item[open] summary::after {
    content: "−";
    color: var(--orange);
  }

  .faq-item p {
    margin: 0;
    padding: 0 20px 20px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .ablauf-faq {
      padding: 62px 0;
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
