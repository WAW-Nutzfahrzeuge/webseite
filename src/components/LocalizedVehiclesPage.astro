---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingContact from "./FloatingContact.astro";
import ScrollAnimations from "./ScrollAnimations.astro";
import FahrzeugeHero from "./FahrzeugeHero.astro";
import FahrzeugCards from "./FahrzeugCards.astro";
import FahrzeugeBenefits from "./FahrzeugeBenefits.astro";
import FahrzeugeDamageSection from "./FahrzeugeDamageSection.astro";
import FahrzeugeCTA from "./FahrzeugeCTA.astro";
import { localizePath, type Locale } from "../data/i18n";
import { absoluteUrl, createBreadcrumbSchema } from "../utils/seo";

const { lang } = Astro.props as { lang: Exclude<Locale, "de"> };

const copy = {
