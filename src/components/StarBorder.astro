---
interface Props {
    as?: string;
    color?: string;
    speed?: string;
    thickness?: number;
    type?: string;
    class?: string;
    id?: string;
    disabled?: boolean;
    [key: string]: unknown;
}

const {
    as: Tag = 'button',
    color = 'white',
    speed = '6s',
    thickness = 1,
    class: className = '',
    ...rest
} = Astro.props;
---

<Tag
    class={`star-border-container ${className}`}
    style={`padding: ${thickness}px 0;`}
    {...rest}
>
    <div
        class="border-gradient-bottom"
        style={`background: radial-gradient(circle, ${color}, transparent 10%); animation-duration: ${speed};`}
    ></div>
    <div
        class="border-gradient-top"
        style={`background: radial-gradient(circle, ${color}, transparent 10%); animation-duration: ${speed};`}
    ></div>
    <div class="inner-content">
        <slot />
    </div>
</Tag>

<style>
    .star-border-container {
        display: inline-block;
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        cursor: pointer;
        border: none;
        background: transparent;
        padding-left: 0;
        padding-right: 0;
    }

    .border-gradient-bottom {
        position: absolute;
        width: 300%;
        height: 50%;
        opacity: 0.7;
        bottom: -12px;
        right: -250%;
        border-radius: 50%;
        animation: star-movement-bottom linear infinite alternate;
        z-index: 0;
    }

    .border-gradient-top {
        position: absolute;
        opacity: 0.7;
        width: 300%;
        height: 50%;
        top: -12px;
        left: -250%;
        border-radius: 50%;
        animation: star-movement-top linear infinite alternate;
        z-index: 0;
    }

    .inner-content {
        position: relative;
        border: 1px solid #222;
        background: #000;
        color: white;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: -0.02em;
        text-align: center;
        padding: 16px 26px;
        border-radius: 20px;
        z-index: 1;
        transition: background 200ms ease;
    }

    .star-border-container:hover .inner-content {
        background: #0a0a0a;
    }

    .star-border-container:disabled .inner-content,
    .star-border-container[disabled] .inner-content {
        opacity: 0.5;
        cursor: not-allowed;
    }

    @keyframes star-movement-bottom {
        0%   { transform: translate(0%, 0%);    opacity: 1; }
        100% { transform: translate(-100%, 0%); opacity: 0; }
    }

    @keyframes star-movement-top {
        0%   { transform: translate(0%, 0%);   opacity: 1; }
        100% { transform: translate(100%, 0%); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .border-gradient-bottom,
        .border-gradient-top { animation: none; opacity: 0; }
    }
</style>
