---
import { featuredCities } from "../data/cities";
---

<section class="city-links section">
    <div class="container">
        <div class="city-links-header">
            <span class="badge">Standorte</span>

            <h2>LKW Ankauf in Norddeutschland</h2>

            <p>
                WAW kauft Nutzfahrzeuge, Auflieger, Transporter und
                Baumaschinen deutschland- und europaweit an.
            </p>
        </div>

        <div class="city-links-grid">
            {featuredCities.map((city) => (
                    <a href={`/lkw-verkaufen/${city.slug}`} class="city-link-card">
                        <span class="city-link-dot"></span>

                        <strong>{city.name}</strong>

                        <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                        >
                            <path d="M5 12h14"></path>
                            <path d="m12 5 7 7-7 7"></path>
                        </svg>
                    </a>
            ))}
        </div>
    </div>
</section>

<style>
    .city-links-header {
        max-width: 720px;
        margin-bottom: 34px;
    }

    .city-links-header h2 {
        margin: 16px 0 12px;

        font-size: clamp(36px, 5vw, 58px);
        line-height: 0.98;
        letter-spacing: -0.06em;
    }

    .city-links-header p {
        color: var(--muted);
        font-size: 18px;
        line-height: 1.7;
    }

    .city-links-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
    }

    .city-link-card {
        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 22px;

        border-radius: 28px;

        background: rgba(255,255,255,0.82);

        border: 1px solid var(--card-border);

        box-shadow: var(--shadow);

        transition:
                transform 240ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 240ms ease,
                background 240ms ease;
    }

    .city-link-card:hover {
        transform: translateY(-4px);

        background: #ffffff;

        border-color: rgba(15,23,42,0.12);
    }

    .city-link-card strong {
        flex: 1;

        font-size: 18px;
        font-weight: 800;

        letter-spacing: -0.03em;
    }

    .city-link-dot {
        width: 10px;
        height: 10px;

        margin-right: 14px;

        border-radius: 999px;

        background: var(--orange);
    }

    .city-link-card svg {
        opacity: 0.5;
        transition: 220ms ease;
    }

    .city-link-card:hover svg {
        transform: translateX(4px);
        opacity: 1;
    }
</style>