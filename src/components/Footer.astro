---
import { cities } from "../data/cities";
import { serviceLinks, site } from "../data/site";
import { localizeCityPath, localizePath, ui, type Locale } from "../data/i18n";

const { lang = "de" } = Astro.props;
const currentLang = lang as Locale;
const footer = ui[currentLang];
const footerCities = cities.slice(0, 8);
const localized = (route: Parameters<typeof localizePath>[0]) => localizePath(route, currentLang);
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={localized("home")} class="footer-logo" aria-label="WAW Nutzfahrzeuge Startseite">
        <img src="/images/waw-logo.svg" alt="WAW Nutzfahrzeuge Logo" />
      </a>

      <p>
        {footer.footerText}
      </p>
    </div>

    <div>
      <h3>{footer.company}</h3>
      <a href={localized("about")}>{footer.about}</a>
      <a href={localized("process")}>{footer.process}</a>
      <a href={localized("vehicles")}>{footer.vehicles}</a>
      <a href={localized("locations")}>{footer.allLocations}</a>
    </div>

    <div>
      <h3>{footer.services}</h3>
      {serviceLinks.map((link) => (
        <a href={`${localized("services")}#${link.href.split("#")[1]}`}>{footer.serviceLinks[link.href.split("#")[1] as keyof typeof footer.serviceLinks] || link.label}</a>
      ))}
    </div>

    <div>
      <h3>{footer.regions}</h3>
      {footerCities.map((city) => (
        <a href={localizeCityPath(city.slug, currentLang)}>{footer.sellTrucksCity} {city.name}</a>
      ))}
      <a href={localized("locations")}>{footer.allLocations} →</a>
    </div>

    <div>
      <h3>{footer.contact}</h3>
      <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span>{site.address.locality}, {site.address.region}</span>
    </div>

    <div>
      <h3>{footer.legal}</h3>
      <a href={localized("legalNotice")}>{footer.legalNotice}</a>
      <a href={localized("privacy")}>{footer.privacy}</a>
      <a href={localized("terms")}>{footer.terms}</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} WAW Nutzfahrzeuge</span>
    <div>
      <a href={localized("legalNotice")}>{footer.legalNotice}</a>
      <a href={localized("privacy")}>{footer.privacy}</a>
      <a href={localized("terms")}>{footer.terms}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 40px;
    padding: 64px 0 28px;
    background:
      radial-gradient(circle at top right, rgba(255,107,0,0.18), transparent 24rem),
      linear-gradient(135deg, var(--navy-deep), var(--navy));
    color: white;
    border-top: 3px solid var(--orange);
  }

  .footer-grid {
    display: grid;
    grid-template-columns:
      minmax(260px, 1.35fr)
      minmax(140px, 0.85fr)
      minmax(150px, 1fr)
      minmax(190px, 1.08fr)
      minmax(150px, 0.95fr)
      minmax(130px, 0.8fr);
    gap: clamp(22px, 2.5vw, 34px);
  }

  .footer-brand p {
    max-width: 360px;
    color: rgba(255,255,255,0.62);
    line-height: 1.65;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    margin-bottom: 18px;
  }

  .footer-logo img {
    width: 210px;
    height: auto;
    display: block;
  }

  .footer h3 {
    margin: 0 0 16px;
    font-size: 16px;
  }

  .footer a,
  .footer span {
    display: block;
    margin-bottom: 12px;
    color: rgba(255,255,255,0.62);
    font-size: 14px;
    transition: 180ms ease;
  }

  .footer a:hover {
    color: white;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .footer-bottom div {
    display: flex;
    gap: 18px;
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .footer-grid,
    .footer-bottom {
      grid-template-columns: 1fr;
      flex-direction: column;
    }

    .footer-bottom div {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
