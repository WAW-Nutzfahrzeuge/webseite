---
import { ArrowRight } from "@lucide/astro";

const steps = [
  { title: "Anfrage senden", text: "Name und Telefonnummer genügen zum Start. Fahrzeugtyp und Standort helfen bei der ersten Einschätzung." },
  { title: "Angaben klären", text: "Wir besprechen Fahrzeugdaten, Zustand und offene Fragen. Fotos und Unterlagen können Sie nachreichen." },
  { title: "Angebot abstimmen", text: "Kommt ein Ankauf infrage, besprechen wir das Angebot und die weiteren Schritte mit Ihnen." },
  { title: "Verkauf abschließen", text: "Kaufvertrag, Zahlung, Übergabe und mögliche Abholung stimmen wir vor dem Verkauf gemeinsam ab." },
];
---

<section class="home-process" id="ablauf" aria-labelledby="process-title">
  <div class="container">
    <div class="process-head">
      <h2 id="process-title">Vom ersten Kontakt<br />bis zur Übergabe.</h2>
      <div>
        <p>So verkaufen Sie Ihr Nutzfahrzeug an WAW – mit direkter Abstimmung bei jedem Schritt.</p>
        <a href="/ablauf">Den Verkaufsablauf kennenlernen <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
    <ol class="steps-row">
      {steps.map((step, index) => (
        <li>
          <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .home-process { background: var(--navy-soft); color: #fff; padding: 72px 0; }
  .container { max-width: 1320px; }
  .process-head { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: end; margin-bottom: 48px; }
  h2 { margin: 0; font-size: clamp(32px, 3.6vw, 50px); line-height: 1.1; }
  .process-head p { max-width: 480px; margin: 0 0 16px; color: #d3deeb; font-size: 17px; line-height: 1.65; }
  a { display: inline-flex; align-items: center; gap: 12px; color: #f3944e; font-weight: 700; min-height: 44px; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .steps-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 30px; list-style: none; padding: 0; margin: 0; }
  li { border-top: 1px solid #52647a; padding-top: 22px; }
  .step-number { color: #f3944e; font-size: 30px; font-weight: 800; font-variant-numeric: tabular-nums; }
  h3 { margin: 20px 0 12px; font-size: 21px; line-height: 1.25; }
  li p { margin: 0; color: #d3deeb; font-size: 15px; line-height: 1.75; }
  @media (max-width: 1000px) { .steps-row { grid-template-columns: repeat(2, 1fr); gap: 32px; } }
  @media (max-width: 760px) {
    .home-process { padding: 48px 6px; }
    .process-head { grid-template-columns: 1fr; gap: 20px; margin-bottom: 30px; }
    .steps-row { grid-template-columns: 1fr; gap: 24px; }
    li { display: grid; grid-template-columns: 44px 1fr; column-gap: 16px; padding-top: 20px; }
    .step-number { grid-row: span 2; font-size: 26px; }
    h3 { margin: 0 0 8px; }
    li p { grid-column: 2; }
  }
</style>
