---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingContact from "./FloatingContact.astro";
import { site } from "../data/site";
import { getLocaleFromPath, localizePath, type Locale } from "../data/i18n";

interface Props { lang?: Locale }
const { lang = getLocaleFromPath(Astro.url.pathname) } = Astro.props;
const t = (de: string, en: string, fr: string) => ({ de, en, fr })[lang];
const canonical = new URL(localizePath("terms", lang), site.url).toString();
---

<BaseLayout
  title={t("AGB", "Terms and conditions", "Conditions générales") + " | WAW Nutzfahrzeuge"}
  description={t("Allgemeine Geschaeftsbedingungen von WAW Nutzfahrzeuge fuer Anfragen, Fahrzeugangebote und den Ankauf von LKW, Nutzfahrzeugen, Aufliegern und Baumaschinen.", "WAW Nutzfahrzeuge terms and conditions for inquiries, vehicle offers and the purchase of trucks, commercial vehicles, semi-trailers and construction machinery.", "Conditions générales de WAW Nutzfahrzeuge pour les demandes, les propositions de véhicules et le rachat de camions, véhicules utilitaires, semi-remorques et machines de chantier.")}
  canonical={canonical}
  lang={lang}
>
  <Header />

  <main class="legal-page">
    <section class="legal-hero">
      <div class="container legal-hero-inner">
        <span class="legal-kicker">{t("AGB", "TERMS", "CONDITIONS GÉNÉRALES")}</span>
        <h1>{t("Allgemeine Geschaeftsbedingungen", "General terms and conditions", "Conditions générales")}</h1>
        <p>
          {t("Bedingungen fuer die Nutzung der Website, unverbindliche Fahrzeuganfragen und die Anbahnung von Ankaufsprozessen mit WAW Nutzfahrzeuge.", "Conditions for using the website, making non-binding vehicle inquiries and initiating purchase processes with WAW Nutzfahrzeuge.", "Conditions d’utilisation du site, de demandes sans engagement concernant des véhicules et de préparation de rachats avec WAW Nutzfahrzeuge.")}
        </p>
      </div>
    </section>

    <section class="legal-content">
      <div class="container legal-grid">
        <aside class="legal-toc" aria-label={t("Inhaltsuebersicht", "Table of contents", "Table des matières")}>
          <strong>{t("Uebersicht", "Overview", "Sommaire")}</strong>
          <a href="#geltung">{t("Geltungsbereich", "Scope", "Champ d’application")}</a>
          <a href="#anfragen">{t("Anfragen", "Inquiries", "Demandes")}</a>
          <a href="#angaben">{t("Fahrzeugangaben", "Vehicle information", "Informations sur le véhicule")}</a>
          <a href="#angebot">{t("Angebot & Vertrag", "Offer & contract", "Offre et contrat")}</a>
          <a href="#abholung">{t("Abholung", "Collection", "Enlèvement")}</a>
          <a href="#zahlung">{t("Zahlung", "Payment", "Paiement")}</a>
          <a href="#haftung">{t("Haftung", "Liability", "Responsabilité")}</a>
          <a href="#schluss">{t("Schlussbestimmungen", "Final provisions", "Dispositions finales")}</a>
        </aside>

        <article class="legal-card">
          <section id="geltung">
            <h2>{t("1. Geltungsbereich", "1. Scope", "1. Champ d’application")}</h2>
            <p>
              {t("Anbieter dieser Website ist", "The provider of this website is", "L’éditeur de ce site est")} {site.legal.name}, {t("Inhaber", "owner", "propriétaire")}
              {site.legal.owner}, {site.address.street},
              {site.address.postalCode} {site.address.locality}, {t("Deutschland.", "Germany.", "Allemagne.")}
              {t("Diese Bedingungen beschreiben die Kontaktaufnahme und die Vorbereitung eines moeglichen Fahrzeugankaufs. Sie ersetzen keinen individuellen Kaufvertrag und gelten fuer einen solchen nur, soweit sie wirksam vereinbart wurden. Individuelle Vereinbarungen haben Vorrang.", "These conditions describe making contact and preparing a possible vehicle purchase. They do not replace an individual purchase contract and apply to such a contract only insofar as they have been validly agreed. Individual agreements take precedence.", "Les présentes conditions décrivent la prise de contact et la préparation d’un éventuel rachat de véhicule. Elles ne remplacent pas un contrat de vente individuel et ne s’appliquent à celui-ci que dans la mesure où elles ont été valablement convenues. Les accords individuels prévalent.")}
            </p>
            <p>
              {site.name} {t("betreibt keinen Fahrzeug-Onlineshop und keine Bewertungsplattform. Die Website dient der Kontaktaufnahme und der Vorbereitung eines moeglichen Ankaufs von LKW, Nutzfahrzeugen, Aufliegern, Anhaengern, Transportern, Baumaschinen und Fuhrparks.", "does not operate an online vehicle shop or a valuation platform. The website is intended for making contact and preparing a possible purchase of trucks, commercial vehicles, semi-trailers, trailers, vans, construction machinery and fleets.", "n’exploite ni boutique en ligne de véhicules ni plateforme d’évaluation. Le site sert à la prise de contact et à la préparation d’un éventuel rachat de camions, véhicules utilitaires, semi-remorques, remorques, fourgons, machines de chantier et flottes.")}
            </p>
          </section>

          <section id="anfragen">
            <h2>{t("2. Unverbindliche Anfrage ueber die Website", "2. Non-binding inquiry via the website", "2. Demande sans engagement via le site")}</h2>
            <p>
              {t("Das Kontaktformular dient einer unverbindlichen ersten Anfrage. Seine Absendung allein fuehrt nicht zum Abschluss eines Kaufvertrags. Auch die blosse Aufnahme eines Gespraechs per Telefon, WhatsApp oder E-Mail begruendet noch keinen Kaufvertrag. Verbindliche Erklaerungen im weiteren Austausch bleiben davon unberuehrt.", "The contact form is intended for an initial, non-binding inquiry. Submitting it alone does not conclude a purchase contract. Merely starting a conversation by telephone, WhatsApp or email does not establish a purchase contract either. Binding declarations made during subsequent exchanges remain unaffected.", "Le formulaire de contact sert à une première demande sans engagement. Son seul envoi ne conclut pas de contrat de vente. Le simple fait d’engager une conversation par téléphone, WhatsApp ou e-mail ne constitue pas non plus un contrat de vente. Les déclarations contraignantes faites lors des échanges ultérieurs ne sont pas affectées.")}
            </p>
            <p>
              {t("Eine automatische Eingangsbestätigung bestaetigt lediglich den Eingang der Anfrage. Sie stellt keine Zusage, kein verbindliches Kaufangebot und keine Annahme eines Angebots dar.", "An automatic acknowledgement of receipt only confirms that the inquiry has been received. It does not constitute a commitment, a binding purchase offer or acceptance of an offer.", "Un accusé de réception automatique confirme uniquement la réception de la demande. Il ne constitue ni un engagement, ni une offre d’achat ferme, ni l’acceptation d’une offre.")}
            </p>
          </section>

          <section id="angaben">
            <h2>{t("3. Angaben zum Fahrzeug", "3. Vehicle information", "3. Informations sur le véhicule")}</h2>
            <p>
              {t("Fuer den ersten Kontakt ueber das Formular genuegen Name und Telefonnummer. Weitere Angaben und Unterlagen koennen im anschliessenden Austausch ergaenzt werden. Bereits mitgeteilte Informationen sollen nach bestem Wissen richtig sein. Fuer die konkrete Pruefung und vor einem Vertragsschluss sind insbesondere Fahrzeugtyp, Zustand, bekannte Maengel und Unfallschaeden, fehlende Unterlagen sowie Finanzierungen und Rechte Dritter zu klaeren.", "A name and telephone number are sufficient for initial contact via the form. Further information and documents may be added during subsequent exchanges. Information already provided should be correct to the best of your knowledge. For a detailed assessment and before concluding a contract, the vehicle type, condition, known defects and accident damage, missing documents, financing and third-party rights must in particular be clarified.", "Le nom et le numéro de téléphone suffisent pour un premier contact via le formulaire. Des informations et documents supplémentaires peuvent être ajoutés lors des échanges suivants. Les informations déjà communiquées doivent être exactes au mieux de votre connaissance. Pour l’examen concret et avant la conclusion d’un contrat, il convient notamment de clarifier le type de véhicule, son état, les défauts et dommages d’accident connus, les documents manquants ainsi que les financements et les droits de tiers.")}
            </p>
            <p>
              {t("Fotos und Unterlagen sollen das angebotene Fahrzeug zutreffend wiedergeben; bekannte Abweichungen sind mitzuteilen. Auch beschaedigte, aeltere oder nicht fahrbereite Fahrzeuge koennen angefragt werden. Daraus folgt keine Verpflichtung von WAW, jedes angebotene Fahrzeug zu kaufen.", "Photos and documents should accurately represent the offered vehicle; known discrepancies must be disclosed. Inquiries may also be made for damaged, older or non-running vehicles. This does not oblige WAW to purchase every vehicle offered.", "Les photos et documents doivent représenter fidèlement le véhicule proposé ; les différences connues doivent être signalées. Les demandes peuvent également concerner des véhicules endommagés, anciens ou non roulants. Cela n’oblige pas WAW à acheter chaque véhicule proposé.")}
            </p>
          </section>

          <section id="angebot">
            <h2>{t("4. Angebote und Vertragsschluss", "4. Offers and conclusion of contract", "4. Offres et conclusion du contrat")}</h2>
            <p>
              {t("Ausdruecklich als unverbindlich bezeichnete Preisindikationen sind noch kein verbindliches Kaufangebot. Eine Besichtigung oder die Ergaenzung von Fahrzeugdaten kann zu einer anderen Einschaetzung fuehren. Bereits verbindlich vereinbarte Preise koennen dadurch nicht einseitig geaendert werden.", "Price indications expressly described as non-binding do not yet constitute a binding purchase offer. An inspection or additional vehicle information may lead to a different assessment. Prices already agreed on a binding basis cannot be changed unilaterally as a result.", "Les indications de prix expressément qualifiées de non contraignantes ne constituent pas encore une offre d’achat ferme. Une inspection ou des informations supplémentaires sur le véhicule peuvent conduire à une autre évaluation. Les prix déjà convenus de manière contraignante ne peuvent pas être modifiés unilatéralement pour ce motif.")}
            </p>
            <p>
              {t("Ein Kaufvertrag kommt nach den gesetzlichen Vorschriften durch uebereinstimmende verbindliche Erklaerungen der Parteien zustande. Diese Website legt dafuer keine zusaetzliche Schriftform fest. Fahrzeug, Kaufpreis und die weiteren Abwicklungsbedingungen werden im jeweiligen Geschaeft vereinbart.", "A purchase contract is concluded in accordance with statutory provisions through matching binding declarations by the parties. This website does not impose any additional written-form requirement. The vehicle, purchase price and further transaction terms are agreed for each transaction.", "Un contrat de vente est conclu conformément aux dispositions légales par des déclarations contraignantes concordantes des parties. Ce site n’impose aucune exigence supplémentaire de forme écrite. Le véhicule, le prix d’achat et les autres modalités d’exécution sont convenus pour chaque transaction.")}
            </p>
          </section>

          <section>
            <h2>{t("5. Eigentum, Verfuegungsberechtigung und Unterlagen", "5. Ownership, authority to dispose and documents", "5. Propriété, droit de disposition et documents")}</h2>
            <p>
              {t("Der Verkaeufer versichert, dass er zur Verfuegung ueber das angebotene Fahrzeug berechtigt ist und dass keine nicht offengelegten Rechte Dritter bestehen. Bestehen Finanzierungen, Leasingvertraege, Sicherungsuebereignungen oder sonstige Belastungen, sind diese vor Vertragsschluss vollstaendig offenzulegen.", "The seller confirms that they are authorised to dispose of the offered vehicle and that there are no undisclosed third-party rights. Any financing, leasing agreements, transfers of ownership by way of security or other encumbrances must be fully disclosed before conclusion of the contract.", "Le vendeur assure qu’il est autorisé à disposer du véhicule proposé et qu’il n’existe aucun droit de tiers non divulgué. Tout financement, contrat de crédit-bail ou de location, transfert de propriété à titre de garantie ou autre charge doit être intégralement divulgué avant la conclusion du contrat.")}
            </p>
            <p>
              {t("Bei Uebergabe sind, soweit vorhanden und vereinbart, Zulassungsbescheinigungen, Fahrzeugschluessel, Serviceunterlagen, Pruefberichte, Rechnungen, Vollmachten und sonstige relevante Dokumente zu uebergeben.", "At handover, registration certificates, vehicle keys, service records, inspection reports, invoices, powers of attorney and other relevant documents must be handed over insofar as available and agreed.", "Lors de la remise, les certificats d’immatriculation, clés du véhicule, documents d’entretien, rapports de contrôle, factures, procurations et autres documents pertinents doivent être remis, dans la mesure où ils sont disponibles et où cela a été convenu.")}
            </p>
          </section>

          <section id="abholung">
            <h2>{t("6. Besichtigung, Uebergabe und Abholung", "6. Inspection, handover and collection", "6. Inspection, remise et enlèvement")}</h2>
            <p>
              {t("Ort und Zeitpunkt einer Besichtigung, Uebergabe oder Abholung werden individuell abgestimmt. Eine Abholung ist je nach Fahrzeug, Standort, technischer Situation und Vereinbarung moeglich. Transportkosten, Gefahruebergang sowie eine etwaige Abmeldung oder Exportabwicklung richten sich nach der wirksamen Vereinbarung und den gesetzlichen Vorschriften. Eine generell kostenlose Abholung wird hiermit nicht zugesagt.", "The place and time of an inspection, handover or collection are arranged individually. Collection may be possible depending on the vehicle, location, technical situation and agreement. Transport costs, transfer of risk and any deregistration or export handling are governed by the valid agreement and statutory provisions. No general promise of free collection is made here.", "Le lieu et la date d’une inspection, d’une remise ou d’un enlèvement sont convenus individuellement. Un enlèvement est possible selon le véhicule, son emplacement, la situation technique et l’accord conclu. Les frais de transport, le transfert des risques et toute radiation de l’immatriculation ou formalité d’exportation sont régis par l’accord valablement conclu et les dispositions légales. Aucun engagement général d’enlèvement gratuit n’est pris ici.")}
            </p>
            <p>
              {t("Der Verkaeufer hat sicherzustellen, dass das Fahrzeug am vereinbarten Ort zugaenglich ist und die Uebergabe ohne vermeidbare Hindernisse erfolgen kann. Nicht fahrbereite Fahrzeuge oder besondere Lade- und Transportanforderungen sind vorab mitzuteilen.", "The seller must ensure that the vehicle is accessible at the agreed location and that handover can take place without avoidable obstacles. Non-running vehicles or special loading and transport requirements must be disclosed in advance.", "Le vendeur doit s’assurer que le véhicule est accessible au lieu convenu et que la remise peut se dérouler sans obstacles évitables. Tout véhicule non roulant ou toute exigence particulière de chargement et de transport doit être signalé à l’avance.")}
            </p>
          </section>

          <section id="zahlung">
            <h2>{t("7. Zahlung", "7. Payment", "7. Paiement")}</h2>
            <p>
              {t("Kaufpreis, Zahlungsart und Zahlungszeitpunkt werden im jeweiligen Kaufvertrag vereinbart. Dabei sind auch eine etwaige Umsatzsteuer und bestehende Finanzierungen zu klaeren.", "The purchase price, payment method and payment date are agreed in the respective purchase contract. Any applicable VAT and existing financing must also be clarified.", "Le prix d’achat, le mode et la date de paiement sont convenus dans le contrat de vente concerné. La TVA éventuelle et les financements existants doivent également être clarifiés.")}
            </p>
            <p>
              {t("Soweit keine wirksame abweichende Vereinbarung besteht, gelten die gesetzlichen Regelungen. Diese Website legt weder eine bestimmte Zahlungsart noch eine Vorleistungspflicht fest.", "Unless a valid agreement provides otherwise, statutory rules apply. This website does not prescribe a particular payment method or an obligation to perform in advance.", "À défaut d’accord dérogatoire valable, les dispositions légales s’appliquent. Ce site n’impose ni mode de paiement particulier ni obligation d’exécution préalable.")}
            </p>
          </section>

          <section>
            <h2>{t("8. Gewaehrleistung und bekannte Maengel", "8. Statutory warranty and known defects", "8. Garantie légale et défauts connus")}</h2>
            <p>
              {t("Der Verkaeufer ist verpflichtet, bekannte Maengel, Schaeden, Unfallschaeden, Manipulationen, fehlende Teile, ungewoehnliche technische Probleme oder sonstige wertrelevante Umstaende vor Vertragsschluss vollstaendig offenzulegen.", "The seller is obliged to fully disclose known defects, damage, accident damage, tampering, missing parts, unusual technical problems or other circumstances affecting value before conclusion of the contract.", "Le vendeur est tenu de divulguer intégralement, avant la conclusion du contrat, les défauts, dommages, dommages d’accident, manipulations, pièces manquantes, problèmes techniques inhabituels ou autres circonstances connues influant sur la valeur.")}
            </p>
            <p>
              {t("Fuer Sachmaengel gelten die gesetzlichen Vorschriften und die wirksamen Vereinbarungen im jeweiligen Kaufvertrag. Diese Bedingungen enthalten keinen pauschalen Ausschluss von Maengelrechten.", "Material defects are governed by statutory provisions and the valid agreements in the respective purchase contract. These conditions do not contain a blanket exclusion of rights in respect of defects.", "Les défauts matériels sont régis par les dispositions légales et les accords valables du contrat de vente concerné. Les présentes conditions ne comportent aucune exclusion générale des droits liés aux défauts.")}
            </p>
          </section>

          <section id="haftung">
            <h2>{t("9. Haftung", "9. Liability", "9. Responsabilité")}</h2>
            <p>
              {t("WAW haftet unbeschraenkt fuer Schaeden aus der Verletzung des Lebens, des Koerpers oder der Gesundheit sowie fuer Schaeden, die auf Vorsatz oder grober Fahrlaessigkeit beruhen. Im Uebrigen richtet sich die Haftung nach den gesetzlichen Vorschriften.", "WAW has unlimited liability for damage resulting from injury to life, body or health and for damage caused by intent or gross negligence. In all other respects, liability is governed by statutory provisions.", "La responsabilité de WAW est illimitée pour les dommages résultant d’une atteinte à la vie, à l’intégrité physique ou à la santé, ainsi que pour les dommages causés intentionnellement ou par négligence grave. Pour le reste, la responsabilité est régie par les dispositions légales.")}
            </p>
            <p>
              {t("Technische Stoerungen der Website oder externer Dienste sind moeglich. Gesetzliche Haftungsansprueche werden durch diesen Hinweis nicht ausgeschlossen. Bei Problemen mit dem Formular koennen Sie uns auch telefonisch oder per E-Mail kontaktieren.", "Technical disruptions to the website or external services are possible. This notice does not exclude statutory liability claims. If you have problems with the form, you may also contact us by telephone or email.", "Des dysfonctionnements techniques du site ou des services externes sont possibles. Le présent avis n’exclut aucun recours légal en responsabilité. En cas de problème avec le formulaire, vous pouvez également nous contacter par téléphone ou e-mail.")}
            </p>
          </section>

          <section>
            <h2>{t("10. Nutzung der Website", "10. Use of the website", "10. Utilisation du site")}</h2>
            <p>
              {t("Die Inhalte dieser Website dienen der allgemeinen Information und Kontaktaufnahme. Sie stellen kein verbindliches Angebot zum Kauf oder Verkauf eines bestimmten Fahrzeugs dar.", "The content of this website is intended for general information and making contact. It does not constitute a binding offer to buy or sell a particular vehicle.", "Les contenus de ce site servent à l’information générale et à la prise de contact. Ils ne constituent pas une offre ferme d’achat ou de vente d’un véhicule déterminé.")}
            </p>
          </section>

          <section id="schluss">
            <h2>{t("11. Schlussbestimmungen", "11. Final provisions", "11. Dispositions finales")}</h2>
            <p>
              {t("Das anwendbare Recht und der Gerichtsstand richten sich nach den gesetzlichen Vorschriften und etwaigen wirksamen Vereinbarungen im jeweiligen Vertrag. Diese Website trifft keine gesonderte Rechtswahl fuer internationale Fahrzeugkaufvertraege.", "The applicable law and jurisdiction are governed by statutory provisions and any valid agreements in the respective contract. This website makes no separate choice of law for international vehicle purchase contracts.", "Le droit applicable et la juridiction compétente sont déterminés par les dispositions légales et les éventuels accords valables du contrat concerné. Ce site ne procède à aucun choix de loi distinct pour les contrats internationaux de vente de véhicules.")}
            </p>
            <p>
              {t("Sollten einzelne Bestimmungen dieser AGB ganz oder teilweise unwirksam sein oder werden, bleibt die Wirksamkeit der uebrigen Bestimmungen unberuehrt.", "If individual provisions of these terms and conditions are or become wholly or partly invalid, the validity of the remaining provisions remains unaffected.", "Si certaines dispositions des présentes conditions générales sont ou deviennent totalement ou partiellement invalides, la validité des autres dispositions n’en est pas affectée.")}
            </p>
            <p>
              {t("Stand: 30. Oktober 2026", "Last updated: 30 October 2026", "Mise à jour : 30 octobre 2026")}
            </p>
          </section>

        </article>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingContact />
</BaseLayout>

<style>
  .legal-page {
    padding-top: 0;
    background: #f6f8fb;
  }

  .legal-hero {
    padding: 86px 0 56px;
    background:
      radial-gradient(circle at 82% 12%, rgba(255, 107, 0, 0.18), transparent 24rem),
      linear-gradient(135deg, #07111f, #0c223d);
    color: #fff;
  }

  .legal-hero-inner {
    max-width: 980px;
  }

  .legal-kicker {
    color: var(--orange);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 16px 0 18px;
    max-width: 960px;
    font-size: clamp(46px, 7vw, 84px);
    line-height: 0.96;
    letter-spacing: -0.055em;
  }

  .legal-hero p {
    max-width: 760px;
    color: rgba(255, 255, 255, 0.76);
    font-size: 19px;
    line-height: 1.7;
  }

  .legal-content {
    padding: 58px 0 86px;
  }

  .legal-grid {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }

  .legal-toc,
  .legal-card {
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 24px 70px rgba(17, 24, 39, 0.08);
  }

  .legal-toc {
    position: sticky;
    top: 110px;
    padding: 22px;
  }

  .legal-toc strong,
  .legal-toc a {
    display: block;
  }

  .legal-toc strong {
    margin-bottom: 14px;
    color: #111827;
  }

  .legal-toc a {
    padding: 10px 0;
    color: var(--muted);
    font-size: 14px;
    border-top: 1px solid rgba(17, 24, 39, 0.06);
  }

  .legal-toc a:hover {
    color: var(--orange);
  }

  .legal-card {
    padding: clamp(28px, 4vw, 54px);
  }

  .legal-card section + section {
    margin-top: 34px;
    padding-top: 30px;
    border-top: 1px solid rgba(17, 24, 39, 0.08);
  }

  h2 {
    margin: 0 0 14px;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  p,
  li {
    color: var(--muted);
    line-height: 1.75;
  }

  a {
    font-weight: 750;
    color: #111827;
  }

  .legal-note {
    margin-top: 38px;
    padding: 18px 20px;
    border-radius: 18px;
    background: rgba(255, 107, 0, 0.1);
    color: #7a3600;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .legal-grid {
      grid-template-columns: 1fr;
    }

    .legal-toc {
      position: static;
    }
  }

  @media (max-width: 620px) {
    .legal-page {
      padding-top: 0;
    }

    .legal-hero {
      padding: 58px 0 42px;
    }
  }
</style>
