---
import { PhoneCall } from "@lucide/astro";
import { site } from "../data/site";
---

<section class="services-final-cta">
  <div class="container services-final-panel" data-animate>
    <div>
      <span>FAHRZEUG ANBIETEN</span>
      <h2>Nutzfahrzeug oder Fuhrpark verkaufen?</h2>
      <p>
        Senden Sie Fahrzeugtyp, Marke, Baujahr, Kilometerstand, Zustand,
        Standort und Fotos. Fehlen einzelne Daten, klären wir diese gemeinsam.
      </p>
    </div>

    <div class="services-final-actions">
      <a href="/kontakt" class="btn btn-primary">Jetzt Fahrzeug anbieten</a>
      <a href={`tel:${site.phoneHref}`} class="services-call-btn">
        <PhoneCall size={18} stroke-width={2.4} aria-hidden="true" />
        Direkt anrufen
      </a>
    </div>
  </div>
</section>

<style>
  .services-final-cta {
    padding: 28px 0 90px;
    background: #fff;
  }

  .services-final-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(30px, 4vw, 50px);
    border-radius: 32px;
    color: #fff;
    background:
      radial-gradient(circle at 86% 18%, rgba(255,107,0,0.24), transparent 20rem),
      linear-gradient(135deg, #06101f, #071a33);
    box-shadow: 0 24px 78px rgba(15,23,42,0.18);
  }

  .services-final-panel span {
    color: #ffb06b;
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.11em;
  }

  .services-final-panel h2 {
    max-width: 740px;
    margin: 12px 0 0;
    color: #fff;
    font-size: clamp(34px, 4.8vw, 62px);
    line-height: 1;
    letter-spacing: -0.065em;
  }

  .services-final-panel p {
    max-width: 650px;
    margin: 16px 0 0;
    color: rgba(239,244,250,0.72);
    font-size: 17px;
    line-height: 1.7;
  }

  .services-final-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 12px;
    flex: 0 0 auto;
  }

  .services-call-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 52px;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 999px;
    background: rgba(255,255,255,0.1);
    color: #fff;
    font-weight: 900;
    padding: 14px 22px;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease;
  }

  .services-call-btn:hover {
    transform: translateY(-3px);
    background: rgba(255,255,255,0.16);
  }

  @media (max-width: 900px) {
    .services-final-panel {
      flex-direction: column;
      align-items: flex-start;
    }

    .services-final-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 680px) {
    .services-final-cta {
      padding-bottom: 72px;
    }

    .services-final-panel {
      border-radius: 24px;
    }

    .services-final-actions,
    .services-final-actions .btn,
    .services-call-btn {
      width: 100%;
    }
  }
</style>
