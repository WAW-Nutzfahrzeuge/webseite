---
const reviews = [
    {
        name: "Klaus Becker",
        role: "Spediteur, Hamburg",
        text: "Schnelle und unkomplizierte Abwicklung. WAW hat uns für unseren alten MAN TGX einen fairen Preis geboten und das Fahrzeug direkt abgeholt. Absolut empfehlenswert.",
        stars: 5,
    },
    {
        name: "Thomas Richter",
        role: "Bauunternehmer, Hannover",
        text: "Haben unseren kompletten Fuhrpark über WAW verkauft. Professionelle Abwicklung, faire Preise und alles ohne großen bürokratischen Aufwand. Top!",
        stars: 5,
    },
    {
        name: "Markus Schröder",
        role: "Inhaber Transportunternehmen",
        text: "Endlich ein Ankäufer, der auch ältere LKW mit hoher Laufleistung nimmt. Das Angebot kam schnell, die Zahlung war pünktlich – so muss das sein.",
        stars: 5,
    },
    {
        name: "Sandra Meyer",
        role: "Logistik GmbH, Berlin",
        text: "Sehr kompetenter Ansprechpartner, klare Kommunikation und ein faires Angebot. Würde jederzeit wieder über WAW Fahrzeuge verkaufen.",
        stars: 5,
    },
    {
        name: "Andreas Hoffmann",
        role: "Bauunternehmer, Bremen",
        text: "WAW hat unseren Auflieger innerhalb von einem Tag begutachtet und direkt mitgenommen. Kein langes Hin und Her, einfach reibungslos.",
        stars: 5,
    },
    {
        name: "Petra Lange",
        role: "Fuhrparkmanagerin, Lübeck",
        text: "Einfach unkompliziert. Fotos geschickt, Angebot erhalten, Fahrzeug übergeben. Genau so soll das laufen. Klare Weiterempfehlung.",
        stars: 5,
    },
];
---

<section class="reviews-section section" aria-labelledby="reviews-heading">
    <div class="container">
        <div class="reviews-header" data-animate>
            <span class="badge badge--light">Kundenstimmen</span>
            <h2 id="reviews-heading">Was unsere Kunden sagen.</h2>
            <p class="reviews-sub">Hunderte zufriedene Verkäufer – deutschland- und europaweit.</p>
        </div>

        <div class="reviews-track" id="reviews-track">
            {reviews.map((review, i) => (
                <article class="review-card" data-animate data-review={i}>
                    <div class="review-inner">
                        <div class="review-stars" aria-label={`${review.stars} von 5 Sternen`}>
                            {Array.from({ length: review.stars }).map(() => (
                                <svg viewBox="0 0 20 20" aria-hidden="true">
                                    <path d="M10 1l2.39 4.84 5.34.78-3.86 3.76.91 5.32L10 13.27 5.22 15.7l.91-5.32-3.86-3.76 5.34-.78z" />
                                </svg>
                            ))}
                        </div>

                        <blockquote class="review-text">
                            <p>„{review.text}"</p>
                        </blockquote>

                        <footer class="review-author">
                            <div class="review-avatar" aria-hidden="true">
                                {review.name.charAt(0)}
                            </div>
                            <div class="review-meta">
                                <strong>{review.name}</strong>
                                <span>{review.role}</span>
                            </div>
                        </footer>
                    </div>
                </article>
            ))}
        </div>

        <!-- Mobile carousel dots -->
        <div class="reviews-dots" id="reviews-dots" aria-hidden="true">
            {reviews.map((_, i) => (
                <button class={`dot${i === 0 ? ' dot--active' : ''}`} data-index={i} aria-label={`Rezension ${i + 1}`} />
            ))}
        </div>
    </div>
</section>

<script>
(function () {
    /* ── BorderGlow: track cursor angle + edge proximity ── */
    function getEdgeProximity(el: HTMLElement, x: number, y: number): number {
        const cx = el.offsetWidth / 2;
        const cy = el.offsetHeight / 2;
        const dx = x - cx;
        const dy = y - cy;
        if (dx === 0 && dy === 0) return 0;
        const kx = dx !== 0 ? cx / Math.abs(dx) : Infinity;
        const ky = dy !== 0 ? cy / Math.abs(dy) : Infinity;
        return Math.min(Math.max(1 / Math.min(kx, ky), 0), 1);
    }

    function getCursorAngle(el: HTMLElement, x: number, y: number): number {
        const cx = el.offsetWidth / 2;
        const cy = el.offsetHeight / 2;
        const dx = x - cx;
        const dy = y - cy;
        if (dx === 0 && dy === 0) return 0;
        let deg = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
        return deg < 0 ? deg + 360 : deg;
    }

    document.querySelectorAll<HTMLElement>('.review-card').forEach((card) => {
        card.addEventListener('pointermove', (e: PointerEvent) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const proximity = getEdgeProximity(card, x, y);
            const angle = getCursorAngle(card, x, y);
            // alpha: 0 at center, ramps up when within the outer ~65% of the card
            const alpha = Math.max(0, (proximity - 0.35) / 0.65).toFixed(3);
            card.style.setProperty('--cursor-angle', `${angle.toFixed(1)}deg`);
            card.style.setProperty('--glow-alpha', alpha);
        });
        card.addEventListener('pointerleave', () => {
            card.style.setProperty('--glow-alpha', '0');
        });
    });

    /* ── Mobile carousel dots ── */
    const track = document.getElementById('reviews-track');
    const dots = document.querySelectorAll<HTMLElement>('.dot');

    if (track && dots.length) {
        const cards = Array.from(track.querySelectorAll<HTMLElement>('.review-card'));

        function activateDot(index: number) {
            dots.forEach((dot, i) => dot.classList.toggle('dot--active', i === index));
        }

        // Use scroll event + find which card is most centred in the track
        track.addEventListener('scroll', () => {
            const trackRect = track.getBoundingClientRect();
            const trackCenter = trackRect.left + trackRect.width / 2;
            let closest = 0;
            let minDist = Infinity;
            cards.forEach((card, i) => {
                const cardRect = card.getBoundingClientRect();
                const cardCenter = cardRect.left + cardRect.width / 2;
                const dist = Math.abs(cardCenter - trackCenter);
                if (dist < minDist) { minDist = dist; closest = i; }
            });
            activateDot(closest);
        }, { passive: true });

        // Dot click → scroll card into view
        dots.forEach((dot, i) => {
            dot.addEventListener('click', () => {
                cards[i]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
            });
        });
    }
})();
</script>

<style>
    /* ===== Section ===== */
    .reviews-section {
        background: linear-gradient(160deg, #f26100 0%, #b83c00 100%);
        position: relative;
    }

    .reviews-section::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse 60% 50% at 20% 30%, rgba(255,255,255,0.08) 0%, transparent 70%),
            radial-gradient(ellipse 50% 60% at 80% 70%, rgba(255,255,255,0.04) 0%, transparent 70%);
        pointer-events: none;
    }

    /* ===== Header ===== */
    .reviews-header {
        text-align: center;
        margin-bottom: 56px;
    }

    .reviews-header h2 {
        color: #fff;
        margin: 16px 0 12px;
        font-size: clamp(36px, 5vw, 64px);
        line-height: 0.98;
        letter-spacing: -0.068em;
    }

    .reviews-sub {
        color: rgba(255,255,255,0.65);
        font-size: 16px;
        margin: 0;
    }

    .badge--light {
        background: rgba(255,255,255,0.18);
        color: rgba(255,255,255,0.9);
        border: 1px solid rgba(255,255,255,0.22);
    }

    /* ===== Desktop grid ===== */
    .reviews-track {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .reviews-dots { display: none; }

    /* ===== Card ===== */
    .review-card {
        --cursor-angle: 0deg;
        --glow-alpha: 0;
        --border-radius: 24px;

        position: relative;
        border-radius: var(--border-radius);
        background: rgba(255,255,255,0.12);
        backdrop-filter: blur(12px);
        box-shadow:
            inset 0 0 0 1px rgba(255,255,255,0.20),
            0 0 0 0 rgba(255,255,255,0);
        transition:
            box-shadow 350ms cubic-bezier(0.16,1,0.3,1),
            transform  350ms cubic-bezier(0.16,1,0.3,1),
            background 350ms ease;
    }

    .review-card:hover {
        transform: translateY(-4px);
        background: rgba(255,255,255,0.18);
        box-shadow:
            inset 0 0 0 1px rgba(255,255,255,0.28),
            0 12px 40px rgba(0,0,0,0.18),
            0 0 48px rgba(255,255,255,0.08);
    }

    .review-card::before {
        content: "";
        position: absolute;
        inset: -1px;
        border-radius: calc(var(--border-radius) + 1px);
        padding: 1px;
        background: conic-gradient(
            from var(--cursor-angle) at 50% 50%,
            rgba(255,255,255, var(--glow-alpha)) 0%,
            rgba(255,220,180, var(--glow-alpha)) 7%,
            rgba(255,255,255, var(--glow-alpha)) 14%,
            transparent 26%,
            transparent 74%,
            rgba(255,255,255, var(--glow-alpha)) 86%,
            rgba(255,220,180, var(--glow-alpha)) 93%,
            rgba(255,255,255, var(--glow-alpha)) 100%
        );
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
        z-index: 2;
    }

    /* Content sits above ::before ring */
    .review-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding: 28px;
        border-radius: inherit;
        overflow: hidden;
    }

    /* ===== Card content ===== */
    .review-stars {
        display: flex;
        gap: 3px;
    }

    .review-stars svg {
        width: 17px;
        height: 17px;
        fill: #f5b731;
        flex-shrink: 0;
    }

    .review-text {
        margin: 0;
        flex: 1;
    }

    .review-text p {
        margin: 0;
        font-size: 15px;
        line-height: 1.65;
        color: rgba(255,255,255,0.88);
        font-style: italic;
    }

    .review-author {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-top: 18px;
        border-top: 1px solid rgba(255,255,255,0.22);
    }

    .review-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,0.20);
        border: 1px solid rgba(255,255,255,0.30);
        display: grid;
        place-items: center;
        font-size: 16px;
        font-weight: 800;
        color: #fff;
        flex-shrink: 0;
        letter-spacing: 0;
    }

    .review-meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .review-meta strong {
        font-size: 14px;
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.02em;
    }

    .review-meta span {
        font-size: 12.5px;
        color: rgba(255,255,255,0.65);
    }

    /* ===== Tablet ===== */
    @media (max-width: 960px) {
        .reviews-track { grid-template-columns: repeat(2, 1fr); }
    }

    /* ===== Mobile carousel ===== */
    @media (max-width: 600px) {
        .reviews-track {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            gap: 12px;
            /* slight inset so the next card peeks */
            padding-inline: 2px;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .reviews-track::-webkit-scrollbar { display: none; }

        /* Force cards visible — skip data-animate fade-in inside carousel */
        .review-card {
            flex: 0 0 calc(100% - 28px);
            scroll-snap-align: start;
            opacity: 1 !important;
            transform: none !important;
        }

        .review-inner { padding: 22px 20px; }

        /* Dots */
        .reviews-dots {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-top: 22px;
        }

        .dot {
            width: 7px;
            height: 7px;
            border-radius: 999px;
            border: none;
            background: rgba(255,255,255,0.22);
            cursor: pointer;
            padding: 0;
            transition: width 300ms cubic-bezier(0.16,1,0.3,1), background 300ms ease;
        }

        .dot--active {
            width: 22px;
            background: rgba(255,255,255,0.80);
        }

        .reviews-header { margin-bottom: 32px; }
    }
</style>
