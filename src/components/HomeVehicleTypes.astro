---
const vehicles = [
  {
    label: "LKW",
    href: "/fahrzeuge#lkw",
    iconSrc: "/icons/lkw.png",
  },
  {
    label: "Sattelzugmaschinen",
    href: "/fahrzeuge#sattelzugmaschinen",
    iconSrc: "/icons/sattelzugmaschine.png",
  },
  {
    label: "Auflieger",
    href: "/fahrzeuge#auflieger",
    iconSrc: "/icons/auflieger.png",
  },
  {
    label: "Anhänger",
    href: "/fahrzeuge#anhaenger",
    iconSrc: "/icons/anhaenger.png",
  },
  {
    label: "Transporter",
    href: "/fahrzeuge#transporter",
    iconSrc: "/icons/transporter.png",
  },
  {
    label: "Baumaschinen",
    href: "/fahrzeuge#baumaschinen",
    iconSrc: "/icons/bagger.png",
  },
  {
    label: "Fuhrparks",
    href: "/fahrzeuge#fuhrparks",
    iconSrc: "/icons/fuhrpark.png",
  },
];
---

<section class="vehicle-types" id="fahrzeugarten">
  <div class="container">
    <div class="section-head" data-animate>
      <span>WIR KAUFEN AN</span>
      <h2>Diese Nutzfahrzeuge kaufen wir an</h2>
    </div>

    <div class="vehicle-grid">
      {vehicles.map((vehicle) => (
        <a href={vehicle.href} class="vehicle-type-card" data-animate>
          <div class="vehicle-icon">
            <img src={vehicle.iconSrc} alt="" loading="lazy" aria-hidden="true" />
          </div>
          <strong>{vehicle.label}</strong>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .vehicle-types {
    padding: 56px 0 64px;
    background: #fff;
  }

  .section-head {
    text-align: center;
    margin-bottom: 34px;
  }

  .section-head span {
    display: inline-block;
    margin-bottom: 10px;
    color: var(--orange);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .section-head h2 {
    position: relative;
    margin: 0;
    color: #111827;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .section-head h2::after {
    content: "";
    display: block;
    width: 38px;
    height: 3px;
    margin: 18px auto 0;
    border-radius: 999px;
    background: var(--orange);
  }

  .vehicle-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 12px;
  }

  .vehicle-type-card {
    min-height: 142px;
    display: grid;
    place-items: center;
    gap: 12px;
    padding: 22px 12px 18px;
    border-radius: 7px;
    background: #fff;
    border: 1px solid rgba(17,24,39,0.08);
    box-shadow:
      0 4px 14px rgba(15,23,42,0.05),
      0 16px 34px rgba(15,23,42,0.06);
    color: #0f172a;
    text-align: center;
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;
  }

  .vehicle-type-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255,107,0,0.28);
    box-shadow:
      0 8px 22px rgba(15,23,42,0.08),
      0 26px 52px rgba(15,23,42,0.1);
  }

  .vehicle-icon {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    color: #0a0f18;
  }

  .vehicle-icon img {
    width: 58px;
    height: 58px;
    display: block;
    object-fit: contain;
  }

  .vehicle-type-card strong {
    min-height: 18px;
    display: block;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  @media (max-width: 1100px) {
    .vehicle-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .vehicle-types {
      padding: 46px 0 52px;
    }

    .vehicle-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .vehicle-type-card {
      min-height: 132px;
    }
  }
</style>
