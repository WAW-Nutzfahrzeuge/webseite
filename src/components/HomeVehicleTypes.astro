---
import { ArrowUpRight, ArrowRight } from "@lucide/astro";

const vehicles = [
  { label: "LKW", href: "/leistungen#lkw" },
  { label: "Sattelzugmaschinen", href: "/leistungen#sattelzugmaschinen" },
  { label: "Auflieger", href: "/leistungen#auflieger" },
  { label: "Anhänger", href: "/leistungen#anhaenger" },
  { label: "Transporter", href: "/leistungen#transporter" },
  { label: "Baumaschinen", href: "/leistungen#baumaschinen" },
  { label: "Betonmischer & Spezialfahrzeuge", href: "/leistungen#baumaschinen" },
  { label: "Fuhrparks", href: "/leistungen#fuhrpark" },
];
---

<section class="vehicle-types" id="fahrzeugarten" aria-labelledby="vehicles-title">
  <div class="container vehicle-layout">
    <figure>
      <img src="/images/fahrzeug_fuhrpark.webp" alt="Verschiedene gewerbliche Fahrzeugtypen vor einer Halle" width="1536" height="1024" loading="lazy" />
      <figcaption>Beispiele für Fahrzeugarten, die Sie uns anbieten können – keine Verkaufsangebote.</figcaption>
    </figure>
    <div class="vehicle-copy">
      <h2 id="vehicles-title">Vom Transporter<br />bis zum Fuhrpark.</h2>
      <p>Sie möchten ein gewerbliches Fahrzeug verkaufen? Wir kaufen unterschiedliche Fahrzeugarten an – einzeln, als Paket oder als kompletter Fuhrpark.</p>
      <ul>
        {vehicles.map((vehicle) => (
          <li><a href={vehicle.href}>{vehicle.label}<ArrowUpRight size={17} aria-hidden="true" /></a></li>
        ))}
      </ul>
      <a href="/fahrzeuge" class="text-link">Alle Fahrzeugarten ansehen <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  .vehicle-types { padding: 88px 0; background: #fff; }
  .container { max-width: 1320px; }
  .vehicle-layout { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(36px, 6vw, 88px); align-items: center; }
  figure { margin: 0; }
  img { display: block; width: 100%; height: auto; aspect-ratio: 1.08; object-fit: cover; object-position: 48% center; border-radius: var(--radius-image); }
  figcaption { padding-top: 12px; color: var(--muted); font-size: 12px; line-height: 1.5; }
  h2 { margin: 0 0 22px; font-size: clamp(32px, 3.4vw, 48px); line-height: 1.1; color: var(--navy-deep); }
  p { color: #435063; font-size: 17px; line-height: 1.75; margin: 0 0 22px; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; padding: 0; margin: 0 0 26px; list-style: none; }
  li { border-bottom: 1px solid #dce2e8; }
  li a { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 100%; min-height: 54px; padding: 12px 0; font-size: 15px; font-weight: 700; line-height: 1.4; }
  li :global(svg) { flex-shrink: 0; color: #b94d00; }
  li a:hover, .text-link:hover { color: #a94300; }
  .text-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; font-weight: 750; text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 900px) { .vehicle-layout { gap: 32px; } ul { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .vehicle-types { padding: 48px 6px; }
    .vehicle-layout { grid-template-columns: 1fr; }
    img { aspect-ratio: 1.5; }
    ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 18px; }
    li a { font-size: 14px; }
  }
</style>
