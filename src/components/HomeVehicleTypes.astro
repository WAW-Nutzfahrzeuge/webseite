---
import { ArrowUpRight, ArrowRight } from "@lucide/astro";
import { getLocaleFromPath, localizePath } from "../data/i18n";
import { homeCopy } from "../data/home";
const lang = getLocaleFromPath(Astro.url.pathname);
const c = homeCopy[lang];

const vehicles = [
  { label: "LKW", href: "/leistungen#lkw", iconSrc: "/icons/lkw.png" },
  { label: "Sattelzugmaschinen", href: "/leistungen#sattelzugmaschinen", iconSrc: "/icons/sattelzugmaschine.png" },
  { label: "Auflieger", href: "/leistungen#auflieger", iconSrc: "/icons/auflieger.png" },
  { label: "Anhänger", href: "/leistungen#anhaenger", iconSrc: "/icons/anhaenger.png" },
  { label: "Transporter", href: "/leistungen#transporter", iconSrc: "/icons/transporter.png" },
  { label: "Baumaschinen", href: "/leistungen#baumaschinen", iconSrc: "/icons/bagger.png" },
  { label: "Betonmischer & Spezialfahrzeuge", href: "/leistungen#baumaschinen", iconSrc: "/icons/lkw.png" },
  { label: "Fuhrparks", href: "/leistungen#fuhrpark", iconSrc: "/icons/fuhrpark.png" },
];
---

<section class="vehicle-types" id="fahrzeugarten" aria-labelledby="vehicles-title">
  <div class="container vehicle-layout">
    <figure>
      <slot name="vehicle-image">
        <img src="/images/fahrzeug_fuhrpark.webp" alt={c.vehicleAlt} width="1536" height="1024" loading="lazy" />
      </slot>
      <figcaption>{c.vehicleCaption}</figcaption>
    </figure>
    <div class="vehicle-copy">
      <h2 id="vehicles-title">{c.vehicleTitle[0]}<br />{c.vehicleTitle[1]}</h2>
      <p>{c.vehicleText}</p>
      <ul>
        {vehicles.map((vehicle, index) => (
          <li>
            <a href={`${localizePath("services", lang)}#${vehicle.href.split("#")[1]}`}>
              <img class="vehicle-icon" src={vehicle.iconSrc} alt="" width="28" height="28" loading="lazy" />
              <span>{c.vehicleNames[index]}</span>
              <ArrowUpRight size={17} aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
      <a href={localizePath("vehicles", lang)} class="text-link">{c.vehicleLink} <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  .vehicle-types { padding: 88px 0; background: #fff; }
  .container { max-width: 1320px; }
  .vehicle-layout { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(36px, 6vw, 88px); align-items: center; }
  figure { margin: 0; }
  figure :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1.08; object-fit: cover; object-position: 48% center; border-radius: var(--radius-image); }
  figcaption { padding-top: 12px; color: var(--muted); font-size: 12px; line-height: 1.5; }
  h2 { margin: 0 0 22px; font-size: clamp(32px, 3.4vw, 48px); line-height: 1.1; color: var(--navy-deep); }
  p { color: #435063; font-size: 17px; line-height: 1.75; margin: 0 0 22px; }
  ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; padding: 0; margin: 0 0 26px; list-style: none; }
  li { border-bottom: 1px solid #dce2e8; }
  li a { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 100%; min-height: 54px; padding: 12px 0; font-size: 13px; font-weight: 700; line-height: 1.4; }
  li .vehicle-icon { width: 28px; height: 28px; flex-shrink: 0; aspect-ratio: auto; object-fit: contain; border-radius: 0; }
  li span { flex: 1; min-width: 0; overflow-wrap: anywhere; hyphens: auto; }
  li :global(svg) { flex-shrink: 0; color: #b94d00; }
  li a:hover, .text-link:hover { color: #a94300; }
  .text-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; font-weight: 750; text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 900px) { .vehicle-layout { gap: 32px; } ul { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .vehicle-types { padding: 48px 6px; }
    .vehicle-layout { grid-template-columns: 1fr; }
    figure :global(img) { aspect-ratio: 1.5; }
    ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 18px; }
    li a { font-size: 12px; }
  }
</style>
