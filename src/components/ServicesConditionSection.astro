---
import { AlertTriangle, CircleCheck, Gauge, Wrench } from "@lucide/astro";

const conditions = [
  "hohe Laufleistung",
  "ohne TÜV oder HU",
  "Motorschaden",
  "Getriebeschaden",
  "Unfallschaden",
  "ältere Baujahre",
  "optische Mängel",
  "nicht fahrbereite Fahrzeuge",
];
---

<section class="services-condition">
  <div class="container condition-grid">
    <div class="condition-copy" data-animate>
      <span>AUCH BEI MÄNGELN</span>
      <h2>Nicht nur perfekte Fahrzeuge kommen infrage.</h2>
      <p>
        Auch ältere Nutzfahrzeuge, hohe Laufleistungen oder technische Schäden
        können Sie uns direkt anbieten. Wichtig sind Fahrzeugdaten, Standort
        und nach Möglichkeit einige Fotos.
      </p>
      <a href="/kontakt" class="btn btn-primary">Fahrzeug mit Mängeln anbieten</a>
    </div>

    <div class="condition-panel" data-animate>
      <div class="condition-panel-head">
        <div>
          <Wrench size={25} stroke-width={2.3} />
        </div>
        <strong>Direkt anfragen, auch wenn nicht alle Daten vorliegen</strong>
      </div>

      <div class="condition-cards">
        {conditions.map((condition, index) => (
          <article>
            {index % 3 === 0 ? <AlertTriangle size={18} stroke-width={2.3} /> : index % 3 === 1 ? <Gauge size={18} stroke-width={2.3} /> : <CircleCheck size={18} stroke-width={2.3} />}
            <span>{condition}</span>
            <small>kann angefragt werden</small>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .services-condition {
    padding: clamp(74px, 8vw, 112px) 0;
    background: #fff;
  }

  .condition-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(460px, 1.18fr);
    gap: clamp(34px, 5vw, 74px);
    align-items: center;
  }

  .condition-copy span {
    color: var(--orange);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.11em;
  }

  .condition-copy h2 {
    margin: 14px 0 0;
    color: #111827;
    font-size: clamp(38px, 5vw, 66px);
    line-height: 0.98;
    letter-spacing: -0.07em;
  }

  .condition-copy p {
    max-width: 650px;
    margin: 20px 0 28px;
    color: #5b6675;
    font-size: 17px;
    line-height: 1.75;
  }

  .condition-panel {
    padding: clamp(22px, 3vw, 34px);
    border: 1px solid rgba(17,24,39,0.08);
    border-radius: 30px;
    background:
      radial-gradient(circle at top right, rgba(255,107,0,0.12), transparent 20rem),
      #f7f9fc;
    box-shadow: 0 24px 76px rgba(15,23,42,0.1);
  }

  .condition-panel-head {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 22px;
  }

  .condition-panel-head div {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 17px;
    background: rgba(255,107,0,0.11);
    color: var(--orange);
  }

  .condition-panel-head strong {
    color: #111827;
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .condition-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .condition-cards article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 7px 11px;
    align-items: center;
    min-height: 88px;
    padding: 17px;
    border: 1px solid rgba(17,24,39,0.07);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(15,23,42,0.045);
    transition: transform 190ms ease, border-color 190ms ease;
  }

  .condition-cards article:hover {
    transform: translateY(-3px);
    border-color: rgba(255,107,0,0.32);
  }

  .condition-cards svg {
    grid-row: span 2;
    color: var(--orange);
  }

  .condition-cards span {
    color: #111827;
    font-weight: 900;
    line-height: 1.25;
  }

  .condition-cards small {
    color: #697586;
    font-size: 12px;
    font-weight: 750;
  }

  @media (max-width: 940px) {
    .condition-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .services-condition {
      padding: 64px 0;
    }

    .condition-copy h2 {
      font-size: clamp(34px, 11vw, 48px);
    }

    .condition-copy .btn {
      width: 100%;
    }

    .condition-panel {
      border-radius: 22px;
    }

    .condition-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
