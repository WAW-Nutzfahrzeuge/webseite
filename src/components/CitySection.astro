---
import { featuredCities } from "../data/cities";

const regions = featuredCities.map((city, index) => ({
  ...city,
  region: city.cardText,
  offset: index % 3,
}));
---

<section class="city-section" id="standorte">
  <div class="city-glow" aria-hidden="true"></div>
  <div class="container city-layout">
    <div class="city-copy" data-animate>
      <span class="city-kicker">STANDORTE & REGIONEN</span>
      <h2>Deutschland- und europaweit erreichbar – regional gefunden</h2>
      <p>
        Sie können uns Nutzfahrzeuge deutschland- und europaweit anbieten.
        Über unsere Standortseiten finden Unternehmen, Händler und Fuhrparks
        schnell den passenden regionalen Einstieg.
      </p>

      <div class="city-proof">
        <strong>{featuredCities.length}+</strong>
        <span>Regionen im Standortnetz</span>
      </div>

      <a href="/standorte" class="city-cta">
        Alle Standorte ansehen
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
      </a>
    </div>

    <div class="city-map" data-animate>
      <div class="map-frame">
        <div class="map-line map-line-a"></div>
        <div class="map-line map-line-b"></div>

        {regions.map((city) => (
          <a href={`/lkw-verkaufen/${city.slug}`} class={`city-card city-card--${city.offset}`}>
            <span class="city-badge">LKW Ankauf</span>
            <strong>{city.name}</strong>
            <small>{city.region}</small>
            <em>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
            </em>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .city-section {
    position: relative;
    overflow: hidden;
    padding: 92px 0;
    background:
      linear-gradient(135deg, #05070a 0%, #07111f 48%, #0a1728 100%);
    color: #fff;
  }

  .city-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.045) 1px, transparent 1px);
    background-size: 58px 58px;
    mask-image: radial-gradient(circle at 68% 44%, black, transparent 74%);
    pointer-events: none;
  }

  .city-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    right: 6%;
    top: 14%;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255,107,0,0.28), transparent 68%);
    filter: blur(10px);
    pointer-events: none;
  }

  .city-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 70px;
    align-items: center;
  }

  .city-copy {
    max-width: 600px;
  }

  .city-kicker {
    color: var(--orange);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .city-copy h2 {
    margin: 18px 0 0;
    color: #fff;
    font-size: clamp(42px, 5vw, 78px);
    line-height: 0.94;
    letter-spacing: -0.075em;
  }

  .city-copy p {
    max-width: 520px;
    margin: 24px 0 0;
    color: rgba(255,255,255,0.72);
    font-size: 18px;
    line-height: 1.7;
  }

  .city-proof {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
    padding: 18px 20px;
    width: fit-content;
    border-radius: 18px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
  }

  .city-proof strong {
    color: var(--orange);
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .city-proof span {
    max-width: 170px;
    color: rgba(255,255,255,0.82);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.35;
  }

  .city-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 15px 22px;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    font-weight: 900;
    box-shadow: 0 18px 42px rgba(255,107,0,0.26);
    transition: 220ms ease;
  }

  .city-cta:hover {
    transform: translateY(-3px);
    background: var(--orange-dark);
  }

  .city-cta svg,
  .city-card em svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .city-map {
    min-width: 0;
  }

  .map-frame {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    padding: 26px;
    border-radius: 34px;
    background:
      radial-gradient(circle at top right, rgba(255,107,0,0.14), transparent 18rem),
      rgba(255,255,255,0.065);
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow:
      0 28px 90px rgba(0,0,0,0.28),
      inset 0 1px 0 rgba(255,255,255,0.08);
  }

  .map-line {
    position: absolute;
    width: 46%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,107,0,0.48), transparent);
    pointer-events: none;
  }

  .map-line-a {
    top: 34%;
    left: 20%;
    transform: rotate(-12deg);
  }

  .map-line-b {
    bottom: 30%;
    right: 16%;
    transform: rotate(16deg);
  }

  .city-card {
    position: relative;
    min-height: 128px;
    display: grid;
    align-content: end;
    padding: 22px;
    border-radius: 22px;
    background: rgba(255,255,255,0.92);
    color: #101827;
    border: 1px solid rgba(255,255,255,0.2);
    box-shadow: 0 16px 36px rgba(0,0,0,0.14);
    transition:
      transform 240ms ease,
      background 240ms ease,
      box-shadow 240ms ease;
  }

  .city-card--1 {
    transform: translateY(18px);
  }

  .city-card--2 {
    transform: translateY(-10px);
  }

  .city-card:hover,
  .city-card--1:hover,
  .city-card--2:hover {
    transform: translateY(-6px);
    background: #fff;
    box-shadow: 0 26px 58px rgba(0,0,0,0.2);
  }

  .city-badge {
    position: absolute;
    left: 18px;
    top: 18px;
    padding: 7px 10px;
    border-radius: 999px;
    background: rgba(255,107,0,0.11);
    color: var(--orange);
    font-size: 11px;
    font-weight: 900;
  }

  .city-card strong {
    display: block;
    font-size: 24px;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .city-card small {
    display: block;
    margin-top: 7px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
  }

  .city-card em {
    position: absolute;
    right: 18px;
    top: 18px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    font-style: normal;
  }

  @media (max-width: 980px) {
    .city-layout {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .city-copy {
      max-width: 760px;
    }
  }

  @media (max-width: 640px) {
    .city-section {
      padding: 64px 0;
    }

    .city-copy {
      text-align: center;
    }

    .city-copy p {
      margin-left: auto;
      margin-right: auto;
    }

    .city-proof {
      margin-left: auto;
      margin-right: auto;
    }

    .map-frame {
      grid-template-columns: 1fr;
      padding: 14px;
      border-radius: 26px;
    }

    .city-card,
    .city-card--1,
    .city-card--2 {
      min-height: 118px;
      transform: none;
    }

    .city-card:hover {
      transform: translateY(-4px);
    }
  }
</style>
