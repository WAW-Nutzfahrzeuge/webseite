---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import { cities } from "../data/cities";
import { getCityImage } from "../utils/cityImages";
import { getLocaleFromPath, localizePath, localizeCityPath } from "../data/i18n";
import { homeCopy } from "../data/home";
const lang = getLocaleFromPath(Astro.url.pathname);
const c = homeCopy[lang];

const regions = ["hamburg", "berlin", "frankfurt", "muenchen"].map((slug) => {
  const city = cities.find((entry) => entry.slug === slug)!;
  return { ...city, image: getCityImage(city.name, city.slug) };
});
---

<section class="city-section" id="standorte" aria-labelledby="regions-title">
  <div class="container">
    <div class="city-head">
      <div>
        <h2 id="regions-title">{c.regionsTitle}</h2>
        <p>{c.regionsText}</p>
      </div>
      <a href={localizePath("locations", lang)} class="text-link">{c.regionsLink} <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
    <div class="city-grid">
      {regions.map((city) => (
        <a href={localizeCityPath(city.slug, lang)} class="city-link">
          {city.image && <Image src={city.image} width={480} height={300} format="webp" alt="" loading="lazy" sizes="(max-width: 760px) 50vw, 25vw" widths={[240, 480]} />}
          <span>{c.sellIn} {city.name}<ArrowRight size={18} aria-hidden="true" /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .city-section { padding: 64px 0 72px; background: #fff; }
  .container { max-width: 1320px; }
  .city-head { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 30px; }
  h2 { margin: 0 0 16px; font-size: clamp(28px, 3vw, 40px); line-height: 1.15; }
  p { max-width: 700px; margin: 0; font-size: 16px; line-height: 1.7; color: #435063; }
  .text-link { display: inline-flex; align-items: center; gap: 12px; flex-shrink: 0; min-height: 44px; font-weight: 750; text-decoration: underline; text-underline-offset: 5px; }
  .city-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .city-link { min-width: 0; }
  .city-link :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1.6; object-fit: cover; border-radius: var(--radius-image); }
  .city-link span { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-block: 16px; font-size: 15px; font-weight: 750; line-height: 1.5; border-bottom: 1px solid #dce2e8; }
  .city-link :global(svg) { flex-shrink: 0; color: #b94d00; }
  a:hover { color: #a94300; }
  @media (max-width: 900px) { .city-head { flex-direction: column; align-items: start; gap: 16px; } .city-grid { gap: 18px; } }
  @media (max-width: 760px) {
    .city-section { padding: 48px 6px; }
    .city-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; }
    .city-link span { align-items: start; font-size: 14px; padding-block: 12px; }
  }
</style>
