---
import { PhoneCall } from "@lucide/astro";
import { site } from "../data/site";

const {
  eyebrow = "Sie haben Fragen?",
  title = "Rufen Sie uns direkt an.",
  buttonLabel = "Jetzt anrufen",
} = Astro.props;
---

<section class="contact-call-bar">
  <div class="container contact-call-inner">
    <div>
      <span>{eyebrow}</span>
      <strong>{title}</strong>
    </div>

    <a class="contact-call-phone" href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>

    <a class="contact-call-button" href={`tel:${site.phoneHref}`}>
      <PhoneCall size={19} stroke-width={2.4} />
      {buttonLabel}
    </a>
  </div>
</section>

<style>
  .contact-call-bar {
    padding: 28px 0;
    background: linear-gradient(135deg, var(--orange), var(--orange-dark));
    color: #fff;
  }

  .contact-call-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 22px;
    align-items: center;
  }

  .contact-call-inner span,
  .contact-call-inner strong {
    display: block;
  }

  .contact-call-inner span {
    font-size: 14px;
    font-weight: 850;
    opacity: 0.86;
  }

  .contact-call-inner strong {
    margin-top: 3px;
    font-size: clamp(22px, 3vw, 34px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .contact-call-phone {
    color: #fff;
    font-size: clamp(22px, 3vw, 34px);
    font-weight: 950;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .contact-call-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: 1px solid rgba(255,255,255,0.34);
    border-radius: 999px;
    background: rgba(255,255,255,0.14);
    color: #fff;
    font-weight: 900;
    padding: 14px 20px;
    text-decoration: none;
    transition: background 180ms ease, transform 180ms ease;
  }

  .contact-call-button:hover {
    background: rgba(255,255,255,0.22);
    transform: translateY(-2px);
  }

  @media (max-width: 760px) {
    .contact-call-inner {
      grid-template-columns: 1fr;
      gap: 16px;
      text-align: center;
    }

    .contact-call-button {
      width: 100%;
    }
  }
</style>
