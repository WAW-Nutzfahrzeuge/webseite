---
import { BadgeEuro, ClockCheck, MapPin, ShieldCheck } from "@lucide/astro";

const iconMap = {
  shield: ShieldCheck,
  clock: ClockCheck,
  euro: BadgeEuro,
  map: MapPin,
};

const defaultBenefits = [
  {
    title: "Sicher & zuverlässig",
    text: "Klare Abstimmung vom ersten Kontakt bis zur Übergabe.",
    iconKey: "shield",
  },
  {
    title: "Schnelle Abwicklung",
    text: "Wir melden uns schnellstmöglich und besprechen die nächsten Schritte direkt.",
    iconKey: "clock",
  },
  {
    title: "Faire Preise",
    text: "Marktgerechte Angebote auf Basis von Fahrzeugdaten, Zustand und Standort.",
    iconKey: "euro",
  },
  {
    title: "Deutschland- und europaweit",
    text: "Fahrzeuge aus Deutschland und Europa können Sie uns direkt anbieten.",
    iconKey: "map",
  },
];

const {
  kicker = "IHRE VORTEILE MIT WAW",
  title = "Darum fragen Unternehmen und Fuhrparks bei uns an",
  benefits = defaultBenefits,
} = Astro.props;
---

<section class="ablauf-benefits">
  <div class="benefits-bg" aria-hidden="true"></div>
  <div class="container">
    <div class="benefits-head" data-animate>
      <span>{kicker}</span>
      <h2>{title}</h2>
    </div>

    <div class="benefits-grid">
      {benefits.map((benefit) => {
        const Icon = iconMap[benefit.iconKey as keyof typeof iconMap] || ShieldCheck;
        return (
          <article class="benefit-card" data-animate>
            <div class="benefit-icon">
              <Icon aria-hidden="true" />
            </div>
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .ablauf-benefits {
    position: relative;
    overflow: hidden;
    padding: 86px 0;
    color: #fff;
    background: #05070a;
  }

  .benefits-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5,7,10,0.96), rgba(5,7,10,0.82)),
      radial-gradient(circle at 74% 34%, rgba(255,107,0,0.2), transparent 24rem),
      linear-gradient(135deg, #05070a, #07111f 54%, #071a33);
    background-size: auto, auto, auto;
    background-position: center;
    opacity: 0.98;
  }

  .benefits-head,
  .benefits-grid {
    position: relative;
    z-index: 1;
  }

  .benefits-head {
    text-align: center;
    margin-bottom: 36px;
  }

  .benefits-head span {
    color: var(--orange);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .benefits-head h2 {
    margin: 12px 0 0;
    color: #fff;
    font-size: clamp(34px, 5vw, 62px);
    line-height: 1;
    letter-spacing: -0.068em;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    max-width: 1060px;
    margin: 0 auto;
  }

  .benefit-card {
    min-height: 230px;
    padding: 28px;
    border-radius: 24px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.16);
    backdrop-filter: blur(18px);
    transition: transform 240ms ease, background 240ms ease;
  }

  .benefit-card:hover {
    transform: translateY(-6px);
    background: rgba(255,255,255,0.12);
  }

  .benefit-icon {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    margin-bottom: 24px;
    border-radius: 18px;
    color: var(--orange);
    background: rgba(255,107,0,0.12);
    border: 1px solid rgba(255,107,0,0.28);
  }

  .benefit-icon :global(svg) {
    width: 30px;
    height: 30px;
    stroke-width: 1.8;
  }

  .benefit-card h3 {
    margin: 0;
    color: #fff;
    font-size: 22px;
    line-height: 1.12;
    letter-spacing: -0.045em;
  }

  .benefit-card p {
    margin: 12px 0 0;
    color: rgba(255,255,255,0.72);
    line-height: 1.65;
  }

  @media (max-width: 980px) {
    .benefits-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .ablauf-benefits {
      padding: 64px 0;
    }

    .benefits-grid {
      grid-template-columns: 1fr;
    }

    .benefit-card {
      min-height: auto;
      text-align: center;
    }

    .benefit-icon {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
