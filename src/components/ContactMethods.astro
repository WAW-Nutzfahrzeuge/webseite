---
import { Mail, MapPin, MessageCircle, PhoneCall } from "@lucide/astro";
import { site } from "../data/site";
import ContactLeadForm from "./ContactLeadForm.astro";

const {
  kicker = "SO ERREICHEN SIE UNS",
  title = "Kontaktieren Sie uns so, wie es für Sie passt.",
  text = "Für schnelle Rückfragen eignet sich Telefon oder WhatsApp. Für mehrere Fahrzeuge, Unterlagen oder Fahrzeuglisten können Sie das Formular oder E-Mail nutzen.",
  phoneLabel = "Telefon",
  phoneHours = "Mo-Fr 08:00-18:00 Uhr · Sa 09:00-14:00 Uhr",
  whatsappLabel = "WhatsApp",
  whatsappText = "WhatsApp schreiben",
  whatsappHint = "Schnelle Abstimmung mit Fahrzeugdaten und Fotos",
  emailLabel = "E-Mail",
  emailHint = "Für Fahrzeuglisten, Unterlagen und ausführliche Angaben",
  locationLabel = "Standort",
  locationCountry = "Deutschland",
  form = {},
} = Astro.props;
---

<section class="contact-methods-section">
  <div class="container contact-methods-grid">
    <div class="contact-methods-copy" data-animate>
      <span class="section-kicker">{kicker}</span>
      <h2>{title}</h2>
      <p>{text}</p>

      <div class="contact-method-cards">
        <a class="contact-method-card" href={`tel:${site.phoneHref}`} data-animate>
          <span class="contact-method-icon"><PhoneCall size={24} stroke-width={2.2} /></span>
          <span>
            <strong>{phoneLabel}</strong>
            <em>{site.phoneDisplay}</em>
            <small>{phoneHours}</small>
          </span>
        </a>

        <a class="contact-method-card" href={site.whatsappHref} target="_blank" rel="noopener" data-animate>
          <span class="contact-method-icon"><MessageCircle size={24} stroke-width={2.2} /></span>
          <span>
            <strong>{whatsappLabel}</strong>
            <em>{whatsappText}</em>
            <small>{whatsappHint}</small>
          </span>
        </a>

        <a class="contact-method-card" href={`mailto:${site.email}`} data-animate>
          <span class="contact-method-icon"><Mail size={24} stroke-width={2.2} /></span>
          <span>
            <strong>{emailLabel}</strong>
            <em>{site.email}</em>
            <small>{emailHint}</small>
          </span>
        </a>

        <div class="contact-method-card" data-animate>
          <span class="contact-method-icon"><MapPin size={24} stroke-width={2.2} /></span>
          <span>
            <strong>{locationLabel}</strong>
            <em>{site.address.street}, {site.address.postalCode} {site.address.locality}</em>
            <small>{site.address.region}, {locationCountry}</small>
          </span>
        </div>
      </div>
    </div>

    <div class="contact-form-wrap" data-animate>
      <ContactLeadForm {...form} />
    </div>
  </div>
</section>

<style>
  .contact-methods-section {
    position: relative;
    padding: clamp(78px, 8vw, 124px) 0;
    background:
      radial-gradient(circle at 8% 18%, rgba(255,107,0,0.07), transparent 22rem),
      linear-gradient(180deg, #fff, #f6f7f9);
  }

  .contact-methods-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 1.05fr);
    gap: clamp(34px, 5vw, 76px);
    align-items: start;
  }

  .section-kicker {
    color: var(--orange);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.11em;
  }

  .contact-methods-copy h2 {
    max-width: 620px;
    margin: 14px 0 16px;
    color: #111827;
    font-size: clamp(38px, 5vw, 66px);
    line-height: 0.98;
    letter-spacing: -0.07em;
  }

  .contact-methods-copy p {
    max-width: 600px;
    margin: 0;
    color: #5b6675;
    font-size: 17px;
    line-height: 1.75;
  }

  .contact-method-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 34px;
  }

  .contact-method-card {
    display: flex;
    gap: 15px;
    min-height: 158px;
    padding: 22px;
    border: 1px solid rgba(17,24,39,0.08);
    border-radius: 22px;
    background: rgba(255,255,255,0.9);
    color: #111827;
    box-shadow: 0 18px 48px rgba(17,24,39,0.07);
    text-decoration: none;
    transition: transform 190ms ease, box-shadow 190ms ease, border-color 190ms ease;
  }

  a.contact-method-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255,107,0,0.34);
    box-shadow: 0 24px 62px rgba(17,24,39,0.12);
  }

  .contact-method-icon {
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: rgba(255,107,0,0.1);
    color: var(--orange);
  }

  .contact-method-card span:last-child {
    display: grid;
    gap: 7px;
  }

  .contact-method-card strong {
    font-size: 15px;
    font-weight: 950;
  }

  .contact-method-card em {
    color: #07111f;
    font-size: 16px;
    font-style: normal;
    font-weight: 850;
    line-height: 1.35;
  }

  .contact-method-card small {
    color: #697586;
    font-size: 13px;
    line-height: 1.45;
  }

  .contact-form-wrap {
    position: sticky;
    top: 98px;
  }

  @media (max-width: 980px) {
    .contact-methods-grid {
      grid-template-columns: 1fr;
    }

    .contact-form-wrap {
      position: static;
    }
  }

  @media (max-width: 680px) {
    .contact-methods-section {
      padding: 68px 0;
    }

    .contact-methods-copy h2 {
      font-size: clamp(34px, 11vw, 48px);
    }

    .contact-method-cards {
      grid-template-columns: 1fr;
    }

    .contact-method-card {
      min-height: 0;
      border-radius: 18px;
      padding: 18px;
    }
  }
</style>
