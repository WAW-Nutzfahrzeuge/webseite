---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingContact from "./FloatingContact.astro";
import HomeProcessSection from "./HomeProcessSection.astro";
import HomeVehicleTypes from "./HomeVehicleTypes.astro";
import { cities, stateGroups } from "../data/cities";
import { absoluteUrl, createBreadcrumbSchema } from "../utils/seo";
import { getLocaleFromPath, localizePath, localizeCityPath, ui } from "../data/i18n";
import { locationCopy } from "../data/locations";
import { homeCopy } from "../data/home";

const lang = getLocaleFromPath(Astro.url.pathname);
const c = locationCopy(lang);
const h = homeCopy[lang];
const sortedCities = [...cities].sort((a, b) => a.name.localeCompare(b.name, "de"));
---
<BaseLayout title={c.title} description={c.description} canonical={absoluteUrl(localizePath("locations", lang))} schema={createBreadcrumbSchema([{ name: ui[lang].home, url: absoluteUrl(localizePath("home", lang)) }, { name: ui[lang].locations, url: absoluteUrl(localizePath("locations", lang)) }])}>
  <Header />
  <main>
    <section class="coverage-hero">
      <div class="container">
        <h1>{c.heading}</h1>
        <p>{c.intro}</p>
        <p>{c.text}</p>
        <a class="btn btn-primary" href={`${localizePath("contact", lang)}#kontaktformular`}>{h.offer}</a>
      </div>
    </section>
    <section class="section" aria-labelledby="city-search-title">
      <div class="container">
        <h2 id="city-search-title">{c.searchTitle}</h2>
        <label for="city-search">{c.searchLabel}</label>
        <input id="city-search" type="search" placeholder={c.searchPlaceholder} autocomplete="off" />
        <p id="city-count" role="status" aria-live="polite" data-matching={c.matching} data-selected={c.selected} data-results={c.results} data-empty={c.noResults}>{c.initialCount.replace("{count}", String(cities.length))}</p>
        <div class="city-results">
          {sortedCities.map((city) => (
            <a href={localizeCityPath(city.slug, lang)} data-city-result data-search={`${city.name} ${city.state}`} data-initial={String(city.showInNavigation)} hidden={!city.showInNavigation}>
              <strong>{h.sellIn} {city.name}</strong><span>{city.state}</span>
            </a>
          ))}
        </div>
        <noscript><p>{c.noScript}</p></noscript>
      </div>
    </section>
    <section class="section state-section" aria-labelledby="state-list-title">
      <div class="container">
        <h2 id="state-list-title">{c.statesTitle}</h2>
        <div class="state-links">{stateGroups.map((state) => <a href={`${localizePath("locations", lang)}/${state.slug}`}>{state.name}</a>)}</div>
        <p>{c.multiple}</p>
        <a href={localizePath("process", lang)}>{c.processLink}</a>
      </div>
    </section>
    <HomeProcessSection />
    <HomeVehicleTypes />
  </main>
  <Footer /><FloatingContact />
</BaseLayout>
<script>
  const search = document.querySelector<HTMLInputElement>("#city-search")!;
  const results = document.querySelectorAll<HTMLAnchorElement>("[data-city-result]");
  const count = document.querySelector<HTMLElement>("#city-count")!;
  const normalize = (value: string) => value.toLocaleLowerCase("de").normalize("NFD").replace(/\p{Diacritic}/gu, "").replace(/ß/g, "ss");
  search.addEventListener("input", () => {
    const query = normalize(search.value.trim());
    let matches = 0;
    results.forEach((result) => {
      const visible = query ? normalize(result.dataset.search || "").includes(query) : result.dataset.initial === "true";
      result.hidden = !visible;
      if (visible) matches++;
    });
    count.textContent = matches ? `${matches} ${query ? count.dataset.matching : count.dataset.selected} ${count.dataset.results}` : count.dataset.empty!;
  });
</script>
<style>
  .coverage-hero { padding: 140px 0 64px; background: var(--navy); color: #fff; }
  h1 { max-width: 24ch; font-size: clamp(36px, 4.5vw, 68px); line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 24px; }
  h2 { font-size: clamp(28px, 3vw, 42px); line-height: 1.15; margin: 0 0 24px; }
  p { max-width: 75ch; line-height: 1.75; }
  label { display: block; font-weight: 700; margin-bottom: 10px; }
  input { width: min(100%, 620px); font-size: 16px; padding: 16px; border: 1px solid #718299; border-radius: 8px; background: #fff; color: var(--text); }
  .city-results, .state-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 28px 0; }
  .city-results a, .state-links a { padding: 20px; background: #fff; border: 1px solid #d5dce5; border-radius: 12px; }
  .city-results a[hidden] { display: none; }
  .city-results span { display: block; margin-top: 8px; color: var(--muted); }
  .state-section { background: #e8edf3; }
  .state-section > div > a { text-decoration: underline; font-weight: 700; }
  @media (max-width: 800px) { .city-results, .state-links { grid-template-columns: 1fr; } }
</style>
