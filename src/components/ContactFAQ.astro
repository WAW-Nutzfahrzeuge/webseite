---
import type { FaqItem } from "../utils/seo";

interface Props {
  faqs: FaqItem[];
}

const { faqs, title = "Häufige Fragen zur Fahrzeuganfrage", kicker = "FAQ" } = Astro.props;
---

<section class="contact-faq-section">
  <div class="container">
    <div class="contact-faq-head" data-animate>
      <span>{kicker}</span>
      <h2>{title}</h2>
    </div>

    <div class="contact-faq-grid">
      {faqs.map((faq, index) => (
        <details class="contact-faq-item" data-contact-faq data-animate open={index === 0}>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const contactFaqs = document.querySelectorAll<HTMLDetailsElement>("[data-contact-faq]");

  contactFaqs.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      contactFaqs.forEach((other) => {
        if (other !== item) other.removeAttribute("open");
      });
    });
  });
</script>

<style>
  .contact-faq-section {
    padding: clamp(74px, 8vw, 112px) 0;
    background:
      linear-gradient(180deg, #f6f7f9, #fff);
  }

  .contact-faq-head {
    max-width: 760px;
    margin: 0 auto 38px;
    text-align: center;
  }

  .contact-faq-head span {
    color: var(--orange);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.11em;
  }

  .contact-faq-head h2 {
    margin: 14px 0 0;
    color: #111827;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1;
    letter-spacing: -0.065em;
  }

  .contact-faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 14px;
    max-width: 1120px;
    margin: 0 auto;
  }

  .contact-faq-item {
    height: fit-content;
    border: 1px solid rgba(17,24,39,0.08);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 16px 42px rgba(17,24,39,0.055);
    overflow: hidden;
  }

  .contact-faq-item summary {
    cursor: pointer;
    list-style: none;
    color: #111827;
    font-size: 16px;
    font-weight: 900;
    padding: 22px 24px;
  }

  .contact-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .contact-faq-item summary::after {
    content: "+";
    float: right;
    color: var(--orange);
    font-size: 24px;
    line-height: 0.8;
  }

  .contact-faq-item[open] summary::after {
    content: "-";
  }

  .contact-faq-item p {
    margin: -6px 24px 24px;
    color: #5b6675;
    line-height: 1.7;
  }

  @media (max-width: 780px) {
    .contact-faq-section {
      padding: 64px 0;
    }

    .contact-faq-grid {
      grid-template-columns: 1fr;
    }

    .contact-faq-head h2 {
      font-size: clamp(34px, 11vw, 46px);
    }

    .contact-faq-item summary {
      padding: 20px;
    }

    .contact-faq-item p {
      margin: -4px 20px 20px;
    }
  }
</style>
