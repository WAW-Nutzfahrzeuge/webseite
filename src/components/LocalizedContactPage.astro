---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingContact from "./FloatingContact.astro";
import ScrollAnimations from "./ScrollAnimations.astro";
import ContactHero from "./ContactHero.astro";
import ContactMethods from "./ContactMethods.astro";
import ContactBenefits from "./ContactBenefits.astro";
import ContactMapSection from "./ContactMapSection.astro";
import ContactFAQ from "./ContactFAQ.astro";
import ContactCallBar from "./ContactCallBar.astro";
import { site } from "../data/site";
import { localizeCityPath, localizePath, type Locale } from "../data/i18n";
import { absoluteUrl, createBreadcrumbSchema, createFaqSchema } from "../utils/seo";

const { lang } = Astro.props as { lang: Locale };

const content = {
  en: {
    title: "Contact | Sell trucks & commercial vehicles | WAW",
    description:
      "Contact WAW by form, WhatsApp or phone to offer trucks, trailers, vans, construction machinery or entire fleets.",
    home: "Home",
    current: "Contact",
    hero: {
      kicker: "WE'RE HERE TO HELP",
      title: "Sell your vehicle quickly and without obligation.",
      text:
        "Looking to sell a truck, semi-trailer, trailer, van, construction machine or an entire fleet? Send us the key details and we will get back to you personally as soon as possible.",
      trustline: ["Fast response", "No-obligation inquiry", "Direct point of contact"],
    },
    methods: {
      kicker: "CONTACT OPTIONS",
      title: "Get in touch in the way that suits you best.",
      text:
        "Choose the quickest way for you. Phone or WhatsApp works well for short questions. For several vehicles or documents, use the form or email.",
      phoneLabel: "Call us directly",
      phoneHours: "Mon-Fri 08:00-18:00 · Sat 09:00-14:00",
      whatsappLabel: "WhatsApp",
      whatsappText: "Message us on WhatsApp",
      whatsappHint: "Best for quick details, photos and questions",
      emailLabel: "Email",
      emailHint: "For vehicle lists, documents and more detailed information",
      locationLabel: "Location",
      locationCountry: "Germany",
      form: {
        kicker: "FORM",
        title: "Sell your vehicle now",
        text: "Send us the key details about your vehicle or fleet. We will get back to you as soon as possible.",
        help: "Do not have every detail ready? No problem. Your name and phone number are enough for the first contact.",
        source: "Contact page EN",
        submitLabel: "Sell your vehicle now",
        sendingLabel: "Sending...",
        privacyText: "We use your details only to process your inquiry.",
        defaultError: "We could not send your inquiry.",
        fallbackError: "We could not send your inquiry. Please call us directly or message us on WhatsApp.",
        labels: {
          name: "Name *",
          phone: "Phone *",
          email: "Email",
          company: "Company",
          vehicle: "Vehicle / type",
          year: "Year",
          mileage: "Mileage",
          condition: "Condition / notes",
          message: "Your message",
        },
        placeholders: {
          name: "Your name",
          phone: "+49 ...",
          email: "name@example.com",
          company: "Company name (optional)",
          vehicle: "e.g. truck, semi-trailer or van",
          year: "e.g. 2018",
          mileage: "e.g. 420,000 km",
          condition: "e.g. roadworthy, engine damage, accident damage",
          message: "Add any other details or questions here",
        },
      },
    },
    benefitsTitle: "What you can expect from us",
    benefits: [
      { iconKey: "shield", title: "Fast response", text: "We reply quickly and discuss the next steps with you directly." },
      { iconKey: "clock", title: "Clear assessment", text: "Our feedback is based on vehicle data, condition and location." },
      { iconKey: "euro", title: "Straightforward process", text: "You receive a realistic response without unnecessary back and forth." },
      { iconKey: "truck", title: "Pickup available", text: "Handover or pickup is arranged to match the vehicle and its location." },
      { iconKey: "lock", title: "Confidential handling", text: "We treat your inquiry discreetly and professionally." },
    ],
    map: {
      routeLabel: "Get directions",
      kicker: "LOCATION & COVERAGE",
      title: "Based in Talkau, available across Germany and Europe",
      text:
        "Whether it is a single vehicle or an entire fleet, you can offer your commercial vehicle to us from anywhere in Germany and Europe. We coordinate the next steps with you directly.",
      bullets: ["Pickup or on-site handover by arrangement", "Single vehicles and complete fleets", "Also vehicles with damage or high mileage", "Direct personal coordination"],
      allLocationsHref: localizePath("locations", "en"),
      allLocationsLabel: "View all locations",
      cityLinks: ["hamburg", "berlin", "hannover", "bremen"].map((slug) => ({ href: localizeCityPath(slug, "en"), label: slug === "hannover" ? "Hanover" : slug[0].toUpperCase() + slug.slice(1) })),
    },
    faqTitle: "Frequently asked questions",
    faqs: [
      { question: "How quickly will you get back to me?", answer: "We usually reply soon after receiving your inquiry. The more complete your details and photos are, the more precisely we can respond." },
      { question: "Which details should I send?", answer: "Helpful details include vehicle type, make, model, year, mileage, condition, location, plus photos or documents. If you do not have everything ready yet, your contact details are enough to get started." },
      { question: "Can I offer my vehicle via WhatsApp?", answer: "Yes. You can send us vehicle details, photos and short notes directly on WhatsApp. We then discuss the next steps with you personally." },
      { question: "Is my inquiry non-binding?", answer: "Yes. Your inquiry and the initial discussion are non-binding. We clarify everything else directly with you." },
      { question: "Can I offer several vehicles or an entire fleet?", answer: "Yes. We buy single commercial vehicles as well as complete fleets from companies, dealers and fleet operators." },
      { question: "Can I send photos and documents?", answer: "Yes. Photos, registration papers, maintenance records or other documents help us assess your inquiry faster." },
    ],
    callBar: { eyebrow: "Prefer to speak to us directly?", title: "Call us directly.", buttonLabel: "Call us directly" },
  },
  fr: {
    title: "Contact | Vendre camions & véhicules utilitaires | WAW",
    description:
      "Contactez WAW par formulaire, WhatsApp ou téléphone pour proposer des camions, remorques, fourgons, machines de chantier ou des flottes complètes.",
    home: "Accueil",
    current: "Contact",
    hero: {
      kicker: "NOUS SOMMES LÀ POUR VOUS",
      title: "Vendez votre véhicule simplement, sans engagement.",
      text:
        "Vous souhaitez vendre un camion, une semi-remorque, une remorque, un fourgon, une machine de chantier ou toute une flotte ? Envoyez-nous les informations essentielles. Nous vous recontactons rapidement et personnellement.",
      trustline: ["Réponse rapide", "Demande sans engagement", "Un interlocuteur direct"],
    },
    methods: {
      kicker: "MOYENS DE CONTACT",
      title: "Contactez-nous de la manière la plus simple pour vous.",
      text:
        "Choisissez le canal qui vous convient le mieux. Pour une question rapide, le téléphone ou WhatsApp sont idéaux. Pour plusieurs véhicules ou des documents, utilisez le formulaire ou l'e-mail.",
      phoneLabel: "Appeler directement",
      phoneHours: "Lun-Ven 08:00-18:00 · Sam 09:00-14:00",
      whatsappLabel: "WhatsApp",
      whatsappText: "Écrire sur WhatsApp",
      whatsappHint: "Idéal pour envoyer rapidement infos, photos et questions",
      emailLabel: "E-mail",
      emailHint: "Pour les listes de véhicules, les documents et les informations détaillées",
      locationLabel: "Site",
      locationCountry: "Allemagne",
      form: {
        kicker: "FORMULAIRE",
        title: "Vendre votre véhicule maintenant",
        text: "Envoyez-nous les informations essentielles sur votre véhicule ou votre flotte. Nous vous recontactons rapidement.",
        help: "Vous n'avez pas encore tous les détails ? Ce n'est pas un problème. Votre nom et votre numéro suffisent pour un premier contact.",
        source: "Contact FR",
        submitLabel: "Vendre votre véhicule maintenant",
        sendingLabel: "Envoi en cours...",
        privacyText: "Nous utilisons vos données uniquement pour traiter votre demande.",
        defaultError: "Nous n'avons pas pu envoyer votre demande.",
        fallbackError: "Nous n'avons pas pu envoyer votre demande. Merci de nous appeler directement ou de nous écrire sur WhatsApp.",
        labels: {
          name: "Nom *",
          phone: "Téléphone *",
          email: "E-mail",
          company: "Entreprise",
          vehicle: "Véhicule / type",
          year: "Année",
          mileage: "Kilométrage",
          condition: "État / remarques",
          message: "Votre message",
        },
        placeholders: {
          name: "Votre nom",
          phone: "+49 ...",
          email: "nom@example.com",
          company: "Nom de l'entreprise (facultatif)",
          vehicle: "ex. camion, semi-remorque ou fourgon",
          year: "ex. 2018",
          mileage: "ex. 420 000 km",
          condition: "ex. roulant, panne moteur, accidenté",
          message: "Ajoutez ici toute précision ou question",
        },
      },
    },
    benefitsTitle: "Ce que vous pouvez attendre de nous",
    benefits: [
      { iconKey: "shield", title: "Réponse rapide", text: "Nous revenons vite vers vous et convenons directement de la suite." },
      { iconKey: "clock", title: "Évaluation claire", text: "Notre retour tient compte des données, de l'état et du lieu du véhicule." },
      { iconKey: "euro", title: "Échange simple", text: "Vous recevez un retour réaliste, sans allers-retours inutiles." },
      { iconKey: "truck", title: "Enlèvement possible", text: "Remise ou enlèvement sont organisés selon le véhicule et son emplacement." },
      { iconKey: "lock", title: "Traitement confidentiel", text: "Votre demande est traitée avec discrétion et professionnalisme." },
    ],
    map: {
      routeLabel: "Itinéraire",
      kicker: "LOCALISATION & ZONE D'INTERVENTION",
      title: "Basés à Talkau, disponibles partout en Allemagne et en Europe",
      text:
        "Qu'il s'agisse d'un seul véhicule ou d'une flotte complète, vous pouvez nous proposer votre véhicule utilitaire depuis toute l'Allemagne et l'Europe. Nous convenons directement avec vous de la suite.",
      bullets: ["Enlèvement ou remise sur place sur accord", "Véhicules seuls et flottes complètes", "Aussi pour véhicules endommagés ou fortement kilométrés", "Échange direct et personnel"],
      allLocationsHref: localizePath("locations", "fr"),
      allLocationsLabel: "Voir toutes les implantations",
      cityLinks: ["hamburg", "berlin", "hannover", "bremen"].map((slug) => ({ href: localizeCityPath(slug, "fr"), label: slug === "hannover" ? "Hanovre" : slug[0].toUpperCase() + slug.slice(1) })),
    },
    faqTitle: "Questions fréquentes",
    faqs: [
      { question: "Sous quel délai me recontactez-vous ?", answer: "En règle générale, nous revenons vers vous rapidement après réception de votre demande. Plus vos informations et vos photos sont complètes, plus notre retour peut être précis." },
      { question: "Quelles informations dois-je envoyer ?", answer: "Le type de véhicule, la marque, le modèle, l'année, le kilométrage, l'état, le lieu ainsi que des photos ou documents sont utiles. Si vous n'avez pas encore tout, vos coordonnées suffisent pour commencer." },
      { question: "Puis-je proposer mon véhicule via WhatsApp ?", answer: "Oui. Vous pouvez nous envoyer directement sur WhatsApp les informations du véhicule, des photos et quelques précisions. Nous échangeons ensuite avec vous sur la suite." },
      { question: "Ma demande est-elle sans engagement ?", answer: "Oui. Votre demande et le premier échange sont sans engagement. Nous clarifions ensuite directement avec vous la suite." },
      { question: "Puis-je proposer plusieurs véhicules ou toute une flotte ?", answer: "Oui. Nous achetons aussi bien des véhicules utilitaires à l'unité que des flottes complètes d'entreprises, de négociants et de gestionnaires de parc." },
      { question: "Puis-je envoyer des photos et des documents ?", answer: "Oui. Les photos, la carte grise, les justificatifs d'entretien ou d'autres documents nous aident à évaluer votre demande plus rapidement." },
    ],
    callBar: { eyebrow: "Vous préférez nous parler directement ?", title: "Appelez-nous directement.", buttonLabel: "Appeler directement" },
  },
} as const;

const copy = content[lang];
const canonical = absoluteUrl(localizePath("contact", lang));
const schema = [
  createFaqSchema(copy.faqs),
  createBreadcrumbSchema([
    { name: copy.home, url: absoluteUrl(localizePath("home", lang)) },
    { name: copy.current, url: canonical },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": `${canonical}#contact`,
    url: canonical,
    name: copy.title,
    description: copy.description,
    mainEntity: {
      "@type": "AutoDealer",
      "@id": `${site.url}/#localbusiness`,
      name: site.name,
      telephone: site.phoneDisplay,
      email: site.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: site.address.street,
        postalCode: site.address.postalCode,
        addressLocality: site.address.locality,
        addressRegion: site.address.region,
        addressCountry: site.address.country,
      },
    },
  },
];
---

<BaseLayout title={copy.title} description={copy.description} canonical={canonical} schema={schema}>
  <Header transparent />

  <main>
    <ContactHero {...copy.hero} />
    <ContactMethods {...copy.methods} />
    <ContactBenefits title={copy.benefitsTitle} benefits={copy.benefits} />
    <ContactMapSection {...copy.map} />
    <ContactFAQ faqs={copy.faqs} title={copy.faqTitle} />
    <ContactCallBar {...copy.callBar} />
  </main>

  <Footer />
  <FloatingContact />
  <ScrollAnimations />
</BaseLayout>
