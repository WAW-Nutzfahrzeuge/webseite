---
import { ArrowRight } from "@lucide/astro";
import { getLocaleFromPath } from "../data/i18n";
import { homeCopy } from "../data/home";
const c = homeCopy[getLocaleFromPath(Astro.url.pathname)];
const conditions = c.conditions;
---

<section class="conditions-section" aria-labelledby="conditions-title">
  <div class="container purchase-layout">
    <div class="purchase-copy">
      <h2 id="conditions-title">{c.conditionTitle[0]}<br />{c.conditionTitle[1]}</h2>
      <p>{c.conditionText}</p>
      <ul class="condition-list">
        {conditions.map((condition) => <li>{condition}</li>)}
      </ul>
      <p class="purchase-note">{c.conditionNote}</p>
      <a href="#kontaktformular" class="text-link">{c.conditionLink} <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
    <figure>
      <img src="/images/ablauf-inspection.webp" alt={c.inspectionAlt} width="1448" height="1086" loading="lazy" />
      <figcaption>{c.inspectionCaption}</figcaption>
    </figure>
  </div>
</section>

<slot name="before-fleet" />

<section class="fleet-section" aria-labelledby="fleet-title">
  <div class="container purchase-layout fleet-layout">
    <figure>
      <picture>
        <source media="(max-width: 760px)" srcset="/images/waw_real_2_mobile.webp" width="1024" height="1536" />
        <img src="/images/waw_real_2.webp" alt={c.fleetAlt} width="1448" height="1086" loading="lazy" />
      </picture>
    </figure>
    <div class="purchase-copy">
      <h2 id="fleet-title">{c.fleetTitle[0]}<br />{c.fleetTitle[1]}</h2>
      <p>{c.fleetText}</p>
      <div class="sale-situations">
        {c.situations.map((item) => <div><h3>{item.title}</h3><p>{item.text}</p></div>)}
      </div>
      <a href="#kontaktformular" class="text-link">{c.fleetLink} <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  .conditions-section { background: #f3f5f6; padding: 80px 0; }
  .fleet-section { background: #fff; padding: 88px 0; }
  .container { max-width: 1320px; }
  .purchase-layout { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(36px, 6vw, 88px); align-items: center; }
  .fleet-layout { grid-template-columns: 1.05fr 1fr; }
  figure { margin: 0; }
  img { display: block; width: 100%; height: auto; aspect-ratio: 1.08; object-fit: cover; border-radius: var(--radius-image); }
  figcaption { padding-top: 12px; color: var(--muted); font-size: 12px; line-height: 1.5; }
  h2 { margin: 0 0 22px; font-size: clamp(32px, 3.4vw, 48px); line-height: 1.1; color: var(--navy-deep); }
  .purchase-copy > p { color: #435063; font-size: 17px; line-height: 1.75; margin: 0 0 22px; }
  .condition-list { list-style: none; padding: 0; margin: 26px 0 20px; }
  .condition-list li { position: relative; padding: 12px 0 12px 22px; border-bottom: 1px solid #d2dae3; line-height: 1.5; font-weight: 650; }
  .condition-list li::before { content: ""; position: absolute; left: 0; top: 21px; width: 7px; height: 7px; border-radius: 50%; background: #b94d00; }
  .purchase-copy > .purchase-note { font-size: 14px; }
  .text-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; font-weight: 750; line-height: 1.5; text-decoration: underline; text-underline-offset: 5px; }
  .text-link :global(svg) { flex-shrink: 0; }
  .text-link:hover { color: #a94300; }
  .sale-situations { margin: 24px 0; border-top: 1px solid #dce2e8; }
  .sale-situations > div { padding-block: 20px; border-bottom: 1px solid #dce2e8; }
  h3 { margin: 0 0 8px; font-size: 19px; line-height: 1.3; }
  .sale-situations p { margin: 0; font-size: 15px; line-height: 1.75; color: #435063; }
  @media (max-width: 900px) { .purchase-layout { gap: 32px; } }
  @media (max-width: 760px) {
    .conditions-section, .fleet-section { padding: 48px 6px; }
    .purchase-layout { grid-template-columns: 1fr; }
    img { aspect-ratio: 1.5; }
    .fleet-section img { object-position: center 70%; }
  }
</style>
