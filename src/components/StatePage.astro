---
import { ArrowRight, MapPin, PhoneCall, Route, Truck } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingContact from "./FloatingContact.astro";
import ScrollAnimations from "./ScrollAnimations.astro";
import HomeProcessSection from "./HomeProcessSection.astro";
import HomeVehicleTypes from "./HomeVehicleTypes.astro";
import { site } from "../data/site";
import { stateGroups } from "../data/cities";
import { absoluteUrl, createBreadcrumbSchema } from "../utils/seo";
import { getLocaleFromPath, localizePath, localizeCityPath, ui } from "../data/i18n";
import { homeCopy } from "../data/home";
import { stateCopy, cityCardText } from "../data/states";

const { group } = Astro.props as { group: (typeof stateGroups)[number] };
const lang = getLocaleFromPath(Astro.url.pathname);
const c = stateCopy(lang, group.name);
const h = homeCopy[lang];
const stateCities = [...group.cities].sort((a, b) => a.name.localeCompare(b.name, "de"));
const topCities = stateCities.slice(0, 12);
const canonical = absoluteUrl(`${localizePath("locations", lang)}/${group.slug}`);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${canonical}#staedte`,
    name: c.heading,
    itemListElement: stateCities.map((city, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `${h.sellIn} ${city.name}`,
      url: absoluteUrl(localizeCityPath(city.slug, lang)),
    })),
  },
  createBreadcrumbSchema([
    { name: ui[lang].home, url: absoluteUrl(localizePath("home", lang)) },
    { name: ui[lang].locations, url: absoluteUrl(localizePath("locations", lang)) },
    { name: group.name, url: canonical },
  ]),
];
---

<BaseLayout
  title={c.title}
  description={c.description}
  canonical={canonical}
  schema={schema}
>
  <Header />

  <main>
    <section class="state-hero">
      <div class="container state-hero-grid">
        <div>
          <span class="state-kicker">{c.kicker}</span>
          <h1>{c.heading}</h1>
          <p>{c.intro}</p>
          <p>{c.note}</p>
          <div class="state-actions">
            <a href={localizePath("contact", lang)} class="btn btn-primary">{ui[lang].startInquiry}</a>
            <a href={`tel:${site.phoneHref}`} class="state-call">
              <PhoneCall size={18} stroke-width={2.4} aria-hidden="true" />
              {h.call}
            </a>
          </div>
        </div>

        <aside class="state-panel" aria-label={c.overview}>
          <div>
            <Truck size={28} stroke-width={2.2} aria-hidden="true" />
            <strong>{stateCities.length}</strong>
            <span>{c.pages}</span>
          </div>
          <div>
            <Route size={28} stroke-width={2.2} aria-hidden="true" />
            <strong>DE</strong>
            <span>{c.worldwide}</span>
          </div>
        </aside>
      </div>
    </section>

    <HomeProcessSection />
    <HomeVehicleTypes />
    <section class="state-cities" aria-labelledby="state-cities-title">
      <div class="container">
        <div class="state-section-head">
          <span>{c.regional}</span>
          <h2 id="state-cities-title">{c.citiesHeading}</h2>
          <p>{c.citiesIntro}</p>
        </div>

        <div class="state-city-grid">
          {stateCities.map((city) => (
            <a href={localizeCityPath(city.slug, lang)} class="state-city-card">
              <MapPin size={19} stroke-width={2.4} aria-hidden="true" />
              <strong>{city.name}</strong>
              <span>{cityCardText(city.cardText, lang)}</span>
              <em>
                {h.sellIn} {city.name}
                <ArrowRight size={15} stroke-width={2.5} aria-hidden="true" />
              </em>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="state-content">
      <div class="container state-content-grid">
        <article>
          <span>{c.purchaseKicker}</span>
          <h2>{c.reachable}</h2>
          <p>{c.reachableText}</p>
        </article>
        <article>
          <span>{c.listKicker}</span>
          <h3>{c.listTitle}</h3>
          <p>{c.alphabetical} {topCities.map((city) => city.name).join(", ")}. {c.listText}</p>
        </article>
      </div>
    </section>

    <section class="state-final">
      <div class="container state-final-panel">
        <div>
          <span>{c.finalKicker}</span>
          <h2>{c.finalTitle}</h2>
          <p>{c.finalText}</p>
        </div>
        <a href={localizePath("contact", lang)} class="btn btn-primary">{ui[lang].startInquiry}</a>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingContact />
  <ScrollAnimations />
</BaseLayout>

<style>
  .state-kicker,
  .state-section-head span,
  .state-content span,
  .state-final-panel span {
    color: var(--orange);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.11em;
  }

  .state-hero {
    padding: clamp(82px, 9vw, 126px) 0 clamp(58px, 7vw, 94px);
    background:
      radial-gradient(circle at 14% 18%, rgba(255,107,0,0.12), transparent 28rem),
      linear-gradient(180deg, #fff, #f5f7fa);
  }

  .state-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 420px);
    gap: clamp(30px, 6vw, 82px);
    align-items: center;
  }

  .state-hero h1 {
    max-width: 880px;
    margin: 16px 0 0;
    color: #111827;
    font-size: clamp(50px, 7vw, 98px);
    line-height: 0.9;
    letter-spacing: -0.08em;
  }

  .state-hero p {
    max-width: 760px;
    margin: 26px 0 0;
    color: #5b6675;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.7;
  }

  .state-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .state-call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: 1px solid rgba(17,24,39,0.12);
    border-radius: 999px;
    background: #fff;
    color: #111827;
    font-weight: 900;
    padding: 15px 23px;
    box-shadow: 0 14px 36px rgba(15,23,42,0.08);
  }

  .state-panel {
    display: grid;
    gap: 14px;
    padding: 18px;
    border-radius: 32px;
    background: #07111f;
    box-shadow: 0 28px 80px rgba(7,17,31,0.18);
  }

  .state-panel div {
    display: grid;
    gap: 8px;
    padding: 24px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px;
    color: #fff;
    background: rgba(255,255,255,0.06);
  }

  .state-panel svg { color: var(--orange); }
  .state-panel strong { font-size: 42px; line-height: 1; letter-spacing: -0.07em; }
  .state-panel span { color: rgba(255,255,255,0.7); font-weight: 780; }

  .state-cities,
  .state-content,
  .state-final {
    padding: clamp(72px, 8vw, 112px) 0;
    background: #fff;
  }

  .state-section-head {
    max-width: 860px;
    margin-bottom: 34px;
  }

  .state-section-head h2,
  .state-content h2,
  .state-final-panel h2 {
    margin: 12px 0 0;
    color: #111827;
    font-size: clamp(36px, 5vw, 66px);
    line-height: 0.98;
    letter-spacing: -0.07em;
  }

  .state-section-head p,
  .state-content p,
  .state-final-panel p {
    color: #5b6675;
    font-size: 17px;
    line-height: 1.75;
  }

  .state-city-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .state-city-card {
    display: grid;
    gap: 10px;
    min-height: 190px;
    padding: 22px;
    border: 1px solid rgba(15,23,42,0.08);
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 18px 48px rgba(15,23,42,0.07);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .state-city-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255,107,0,0.28);
    box-shadow: 0 24px 64px rgba(15,23,42,0.11);
  }

  .state-city-card svg { color: var(--orange); }
  .state-city-card strong { color: #111827; font-size: 23px; letter-spacing: -0.04em; }
  .state-city-card span { color: #5b6675; line-height: 1.55; }
  .state-city-card em {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    color: var(--orange);
    font-style: normal;
    font-size: 14px;
    font-weight: 900;
  }

  .state-content { background: #f5f7fa; }

  .state-content-grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 18px;
  }

  .state-content article,
  .state-final-panel {
    padding: 34px;
    border-radius: 30px;
    background: #fff;
    border: 1px solid rgba(15,23,42,0.08);
    box-shadow: 0 18px 48px rgba(15,23,42,0.07);
  }

  .state-content h3 {
    margin: 12px 0 0;
    color: #111827;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .state-final {
    background: #07111f;
  }

  .state-final-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background:
      radial-gradient(circle at 12% 22%, rgba(255,107,0,0.18), transparent 24rem),
      #0b1726;
    border-color: rgba(255,255,255,0.1);
  }

  .state-final-panel h2 { color: #fff; }
  .state-final-panel p { color: rgba(255,255,255,0.72); }

  @media (max-width: 1020px) {
    .state-city-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .state-content-grid,
    .state-hero-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .state-city-grid { grid-template-columns: 1fr; }
    .state-final-panel { align-items: stretch; flex-direction: column; }
    .state-actions a,
    .state-final-panel a { width: 100%; }
  }
</style>
