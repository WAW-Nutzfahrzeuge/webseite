---
import type { FaqItem } from "../utils/seo";

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

<section class="services-faq-modern">
  <div class="container">
    <div class="services-faq-head" data-animate>
      <span>FAQ</span>
      <h2>Häufige Fragen zum LKW und Nutzfahrzeuge Ankauf</h2>
      <p>
        Kurze Antworten zu Fahrzeugarten, Schäden, TÜV, Fuhrparks und den
        wichtigsten Daten für Ihre Anfrage.
      </p>
    </div>

    <div class="services-faq-grid">
      {faqs.map((faq, index) => (
        <details class="services-faq-item" data-services-faq data-animate open={index === 0}>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const servicesFaqItems = document.querySelectorAll<HTMLDetailsElement>("[data-services-faq]");

  servicesFaqItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      servicesFaqItems.forEach((other) => {
        if (other !== item) other.removeAttribute("open");
      });
    });
  });
</script>

<style>
  .services-faq-modern {
    padding: clamp(74px, 8vw, 112px) 0;
    background: linear-gradient(180deg, #f6f7f9, #fff);
  }

  .services-faq-head {
    max-width: 820px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .services-faq-head span {
    color: var(--orange);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.11em;
  }

  .services-faq-head h2 {
    margin: 14px 0 0;
    color: #111827;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1;
    letter-spacing: -0.065em;
  }

  .services-faq-head p {
    max-width: 680px;
    margin: 16px auto 0;
    color: #5b6675;
    font-size: 17px;
    line-height: 1.7;
  }

  .services-faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 14px;
    max-width: 1160px;
    margin: 0 auto;
  }

  .services-faq-item {
    height: fit-content;
    overflow: hidden;
    border: 1px solid rgba(17,24,39,0.08);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 16px 42px rgba(15,23,42,0.055);
  }

  .services-faq-item summary {
    position: relative;
    cursor: pointer;
    list-style: none;
    color: #111827;
    font-size: 16px;
    font-weight: 900;
    line-height: 1.35;
    padding: 22px 58px 22px 24px;
  }

  .services-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .services-faq-item summary::after {
    content: "+";
    position: absolute;
    top: 50%;
    right: 18px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--orange);
    color: #fff;
    font-size: 22px;
    transform: translateY(-50%);
  }

  .services-faq-item[open] summary::after {
    content: "-";
  }

  .services-faq-item p {
    margin: -4px 24px 24px;
    color: #5b6675;
    line-height: 1.7;
  }

  @media (max-width: 780px) {
    .services-faq-modern {
      padding: 64px 0;
    }

    .services-faq-grid {
      grid-template-columns: 1fr;
    }

    .services-faq-head h2 {
      font-size: clamp(34px, 11vw, 46px);
    }
  }
</style>
