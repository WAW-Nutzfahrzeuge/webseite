---
import { Send } from "@lucide/astro";
import { contactCopy } from "../data/contact";
import { getLocaleFromPath, localizePath } from "../data/i18n";

const lang = getLocaleFromPath(Astro.url.pathname);
const copy = contactCopy[lang];
const { title = copy.title, compact = false } = Astro.props;
const source = Astro.url.pathname;
const fields = ["email", "vehicle", "location", "condition"] as const;
const additionalFields = ["company", "year", "mileage"] as const;
---

<form class="contact-lead-form" id="kontaktformular" data-contact-form data-error={copy.error} data-validation={copy.validation} data-sending={copy.sending} data-submit={copy.submit}>
  <h2>{title}</h2>
  <p>{copy.intro}</p>
  <div class="form-grid">
    <label>
      <span>{copy.labels.name}</span>
      <input name="name" autocomplete="name" minlength="2" maxlength="80" required />
    </label>
    <label>
      <span>{copy.labels.phone}</span>
      <input name="phone" type="tel" autocomplete="tel" maxlength="40" required />
    </label>
    {!compact && fields.map((name) => (
      <label>
        <span>{copy.labels[name]}</span>
        <input name={name} type={name === "email" ? "email" : "text"} autocomplete={name === "email" ? "email" : undefined} maxlength={name === "email" ? 254 : 140} placeholder={name === "vehicle" ? copy.vehicleHint : name === "condition" ? copy.conditionHint : undefined} />
      </label>
    ))}
  </div>
  {!compact && (
    <details class="additional-fields">
      <summary>{copy.details}</summary>
      <div class="form-grid">
        {additionalFields.map((name) => (
          <label>
            <span>{copy.labels[name]}</span>
            <input name={name} autocomplete={name === "company" ? "organization" : undefined} inputmode={name === "year" ? "numeric" : undefined} maxlength={name === "company" ? 100 : 40} />
          </label>
        ))}
      </div>
    </details>
  )}
  <label class="message-field">
    <span>{copy.labels.message}</span>
    <textarea name="message" rows={compact ? 3 : 4} maxlength="2500"></textarea>
  </label>
  <p class="form-help">{copy.attachments}</p>
  <input type="text" name="website" class="form-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="formStartedAt" data-form-started-at />
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="locale" value={lang} />
  <button type="submit"><span>{copy.submit}</span><Send size={18} aria-hidden="true" /></button>
  <p class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1"></p>
  <p class="form-privacy">{copy.privacy} <a href={localizePath("privacy", lang)}>{copy.privacyLink}</a></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    const status = form.querySelector<HTMLElement>("[data-form-status]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const buttonText = button.querySelector("span")!;
    const startedAt = form.querySelector<HTMLInputElement>("[data-form-started-at]")!;
    startedAt.value = String(Date.now());

    form.addEventListener("input", (event) => {
      if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) {
        event.target.setCustomValidity("");
        event.target.removeAttribute("aria-invalid");
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (button.disabled || !form.reportValidity()) return;
      status.textContent = "";
      button.disabled = true;
      buttonText.textContent = form.dataset.sending!;
      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const result: { success?: boolean; redirectTo?: string; error?: string; errors?: Record<string, string> } = await response.json();
        if (!response.ok || !result.success) {
          let firstInvalid: HTMLInputElement | HTMLTextAreaElement | undefined;
          for (const [name, message] of Object.entries(result.errors || {})) {
            const input = form.elements.namedItem(name);
            if (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) {
              input.closest("details")?.setAttribute("open", "");
              input.setCustomValidity(message);
              input.setAttribute("aria-invalid", "true");
              firstInvalid ||= input;
            }
          }
          status.textContent = Object.values(result.errors || {}).join(" ") || result.error || form.dataset.error!;
          if (firstInvalid) {
            firstInvalid.focus();
            firstInvalid.reportValidity();
          } else status.focus();
          return;
        }
        window.location.assign(result.redirectTo || "/danke");
      } catch {
        status.textContent = form.dataset.error!;
        status.focus();
      } finally {
        button.disabled = false;
        buttonText.textContent = form.dataset.submit!;
        startedAt.value = String(Date.now());
      }
    });
  });
</script>

<style>
  .contact-lead-form { min-width: 0; padding: clamp(22px, 3vw, 34px); border-radius: 16px; background: var(--navy-deep); color: #fff; scroll-margin-top: 110px; }
  h2 { margin: 0 0 16px; font-size: clamp(26px, 3vw, 38px); line-height: 1.15; letter-spacing: -0.025em; color: #fff; }
  p { line-height: 1.6; color: #d3deeb; }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  label { display: grid; gap: 8px; min-width: 0; font-size: 15px; }
  input, textarea { min-width: 0; width: 100%; padding: 14px; border: 1px solid #718299; border-radius: 8px; background: #14283f; color: #fff; font: inherit; font-size: 16px; }
  input::placeholder { color: #bdc9d8; }
  input[aria-invalid=true], textarea[aria-invalid=true] { border-color: #ffb5a8; }
  textarea { resize: vertical; }
  .additional-fields { margin-top: 20px; }
  summary { cursor: pointer; padding: 12px 0; }
  .message-field { margin-top: 18px; }
  .form-help, .form-privacy { font-size: 14px; }
  .form-privacy a { text-decoration: underline; }
  button { display: flex; align-items: center; justify-content: center; gap: 12px; width: 100%; padding: 16px; border: 0; border-radius: 10px; background: var(--orange); color: var(--navy-deep); font: inherit; font-weight: 800; cursor: pointer; }
  button:disabled { opacity: 0.7; cursor: wait; }
  .form-status { color: #ffb5a8; }
  .form-status:empty { display: none; }
  .form-hp { position: absolute; left: -10000px; width: 1px; height: 1px; }
  @media (max-width: 680px) { .form-grid { grid-template-columns: 1fr; } }
</style>
