---
import "../styles/global.css";
import { site } from "../data/site";
import { createLocalBusinessSchema } from "../utils/seo";
import { getAlternates, getLocaleFromPath } from "../data/i18n";

const {
    title = "WAW Nutzfahrzeuge",
    description = "",
    canonical = "",
    schema = [],
    lang = getLocaleFromPath(Astro.url.pathname)
} = Astro.props;

const currentLang = lang;
const schemaItems = [
    createLocalBusinessSchema(),
    ...(Array.isArray(schema) ? schema : [schema]),
].filter(Boolean);

const alternateLinks = getAlternates(Astro.url.pathname).map((item) => ({
    hreflang: item.locale,
    href: new URL(item.href, site.url).toString(),
}));
const defaultAlternate = alternateLinks.find((item) => item.hreflang === "de");
---

<!doctype html>
<html lang={currentLang}>
<head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {canonical && <link rel="canonical" href={canonical} />}
    {alternateLinks.map((item) => (
        <link rel="alternate" hreflang={item.hreflang} href={item.href} />
    ))}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.wawnutzfahrzeuge.de/og-image.png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.wawnutzfahrzeuge.de/og-image.png" />

    <slot name="head" />

    {schemaItems.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
</head>

<body>
<a class="skip-link" href="#main-content">{currentLang === "en" ? "Skip to content" : currentLang === "fr" ? "Aller au contenu" : "Zum Inhalt"}</a>

<slot />
<script>
    const main = document.querySelector("main");
    if (main) {
        main.id = "main-content";
        main.tabIndex = -1;
    }
</script>
</body>
</html>

<style>
    body {
        position: relative;
        overflow-x: hidden;
    }

</style>
