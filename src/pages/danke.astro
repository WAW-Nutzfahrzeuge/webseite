---
import { MessageCircle, PhoneCall } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingContact from "../components/FloatingContact.astro";
import { site } from "../data/site";
import { absoluteUrl, createBreadcrumbSchema } from "../utils/seo";

const canonical = absoluteUrl("/danke");
const schema = createBreadcrumbSchema([
  { name: "Startseite", url: absoluteUrl("/") },
  { name: "Danke", url: canonical },
]);
---

<BaseLayout
  title="Vielen Dank für Ihre Anfrage | WAW Nutzfahrzeuge"
  description="Ihre Anfrage wurde an WAW Nutzfahrzeuge übermittelt. Wir melden uns schnellstmöglich zur weiteren Abstimmung."
  canonical={canonical}
  schema={schema}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
  </Fragment>

  <Header />

  <main>
    <section class="thanks-section">
      <div class="container thanks-panel">
        <span>ANFRAGE GESENDET</span>
        <h1>Vielen Dank. Ihre Anfrage ist eingegangen.</h1>
        <p>
          Wir haben Ihre Angaben erhalten und melden uns schnellstmöglich bei Ihnen.
          Falls Sie zusätzliche Fotos oder Unterlagen senden möchten, können Sie
          uns direkt per WhatsApp oder Telefon erreichen.
        </p>

        <div class="thanks-actions">
          <a href={site.whatsappHref} target="_blank" rel="noopener" class="btn btn-primary">
            <MessageCircle size={18} stroke-width={2.4} aria-hidden="true" />
            WhatsApp schreiben
          </a>
          <a href={`tel:${site.phoneHref}`} class="thanks-call">
            <PhoneCall size={18} stroke-width={2.4} aria-hidden="true" />
            Direkt anrufen
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingContact />
</BaseLayout>

<style>
  .thanks-section {
    padding: clamp(108px, 12vw, 168px) 0 clamp(78px, 9vw, 120px);
    background:
      radial-gradient(circle at 16% 22%, rgba(255,107,0,0.12), transparent 26rem),
      radial-gradient(circle at 82% 12%, rgba(7,26,51,0.12), transparent 28rem),
      linear-gradient(180deg, #fff, #f5f7fa);
  }

  .thanks-panel {
    max-width: 980px;
    padding: clamp(32px, 5vw, 58px);
    border: 1px solid rgba(17,24,39,0.08);
    border-radius: 34px;
    background: #fff;
    box-shadow: 0 28px 86px rgba(15,23,42,0.12);
  }

  .thanks-panel span {
    color: var(--orange);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.11em;
  }

  .thanks-panel h1 {
    max-width: 820px;
    margin: 16px 0 0;
    color: #111827;
    font-size: clamp(42px, 6vw, 82px);
    line-height: 0.95;
    letter-spacing: -0.078em;
  }

  .thanks-panel p {
    max-width: 720px;
    margin: 24px 0 0;
    color: #5b6675;
    font-size: 18px;
    line-height: 1.75;
  }

  .thanks-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .thanks-actions .btn,
  .thanks-call {
    gap: 9px;
  }

  .thanks-call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(17,24,39,0.12);
    border-radius: 999px;
    background: #fff;
    color: #111827;
    font-weight: 900;
    padding: 15px 23px;
    box-shadow: 0 14px 36px rgba(15,23,42,0.08);
    transition: transform 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .thanks-call:hover {
    transform: translateY(-3px);
    border-color: rgba(255,107,0,0.34);
    color: var(--orange);
  }

  @media (max-width: 680px) {
    .thanks-section {
      padding: 92px 0 72px;
    }

    .thanks-panel {
      border-radius: 24px;
    }

    .thanks-actions,
    .thanks-actions .btn,
    .thanks-call {
      width: 100%;
    }
  }
</style>
