---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import FloatingContact from "../components/FloatingContact.astro";
import Footer from "../components/Footer.astro";
import HomeFAQ from "../components/HomeFAQ.astro";
import CitySection from "../components/CitySection.astro";
import HomeVehicleTypes from "../components/HomeVehicleTypes.astro";
import HomeProcessSection from "../components/HomeProcessSection.astro";
import CustomerReviews from "../components/CustomerReviews.astro";
import HomePurchaseSections from "../components/HomePurchaseSections.astro";
import HomeContactSection from "../components/HomeContactSection.astro";
import { createFaqSchema } from "../utils/seo";
import { homeFaqs } from "../data/homeFaqs";
---

<BaseLayout
  title="LKW & Nutzfahrzeuge verkaufen | WAW Nutzfahrzeuge"
  description="LKW, Auflieger, Anhänger, Transporter, Baumaschinen oder Fuhrpark verkaufen? WAW kauft gewerbliche Nutzfahrzeuge weltweit an."
  canonical="https://www.wawnutzfahrzeuge.de/"
  schema={createFaqSchema(homeFaqs)}
>
  <Header />
  <main>
    <Hero />
    <HomeProcessSection />
    <HomeVehicleTypes>
      <picture slot="vehicle-image">
        <source media="(max-width: 760px)" srcset="/images/waw_real_1_mobile.webp" width="1024" height="1536" />
        <img src="/images/waw_real_1.webp" alt="Sattelzugmaschinen vor dem Gebäude von WAW Nutzfahrzeuge" width="1448" height="1086" loading="lazy" />
      </picture>
    </HomeVehicleTypes>
    <HomePurchaseSections>
      <CitySection slot="before-fleet" />
    </HomePurchaseSections>
    <CustomerReviews />
    <HomeContactSection />
    <HomeFAQ />
  </main>

  <Footer />
  <FloatingContact />
</BaseLayout>
