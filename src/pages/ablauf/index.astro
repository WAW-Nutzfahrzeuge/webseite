---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FloatingContact from "../../components/FloatingContact.astro";
import ScrollAnimations from "../../components/ScrollAnimations.astro";
import AblaufHero from "../../components/AblaufHero.astro";
import AblaufSteps from "../../components/AblaufSteps.astro";
import AblaufBenefits from "../../components/AblaufBenefits.astro";
import AblaufInfo from "../../components/AblaufInfo.astro";
import AblaufFAQ from "../../components/AblaufFAQ.astro";
import AblaufCTA from "../../components/AblaufCTA.astro";
import { absoluteUrl, createBreadcrumbSchema, createFaqSchema } from "../../utils/seo";

const canonical = absoluteUrl("/ablauf");

const faqs = [
    {
        question: "Wie schnell bekomme ich eine Rückmeldung?",
        answer: "Sobald Ihre Fahrzeugdaten bei uns eingehen, melden wir uns zeitnah zurück. Je vollständiger Ihre Angaben und Fotos sind, desto konkreter fällt unsere Einschätzung aus.",
    },
    {
        question: "Entstehen mir Kosten?",
        answer: "Nein. Ihre Anfrage und die erste Abstimmung sind unverbindlich. Falls im weiteren Verlauf etwas zu klären ist, besprechen wir das vorab transparent mit Ihnen.",
    },
    {
        question: "Kauft WAW auch Fahrzeuge mit Schäden?",
        answer: "Ja. Sie können uns auch LKW, Auflieger, Transporter, Baumaschinen und Fuhrparks mit Schäden, hoher Laufleistung oder älteren Baujahren anbieten.",
    },
    {
        question: "Wie wird bezahlt?",
        answer: "Die Zahlung erfolgt schnell und sicher nach Einigung und Fahrzeugübergabe. Alle Details stimmen wir vorher klar mit Ihnen ab.",
    },
    {
        question: "Welche Unterlagen brauche ich?",
        answer: "Hilfreich sind Fahrzeugschein, Fahrzeugbrief, vorhandene Wartungsunterlagen, TÜV-Berichte und aussagekräftige Fotos. Für den ersten Kontakt reichen aber auch Fahrzeugtyp, Standort und Ihre Kontaktdaten.",
    },
    {
        question: "Muss ich das Fahrzeug selbst anliefern?",
        answer: "Nein, nicht zwingend. Nach der Einigung koordinieren wir die Übergabe oder eine mögliche Abholung zum passenden Termin - deutschland- und europaweit.",
    },
];

const schema = [
    createBreadcrumbSchema([
        { name: "Startseite", url: absoluteUrl("/") },
        { name: "Ablauf", url: canonical },
    ]),
    createFaqSchema(faqs),
];
---

<BaseLayout
    title="Ablauf | LKW und Nutzfahrzeug verkaufen | WAW Nutzfahrzeuge"
    description="So verkaufen Sie Ihren LKW oder Ihr Nutzfahrzeug an WAW: Fahrzeugdaten senden, Rückmeldung erhalten, Angebot abstimmen, Zahlung und Übergabe oder Abholung klären."
    canonical={canonical}
    schema={schema}
>
    <Header transparent />

    <main>
        <AblaufHero />
        <AblaufSteps />
        <AblaufBenefits />
        <AblaufInfo />
        <AblaufFAQ faqs={faqs} />
        <AblaufCTA />
    </main>

    <Footer />
    <FloatingContact />
    <ScrollAnimations />
</BaseLayout>
