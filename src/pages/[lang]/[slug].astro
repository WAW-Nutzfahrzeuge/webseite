---
import LocationsPage from "../../components/LocationsPage.astro";
import ServicesPage from "../../components/ServicesPage.astro";
import AboutPage from "../../components/AboutPage.astro";
import LegalNoticePage from "../../components/LegalNoticePage.astro";
import PrivacyPage from "../../components/PrivacyPage.astro";
import TermsPage from "../../components/TermsPage.astro";
import {
  locales,
  routeMap,
  routeSlugAliases,
  type StaticRouteKey,
  type Locale,
} from "../../data/i18n";

type SharedRouteKey = Exclude<StaticRouteKey, "vehicles" | "process" | "contact">;

export function getStaticPaths() {
  const staticPaths: Array<{
    params: { lang: Locale; slug: string };
    props: { lang: Locale; pageKey: StaticRouteKey };
  }> = [];

  for (const lang of locales.filter((locale) => locale !== "de")) {
    for (const key of Object.keys(routeSlugAliases) as StaticRouteKey[]) {
      if (key === "vehicles" || key === "process" || key === "contact") continue;

      const canonicalSlug = routeMap[key][lang].split("/").filter(Boolean).at(-1);
      const slugs = new Set([canonicalSlug, ...routeSlugAliases[key]].filter(Boolean) as string[]);

      for (const slug of slugs) {
        staticPaths.push({
          params: { lang, slug },
          props: { lang, pageKey: key },
        });
      }
    }
  }

  return staticPaths;
}

const { lang, pageKey } = Astro.props as {
  lang: Locale;
  pageKey: SharedRouteKey;
};
const canonicalPath = routeMap[pageKey][lang];
if (Astro.url.pathname.replace(/\/$/, "") !== canonicalPath) {
  return Astro.redirect(canonicalPath, 301);
}
const Page = {
  locations: LocationsPage,
  services: ServicesPage,
  about: AboutPage,
  legalNotice: LegalNoticePage,
  privacy: PrivacyPage,
  terms: TermsPage,
}[pageKey];
---

<Page lang={lang} />
