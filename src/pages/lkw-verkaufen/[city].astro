---
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FloatingContact from "../../components/FloatingContact.astro";
import LeadForm from "../../components/LeadForm.astro";
import HomeProcessSection from "../../components/HomeProcessSection.astro";
import HomeVehicleTypes from "../../components/HomeVehicleTypes.astro";
import { cities, indexableCitySlugs } from "../../data/cities";
import { absoluteUrl, createBreadcrumbSchema, createFaqSchema } from "../../utils/seo";
import { getCityImage, getMobileCityImage } from "../../utils/cityImages";

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}
const { city } = Astro.props;
const cityImage = getCityImage(city.name, city.slug);
const mobileCityImage = getMobileCityImage(city.name, city.slug);
const heroImage = cityImage
  ? await getImage({ src: cityImage, width: 1600, format: "webp", quality: 75 })
  : null;
const mobileHeroImage = mobileCityImage
  ? await getImage({ src: mobileCityImage, width: 850, format: "webp", quality: 75 })
  : null;
const canonical = absoluteUrl(`/lkw-verkaufen/${city.slug}`);
const nearby = cities.filter((entry) => city.nearbyCities.includes(entry.name));
const schema = [
  createFaqSchema(city.faq),
  createBreadcrumbSchema([{ name: "Startseite", url: absoluteUrl("/") }, { name: "Ankaufgebiete", url: absoluteUrl("/standorte") }, { name: city.name, url: canonical }]),
];
---
<BaseLayout title={city.metaTitle} description={city.metaDescription} canonical={canonical} schema={schema}>
  {!indexableCitySlugs.has(city.slug) && <Fragment slot="head"><meta name="robots" content="noindex,follow" /></Fragment>}
  <Header />
  <main>
    <section class="city-hero">
      <div class="container city-grid">
        <div class="city-intro">
          <picture class="city-hero-background" aria-hidden="true">
            {mobileHeroImage && <source media="(max-width: 850px)" srcset={mobileHeroImage.src} />}
            <img src={heroImage?.src ?? "/images/hero-yard-sunset.png"} alt="" width={heroImage?.attributes.width} height={heroImage?.attributes.height} fetchpriority="high" />
          </picture>
          <h1>LKW verkaufen in {city.name}</h1>
          <p>Sie möchten einen LKW, eine Sattelzugmaschine, einen Auflieger, Anhänger, Transporter, eine Baumaschine oder einen Fuhrpark in {city.name} verkaufen? Bieten Sie uns Ihr Fahrzeug unverbindlich an.</p>
          <p>Auch mit Motor-, Getriebe- oder Unfallschaden, hoher Laufleistung, älterem Baujahr, ohne HU oder nicht fahrbereit ist eine Anfrage möglich. Wir prüfen anhand Ihrer Angaben, ob ein Ankauf infrage kommt.</p>
          <p class="coverage-note">Unser Unternehmensstandort ist Talkau. {city.name} ist Teil unseres Ankaufgebiets; diese Seite beschreibt keine Niederlassung vor Ort.</p>
          <a class="btn btn-primary" href="#kontaktformular">Fahrzeug unverbindlich anbieten</a>
        </div>
        <div class="city-form"><LeadForm compact /></div>
      </div>
    </section>
    <HomeProcessSection />
    <HomeVehicleTypes />
    <section class="section">
      <div class="container city-grid">
        <div>
          <h2>Fahrzeugstandort und Übergabe in {city.name} abstimmen</h2>
          {indexableCitySlugs.has(city.slug) && <p>{city.localFocus}</p>}
          <p>Nennen Sie uns den tatsächlichen Abstellort in {city.name} oder Umgebung sowie die Fahrbereitschaft. Hilfreich sind auch Hinweise zur Zufahrt, Verladung und zu vorhandenen Fahrzeugpapieren. Transport und mögliche Abholung vereinbaren wir individuell – auch bei nicht fahrbereiten Fahrzeugen.</p>
          <p>Für den ersten Kontakt reichen Name und Telefonnummer. Weitere Angaben und Fotos können Sie nachreichen. <a href="/kontakt">Kontaktmöglichkeiten und E-Mail-Adresse</a></p>
          <p><a href="/leistungen">Diese Fahrzeugtypen und Zustände können Sie anbieten</a></p>
        </div>
        <div>
          <h2>Ein Fahrzeug oder mehrere Standorte?</h2>
          <p>Ob Fahrzeugwechsel, Schaden, Flottenerneuerung oder Fuhrparkverkleinerung: Beschreiben Sie kurz, was Sie verkaufen möchten. Bei mehreren Fahrzeugen helfen Anzahl, Fahrzeugarten, Zustände und Standorte. Eine vollständige Liste ist keine Voraussetzung.</p>
          <p>Wir prüfen Ihre Angaben und klären offene Fragen. Ist ein Ankauf möglich, stimmen wir Angebot, Zahlungsart, Zahlungszeitpunkt und Übergabe vor dem Verkauf mit Ihnen ab.</p>
          <a href="/ablauf">Der Verkaufsablauf im Detail</a>
        </div>
      </div>
    </section>
    <section class="section city-faq">
      <div class="container">
        <h2>Fragen zum Fahrzeugverkauf in {city.name}</h2>
        {city.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        <nav class="regional-links" aria-label="Weitere Ankaufgebiete">
          <a href="/standorte">Alle Ankaufgebiete</a>
          {nearby.map((entry) => <a href={`/lkw-verkaufen/${entry.slug}`}>LKW verkaufen in {entry.name}</a>)}
        </nav>
      </div>
    </section>
  </main>
  <Footer /><FloatingContact />
</BaseLayout>
<style>
  .city-hero {
    position: relative;
    isolation: isolate;
    padding: 140px 0 64px;
    background: var(--navy);
    color: #fff;
  }
  .city-hero-background { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .city-hero-background img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center right; }
  .city-hero-background::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(3, 10, 20, 0.66) 0%, rgba(5, 15, 30, 0.54) 44%, rgba(5, 15, 30, 0.18) 100%);
  }
  .city-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  h1 { margin: 0 0 24px; font-size: clamp(36px, 4.3vw, 64px); line-height: 1.1; letter-spacing: -0.03em; }
  h2 { margin: 0 0 20px; font-size: clamp(26px, 2.7vw, 40px); line-height: 1.2; }
  p { line-height: 1.75; max-width: 72ch; }
  .coverage-note { color: #c8d6e8; font-size: 15px; }
  .city-hero .btn { margin-top: 12px; }
  .section a:not(.btn) { text-decoration: underline; text-underline-offset: 3px; }
  .city-faq { background: #fff; }
  details { max-width: 900px; border-bottom: 1px solid #d5dce5; padding: 20px 0; }
  summary { cursor: pointer; font-weight: 700; line-height: 1.5; }
  .regional-links { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 32px; }
  @media (max-width: 850px) {
    .city-grid { grid-template-columns: 1fr; }
    .city-hero { padding: 0; background: var(--bg); }
    .city-hero > .city-grid { width: 100%; gap: 0; }
    .city-intro { position: relative; isolation: isolate; padding: 140px max(14px, calc((100% - 778px) / 2)) 40px; }
    .city-form { width: min(778px, calc(100% - 28px)); margin-inline: auto; padding-block: 32px; }
    .city-hero-background img { object-position: center top; }
  }
</style>
