---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FloatingContact from "../../components/FloatingContact.astro";
import ScrollAnimations from "../../components/ScrollAnimations.astro";
import ContactHero from "../../components/ContactHero.astro";
import ContactMethods from "../../components/ContactMethods.astro";
import ContactBenefits from "../../components/ContactBenefits.astro";
import ContactMapSection from "../../components/ContactMapSection.astro";
import ContactFAQ from "../../components/ContactFAQ.astro";
import ContactCallBar from "../../components/ContactCallBar.astro";
import { site } from "../../data/site";
import { absoluteUrl, createBreadcrumbSchema, createFaqSchema } from "../../utils/seo";

const faqs = [
  {
    question: "Wie schnell melden Sie sich zurück?",
    answer:
      "In der Regel melden wir uns nach Eingang Ihrer Anfrage zeitnah bei Ihnen. Je vollständiger Ihre Angaben und Fotos sind, desto genauer können wir antworten.",
  },
  {
    question: "Welche Angaben sollte ich mitsenden?",
    answer:
      "Hilfreich sind Fahrzeugtyp, Marke, Modell, Baujahr, Kilometerstand, Zustand, Standort sowie Fotos oder Unterlagen. Wenn noch nicht alles vorliegt, reichen für den Start auch Ihre Kontaktdaten.",
  },
  {
    question: "Kann ich mein Fahrzeug auch per WhatsApp anbieten?",
    answer:
      "Ja. Sie können uns Fahrzeugdaten, Fotos und kurze Infos direkt per WhatsApp senden. Die nächsten Schritte besprechen wir anschließend persönlich mit Ihnen.",
  },
  {
    question: "Ist meine Anfrage unverbindlich?",
    answer:
      "Ja. Ihre Anfrage und die erste Abstimmung sind unverbindlich. Alles Weitere klären wir direkt mit Ihnen.",
  },
  {
    question: "Kann ich mehrere Fahrzeuge oder einen ganzen Fuhrpark anbieten?",
    answer:
      "Ja. Wir kaufen einzelne Nutzfahrzeuge genauso wie komplette Fuhrparks von Unternehmen, Händlern und Fuhrparkbetreibern.",
  },
  {
    question: "Kann ich Fotos und Unterlagen mitsenden?",
    answer:
      "Ja. Fotos, Fahrzeugschein, Wartungsnachweise oder weitere Unterlagen helfen uns, Ihre Anfrage schneller einzuordnen.",
  },
];

const canonical = absoluteUrl("/kontakt");
const schema = [
  createFaqSchema(faqs),
  createBreadcrumbSchema([
    { name: "Startseite", url: absoluteUrl("/") },
    { name: "Kontakt", url: canonical },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": `${canonical}#contact`,
    url: canonical,
    name: "Kontakt | WAW Nutzfahrzeuge",
    description:
      "Kontaktseite für den unverbindlichen Ankauf von LKW, Nutzfahrzeugen, Aufliegern, Anhängern, Transportern, Baumaschinen und Fuhrparks.",
    mainEntity: {
      "@type": "AutoDealer",
      "@id": `${site.url}/#localbusiness`,
      name: site.name,
      telephone: site.phoneDisplay,
      email: site.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: site.address.street,
        postalCode: site.address.postalCode,
        addressLocality: site.address.locality,
        addressRegion: site.address.region,
        addressCountry: site.address.country,
      },
      contactPoint: {
        "@type": "ContactPoint",
        telephone: site.phoneDisplay,
        email: site.email,
        contactType: "sales",
        areaServed: "DE",
        availableLanguage: ["de"],
      },
    },
  },
];
---

<BaseLayout
  title="Kontakt | Fahrzeug anbieten | WAW Nutzfahrzeuge"
    description="Kontaktieren Sie WAW per Formular, WhatsApp oder Telefon und bieten Sie LKW, Nutzfahrzeuge, Auflieger, Anhänger, Transporter, Baumaschinen oder Fuhrparks unverbindlich an."
  canonical={canonical}
  schema={schema}
>
  <Header transparent />

  <main>
    <ContactHero />
    <ContactMethods />
    <ContactBenefits />
    <ContactMapSection />
    <ContactFAQ faqs={faqs} />
    <ContactCallBar />
  </main>

  <Footer />
  <FloatingContact />
  <ScrollAnimations />
</BaseLayout>
