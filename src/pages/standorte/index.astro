---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FloatingContact from "../../components/FloatingContact.astro";
import HomeProcessSection from "../../components/HomeProcessSection.astro";
import HomeVehicleTypes from "../../components/HomeVehicleTypes.astro";
import { cities, stateGroups } from "../../data/cities";
import { absoluteUrl, createBreadcrumbSchema } from "../../utils/seo";

const sortedCities = [...cities].sort((a, b) => a.name.localeCompare(b.name, "de"));
---
<BaseLayout title="Ankaufgebiete | LKW weltweit verkaufen | WAW" description="WAW kauft Nutzfahrzeuge weltweit an. Unternehmensstandort Talkau, regionale Ankaufgebiete und direkte Kontaktmöglichkeiten." canonical={absoluteUrl("/standorte")} schema={createBreadcrumbSchema([{ name: "Startseite", url: absoluteUrl("/") }, { name: "Ankaufgebiete", url: absoluteUrl("/standorte") }])}>
  <Header />
  <main>
    <section class="coverage-hero">
      <div class="container">
        <h1>LKW verkaufen – weltweit</h1>
        <p>Unser Unternehmensstandort ist Talkau in Schleswig-Holstein. Die hier aufgeführten Städte und Regionen beschreiben unsere Ankaufgebiete, keine weiteren Niederlassungen.</p>
        <p>Auch außerhalb der aufgeführten Orte können Sie uns einzelne Nutzfahrzeuge, Fahrzeugpakete und Fuhrparks anbieten. Geben Sie den Fahrzeugstandort und bekannte Schäden an. Übergabe, Transport und mögliche Abholung stimmen wir individuell mit Ihnen ab.</p>
        <a class="btn btn-primary" href="/kontakt#kontaktformular">Fahrzeug unverbindlich anbieten</a>
      </div>
    </section>
    <section class="section" aria-labelledby="city-search-title">
      <div class="container">
        <h2 id="city-search-title">Ihr Ankaufgebiet finden</h2>
        <label for="city-search">Stadt oder Bundesland suchen</label>
        <input id="city-search" type="search" placeholder="z. B. Hamburg, Neumünster oder Bayern" autocomplete="off" />
        <p id="city-count" role="status" aria-live="polite">Ausgewählte Städte. Die Suche berücksichtigt alle {cities.length} vorhandenen Stadtseiten.</p>
        <div class="city-results">
          {sortedCities.map((city) => (
            <a href={`/lkw-verkaufen/${city.slug}`} data-city-result data-search={`${city.name} ${city.state}`} data-initial={String(city.showInNavigation)} hidden={!city.showInNavigation}>
              <strong>LKW verkaufen in {city.name}</strong><span>{city.state}</span>
            </a>
          ))}
        </div>
        <noscript><p>Ohne JavaScript finden Sie alle Städte über die folgenden Bundesländer.</p></noscript>
      </div>
    </section>
    <section class="section state-section" aria-labelledby="state-list-title">
      <div class="container">
        <h2 id="state-list-title">Ankaufgebiete nach Bundesland</h2>
        <div class="state-links">{stateGroups.map((state) => <a href={`/standorte/${state.slug}`}>{state.name}</a>)}</div>
        <p>Sie möchten mehrere Fahrzeuge an unterschiedlichen Standorten verkaufen? Nennen Sie uns die Orte und den Umfang Ihres Fuhrparks. Eine erste Anfrage ist auch ohne vollständige Fahrzeugliste möglich.</p>
        <a href="/ablauf">So stimmen wir Angebot, Zahlung und Übergabe ab</a>
      </div>
    </section>
    <HomeProcessSection />
    <HomeVehicleTypes />
  </main>
  <Footer /><FloatingContact />
</BaseLayout>
<script>
  const search = document.querySelector<HTMLInputElement>("#city-search")!;
  const results = document.querySelectorAll<HTMLAnchorElement>("[data-city-result]");
  const count = document.querySelector<HTMLElement>("#city-count")!;
  const normalize = (value: string) => value.toLocaleLowerCase("de").normalize("NFD").replace(/\p{Diacritic}/gu, "").replace(/ß/g, "ss");
  search.addEventListener("input", () => {
    const query = normalize(search.value.trim());
    let matches = 0;
    results.forEach((result) => {
      const visible = query ? normalize(result.dataset.search || "").includes(query) : result.dataset.initial === "true";
      result.hidden = !visible;
      if (visible) matches++;
    });
    count.textContent = matches ? `${matches} ${query ? "passende" : "ausgewählte"} Städte. Anfragen aus anderen Orten sind ebenfalls möglich.` : "Keine passende Stadtseite gefunden. Sie können Ihr Fahrzeug trotzdem direkt über unser Kontaktformular anbieten.";
  });
</script>
<style>
  .coverage-hero { padding: 140px 0 64px; background: var(--navy); color: #fff; }
  h1 { max-width: 24ch; font-size: clamp(36px, 4.5vw, 68px); line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 24px; }
  h2 { font-size: clamp(28px, 3vw, 42px); line-height: 1.15; margin: 0 0 24px; }
  p { max-width: 75ch; line-height: 1.75; }
  label { display: block; font-weight: 700; margin-bottom: 10px; }
  input { width: min(100%, 620px); font-size: 16px; padding: 16px; border: 1px solid #718299; border-radius: 8px; background: #fff; color: var(--text); }
  .city-results, .state-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 28px 0; }
  .city-results a, .state-links a { padding: 20px; background: #fff; border: 1px solid #d5dce5; border-radius: 12px; }
  .city-results a[hidden] { display: none; }
  .city-results span { display: block; margin-top: 8px; color: var(--muted); }
  .state-section { background: #e8edf3; }
  .state-section > div > a { text-decoration: underline; font-weight: 700; }
  @media (max-width: 800px) { .city-results, .state-links { grid-template-columns: 1fr; } }
</style>
