---
import {
  ArrowRight,
  BadgeEuro,
  Building2,
  CircleCheck,
  ClockCheck,
  MapPin,
  MessageCircle,
  PhoneCall,
  Route,
  ShieldCheck,
  Truck,
} from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FloatingContact from "../../components/FloatingContact.astro";
import ScrollAnimations from "../../components/ScrollAnimations.astro";
import { navigationCities, stateGroups } from "../../data/cities";
import { site } from "../../data/site";
import { absoluteUrl, createBreadcrumbSchema, createFaqSchema } from "../../utils/seo";

const cityHighlights: Record<string, string> = {
  hamburg: "Hafen, Logistik & Nutzfahrzeuge",
  berlin: "Hauptstadtregion & Fuhrparks",
  hannover: "Messe, Transport & Gewerbe",
  luebeck: "Norddeutschland & Ostsee",
  bremen: "Handel, Hafen & Logistik",
  kiel: "Schleswig-Holstein",
  schwerin: "Mecklenburg-Vorpommern",
  rostock: "Hafen & Nordosten",
  muenchen: "Süddeutschland & Wirtschaft",
  frankfurt: "Logistik & Finanzmetropole",
  koeln: "Rheinland & Transport",
};

const cityLinks = navigationCities.map((city, index) => ({
  ...city,
  subline: cityHighlights[city.slug] || city.cardText,
  index: String(index + 1).padStart(2, "0"),
}));

const stateLinks = stateGroups.map((group) => ({
  ...group,
  previewCities: group.cities.slice(0, 5).map((city) => city.name).join(", "),
}));

const benefits = [
  {
    title: "Schnelle Rückmeldung",
    text: "Nach Eingang Ihrer Fahrzeugdaten melden wir uns schnellstmöglich zur weiteren Abstimmung.",
    icon: ClockCheck,
  },
  {
    title: "Direkter Ankauf ohne Umwege",
    text: "Keine Marktplatzlogik, keine unnötigen Zwischenschritte - Sie sprechen direkt mit uns.",
    icon: Truck,
  },
  {
    title: "Nachvollziehbare Einordnung",
    text: "Fahrzeugdaten, Zustand, Unterlagen und Standort werden nachvollziehbar besprochen.",
    icon: BadgeEuro,
  },
  {
    title: "Einzelfahrzeuge & Fuhrparks",
    text: "Vom einzelnen LKW bis zum gemischten Fuhrpark können Fahrzeuge gebündelt angeboten werden.",
    icon: Building2,
  },
  {
    title: "Deutschland- und europaweite Abwicklung",
    text: "Fahrzeuge aus Deutschland und Europa können direkt bei uns angefragt werden.",
    icon: Route,
  },
  {
    title: "Persönliche Ansprechpartner",
    text: "Kurze Wege, klare Kommunikation und verbindliche Abstimmung von Anfrage bis Übergabe.",
    icon: MessageCircle,
  },
];

const steps = [
  {
    title: "Anfrage senden",
    text: "Fahrzeugdaten, Standort und Fotos übermitteln - per Formular, Telefon oder WhatsApp.",
  },
  {
    title: "Rückmeldung erhalten",
    text: "Wir melden uns schnellstmöglich zur weiteren Abstimmung.",
  },
  {
    title: "Verkauf abstimmen",
    text: "Preis, Übergabe und mögliche Abholung werden direkt und transparent vereinbart.",
  },
];

const faqs = [
  {
    question: "In welchen Städten kauft WAW LKW an?",
    answer:
      `Auf dieser Übersicht zeigen wir die wichtigsten Städte und Regionen - darunter Hamburg, Berlin, München, Köln und Frankfurt. Weitere Stadtseiten sind direkt über ihre jeweilige URL erreichbar.`,
  },
  {
    question: "Ist der Ankauf auch außerhalb dieser Städte möglich?",
    answer:
      "Ja. Wir sind deutschland- und europaweit erreichbar. Auch Anfragen aus Orten, die nicht direkt in der Navigation stehen oder noch keine prominente Standortseite haben, sind möglich.",
  },
  {
    question: "Kauft WAW auch Nutzfahrzeuge, Auflieger und Baumaschinen an?",
    answer:
      "Ja. Neben LKW kaufen wir auch Nutzfahrzeuge, Sattelzugmaschinen, Auflieger, Anhänger, Transporter, Baumaschinen und Fuhrparks an.",
  },
  {
    question: "Wie läuft der regionale Ankauf ab?",
    answer:
      "Sie senden Fahrzeugdaten, Fotos und Standort. Wir melden uns zurück und stimmen Angebot, Übergabe sowie mögliche Abholung direkt mit Ihnen ab.",
  },
  {
    question: "Können auch Fuhrparks verkauft werden?",
    answer:
      "Ja. Unternehmen, Händler, Speditionen und Fuhrparkbetreiber können mehrere Fahrzeuge oder komplette Fuhrparks gemeinsam anbieten.",
  },
  {
    question: "Wie schnell erfolgt eine Rückmeldung?",
    answer:
      "Nach Eingang einer vollständigen Anfrage melden wir uns schnellstmöglich. Je mehr Fahrzeugdaten und Fotos vorliegen, desto schneller können wir konkret mit Ihnen sprechen.",
  },
];

const canonical = absoluteUrl("/standorte");
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${canonical}#standortliste`,
    name: "WAW Standortseiten für LKW Ankauf",
    itemListElement: cityLinks.map((city, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `LKW verkaufen ${city.name}`,
      url: absoluteUrl(`/lkw-verkaufen/${city.slug}`),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${canonical}#bundeslaender`,
    name: "WAW Bundesland-Hubs für LKW Ankauf",
    itemListElement: stateLinks.map((group, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `LKW Ankauf ${group.name}`,
      url: absoluteUrl(`/standorte/${group.slug}`),
    })),
  },
  createFaqSchema(faqs),
  createBreadcrumbSchema([
    { name: "Startseite", url: absoluteUrl("/") },
    { name: "Standorte", url: canonical },
  ]),
];
---

<BaseLayout
  title="Standorte | LKW Ankauf in Deutschland & Europa | WAW"
  description="Regionale WAW Standortseiten für LKW Ankauf und Nutzfahrzeuge Ankauf: Hamburg, Berlin, Hannover, München, Köln, Frankfurt und viele weitere Städte."
  canonical={canonical}
  schema={schema}
>
  <Header />

  <main>
    <section class="locations-hero">
      <div class="container locations-hero-grid">
        <div class="locations-hero-copy reveal">
          <span class="locations-kicker">STANDORTE & REGIONEN</span>
          <h1>LKW Ankauf in Deutschland und Europa.</h1>
          <p>
            Wir kaufen LKW, Nutzfahrzeuge, Auflieger und Baumaschinen
            deutschland- und europaweit an. Über unsere Standortseiten finden
            Unternehmen, Händler und Fuhrparks schnell den passenden regionalen Einstieg.
          </p>

          <div class="locations-hero-actions">
            <a href="/kontakt" class="btn btn-primary">Fahrzeug anbieten</a>
            <a href={`tel:${site.phoneHref}`} class="btn locations-call">
              <PhoneCall size={18} stroke-width={2.4} aria-hidden="true" />
              Direkt anrufen
            </a>
          </div>
        </div>

        <div class="locations-hero-panel reveal delay-2" aria-label="Standorte Übersicht">
          <div class="location-map-orbit" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="location-stat-card is-orange">
            <strong>{cityLinks.length}+</strong>
            <span>Regionen</span>
          </div>
          <div class="location-stat-card">
            <strong>DE</strong>
            <span>Deutschland- und europaweit aktiv</span>
          </div>
          <div class="location-stat-card">
            <strong>Direkt</strong>
            <span>Schnelle Rückmeldung</span>
          </div>
        </div>
      </div>
    </section>

    <section class="locations-city-section" aria-labelledby="city-grid-title">
      <div class="container">
        <div class="locations-section-head" data-animate>
          <span>REGIONALE LANDINGPAGES</span>
          <h2 id="city-grid-title">LKW verkaufen in Ihrer Stadt oder Region</h2>
          <p>
            Die wichtigsten Stadtseiten sind direkt verlinkt. Jede Seite führt
            zu einer regional passenden Anfrage für LKW, Auflieger, Transporter,
            Baumaschinen oder Fuhrparks.
          </p>
        </div>

        <div class="city-search-panel" data-animate>
          <label for="city-search">Stadt suchen</label>
          <div class="city-search-field">
            <MapPin size={20} stroke-width={2.4} aria-hidden="true" />
            <input
              id="city-search"
              type="search"
              placeholder="z.B. Hamburg, Neumünster, Köln..."
              autocomplete="off"
              data-city-search
            />
          </div>
          <p>
            <span data-city-count>{cityLinks.length}</span> wichtige Städte und Regionen sichtbar
          </p>
        </div>

        <div class="locations-city-grid" data-city-grid>
          {cityLinks.map((city) => (
            <a
              href={`/lkw-verkaufen/${city.slug}`}
              class="location-city-card"
              data-animate
              data-city-card
              data-city-search-text={`${city.name} ${city.slug} ${city.state} ${city.subline} ${city.cardText}`}
              aria-label={`LKW verkaufen ${city.name}`}
            >
              <span class="city-number">{city.index}</span>
              <div class="city-pin">
                <MapPin size={21} stroke-width={2.4} aria-hidden="true" />
              </div>
              <strong>{city.name}</strong>
              <p>{city.subline}</p>
              <em>
                LKW verkaufen {city.name}
                <ArrowRight size={16} stroke-width={2.5} aria-hidden="true" />
              </em>
            </a>
          ))}
        </div>

        <p class="city-search-empty" data-city-empty hidden>
          Keine passende Stadt gefunden. Sie können uns Ihr Fahrzeug trotzdem deutschland- und europaweit anbieten.
        </p>
      </div>
    </section>

    <section class="locations-coverage">
      <div class="container coverage-panel" data-animate>
        <div>
          <span>DEUTSCHLAND- UND EUROPAWEITE ABDECKUNG</span>
          <h2>Regional auffindbar. Deutschland- und europaweit erreichbar.</h2>
        </div>
        <p>
          Wir kaufen LKW und Nutzfahrzeuge nicht nur in den sichtbaren Städten.
          Auch wenn Ihr Fahrzeugstandort außerhalb der gelisteten Regionen liegt,
          können Sie uns Ihr Fahrzeug oder Ihren Fuhrpark direkt anbieten.
        </p>
      </div>
    </section>

    <section class="locations-state-section" aria-labelledby="state-hub-title">
      <div class="container">
        <div class="locations-section-head" data-animate>
          <span>BUNDESLAND-HUBS</span>
          <h2 id="state-hub-title">Standortseiten nach Bundesland</h2>
          <p>
            Die Bundesland-Seiten bündeln regionale Stadtseiten und erleichtern
            den Einstieg für Unternehmen, Händler, Speditionen und Fuhrparks.
          </p>
        </div>

        <div class="locations-state-grid">
          {stateLinks.map((group) => (
            <a href={`/standorte/${group.slug}`} class="locations-state-card" data-animate>
              <strong>{group.name}</strong>
              <span>{group.cities.length} Stadtseiten</span>
              <p>{group.previewCities}</p>
              <em>
                LKW Ankauf {group.name}
                <ArrowRight size={16} stroke-width={2.5} aria-hidden="true" />
              </em>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="locations-benefits" aria-labelledby="locations-benefits-title">
      <div class="container">
        <div class="locations-section-head is-centered" data-animate>
          <span>WARUM WAW?</span>
          <h2 id="locations-benefits-title">LKW verkaufen mit direkter regionaler Anfrage</h2>
        </div>

        <div class="locations-benefit-grid">
          {benefits.map(({ title, text, icon: Icon }) => (
            <article class="locations-benefit-card" data-animate>
              <div><Icon size={25} stroke-width={2.3} aria-hidden="true" /></div>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="locations-process" aria-labelledby="locations-process-title">
      <div class="container process-shell">
        <div class="process-copy" data-animate>
          <span>ABLAUF KURZ ERKLÄRT</span>
          <h2 id="locations-process-title">In drei Schritten zur Rückmeldung</h2>
        </div>

        <div class="process-steps">
          {steps.map((step, index) => (
            <article data-animate>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="locations-seo" aria-labelledby="locations-seo-title">
      <div class="container seo-grid">
        <div class="seo-feature" data-animate>
          <span>LKW ANKAUF DEUTSCHLAND- UND EUROPAWEIT</span>
          <h2 id="locations-seo-title">Regionale Standortseiten für LKW und Nutzfahrzeuge</h2>
          <p>
            Diese Übersicht verbindet die deutschland- und europaweite
            Erreichbarkeit von WAW mit regionalen Standortseiten. So finden
            Unternehmen, Händler, Speditionen und Fuhrparks schnell den Einstieg,
            wenn sie LKW oder Nutzfahrzeuge verkaufen möchten.
          </p>
        </div>

        <div class="seo-cards">
          <article data-animate>
            <h3>Regionale Erreichbarkeit</h3>
            <p>
              Stadtseiten wie Hamburg, Berlin, Hannover, Bremen, München,
              Frankfurt und Köln führen direkt zu regional passenden Informationen
              und Kontaktmöglichkeiten.
            </p>
          </article>
          <article data-animate>
            <h3>Ankauf vieler Fahrzeugarten</h3>
            <p>
              Wir kaufen LKW, Sattelzugmaschinen, Auflieger, Anhänger,
              Transporter, Baumaschinen und komplette Fuhrparks an. Auch
              Fahrzeuge mit hoher Laufleistung, Schäden oder fehlendem TÜV
              können Sie uns ebenfalls anbieten.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="locations-faq" aria-labelledby="locations-faq-title">
      <div class="container faq-grid">
        <div class="faq-copy" data-animate>
          <span>FAQ</span>
          <h2 id="locations-faq-title">Häufige Fragen zum regionalen LKW Ankauf</h2>
          <p>Antworten zur regionalen Erreichbarkeit, deutschland- und europaweiten Abwicklung und Fahrzeuganfrage.</p>
        </div>

        <div class="faq-list">
          {faqs.map((faq, index) => (
            <details class="faq-item" data-standorte-faq data-animate open={index === 0}>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="locations-final-cta">
      <div class="container final-panel" data-animate>
        <div>
          <span>FAHRZEUG VERKAUFEN?</span>
          <h2>Fahrzeug oder Fuhrpark aus Ihrer Region anbieten.</h2>
          <p>
            Senden Sie Fahrzeugdaten, Standort und Fotos oder rufen Sie direkt an.
            Wir melden uns schnellstmöglich zur Abstimmung.
          </p>
        </div>
        <div class="final-actions">
          <a href="/kontakt" class="btn btn-primary">Fahrzeug anbieten</a>
          <a href={`tel:${site.phoneHref}`} class="final-call">
            <PhoneCall size={18} stroke-width={2.4} aria-hidden="true" />
            Direkt anrufen
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingContact />
  <ScrollAnimations />
</BaseLayout>

<script>
  const standorteFaqItems = document.querySelectorAll<HTMLDetailsElement>("[data-standorte-faq]");
  standorteFaqItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      standorteFaqItems.forEach((other) => {
        if (other !== item) other.removeAttribute("open");
      });
    });
  });

  const citySearchInput = document.querySelector<HTMLInputElement>("[data-city-search]");
  const cityCards = Array.from(document.querySelectorAll<HTMLElement>("[data-city-card]"));
  const cityCount = document.querySelector<HTMLElement>("[data-city-count]");
  const cityEmpty = document.querySelector<HTMLElement>("[data-city-empty]");

  const normalizeCitySearch = (value: string) =>
    value
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/ä/g, "ae")
      .replace(/ö/g, "oe")
      .replace(/ü/g, "ue")
      .replace(/ß/g, "ss");

  citySearchInput?.addEventListener("input", () => {
    const query = normalizeCitySearch(citySearchInput.value.trim());
    let visibleCount = 0;

    cityCards.forEach((card) => {
      const haystack = normalizeCitySearch(card.dataset.citySearchText || card.textContent || "");
      const isVisible = !query || haystack.includes(query);
      card.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });

    if (cityCount) cityCount.textContent = String(visibleCount);
    if (cityEmpty) cityEmpty.hidden = visibleCount > 0;
  });
</script>

<style>
  .locations-kicker,
  .locations-section-head span,
  .coverage-panel span,
  .process-copy span,
  .seo-feature span,
  .faq-copy span,
  .final-panel span {
    color: var(--orange);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.11em;
  }

  .locations-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(86px, 9vw, 128px) 0 clamp(66px, 8vw, 104px);
    background:
      radial-gradient(circle at 14% 20%, rgba(255,107,0,0.12), transparent 27rem),
      radial-gradient(circle at 85% 22%, rgba(7,26,51,0.14), transparent 31rem),
      linear-gradient(180deg, #fff, #f5f7fa);
  }

  .locations-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(15,23,42,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15,23,42,0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(180deg, black, transparent 78%);
    pointer-events: none;
  }

  .locations-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(430px, 0.82fr);
    gap: clamp(34px, 6vw, 88px);
    align-items: center;
  }

  .locations-hero-copy h1 {
    max-width: 840px;
    margin: 16px 0 0;
    color: #111827;
    font-size: clamp(52px, 7vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.08em;
  }

  .locations-hero-copy p {
    max-width: 720px;
    margin: 28px 0 0;
    color: #5b6675;
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.7;
  }

  .locations-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    margin-top: 34px;
  }

  .locations-call,
  .final-call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: 1px solid rgba(17,24,39,0.12);
    border-radius: 999px;
    background: #fff;
    color: #111827;
    font-weight: 900;
    padding: 15px 23px;
    box-shadow: 0 14px 36px rgba(15,23,42,0.08);
    transition: transform 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .locations-call:hover {
    transform: translateY(-3px);
    border-color: rgba(255,107,0,0.34);
    color: var(--orange);
  }

  .locations-hero-panel {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    border: 1px solid rgba(17,24,39,0.08);
    border-radius: 34px;
    background:
      radial-gradient(circle at 34% 26%, rgba(255,107,0,0.36), transparent 18rem),
      radial-gradient(circle at 80% 70%, rgba(255,255,255,0.12), transparent 18rem),
      linear-gradient(145deg, #05070a, #07111f 55%, #071a33);
    box-shadow: 0 36px 96px rgba(15,23,42,0.2);
  }

  .location-map-orbit {
    position: absolute;
    inset: 52px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 50%;
  }

  .location-map-orbit::before,
  .location-map-orbit::after {
    content: "";
    position: absolute;
    inset: 58px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50%;
  }

  .location-map-orbit::after {
    inset: 118px;
  }

  .location-map-orbit span {
    position: absolute;
    width: 13px;
    height: 13px;
    border-radius: 999px;
    background: var(--orange);
    box-shadow: 0 0 0 7px rgba(255,107,0,0.16);
  }

  .location-map-orbit span:nth-child(1) { left: 23%; top: 18%; }
  .location-map-orbit span:nth-child(2) { right: 22%; top: 28%; }
  .location-map-orbit span:nth-child(3) { left: 42%; top: 48%; }
  .location-map-orbit span:nth-child(4) { left: 18%; bottom: 24%; }
  .location-map-orbit span:nth-child(5) { right: 18%; bottom: 22%; }
  .location-map-orbit span:nth-child(6) { right: 42%; bottom: 10%; }

  .location-stat-card {
    position: absolute;
    display: grid;
    gap: 4px;
    width: 190px;
    padding: 20px;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 22px;
    background: rgba(255,255,255,0.09);
    color: #fff;
    box-shadow: 0 22px 58px rgba(0,0,0,0.22);
    backdrop-filter: blur(16px);
  }

  .location-stat-card:nth-of-type(2) {
    left: 28px;
    top: 34px;
  }

  .location-stat-card:nth-of-type(3) {
    right: 28px;
    top: 186px;
  }

  .location-stat-card:nth-of-type(4) {
    left: 58px;
    bottom: 40px;
  }

  .location-stat-card.is-orange {
    background: linear-gradient(135deg, var(--orange), var(--orange-dark));
    border-color: rgba(255,255,255,0.24);
  }

  .location-stat-card strong {
    font-size: 36px;
    line-height: 1;
    letter-spacing: -0.07em;
  }

  .location-stat-card span {
    color: rgba(255,255,255,0.74);
    font-size: 13px;
    font-weight: 820;
  }

  .locations-city-section,
  .locations-state-section,
  .locations-benefits,
  .locations-faq {
    padding: clamp(74px, 8vw, 116px) 0;
    background: #fff;
  }

  .locations-state-section {
    background:
      radial-gradient(circle at 88% 12%, rgba(255,107,0,0.1), transparent 27rem),
      #f5f7fa;
